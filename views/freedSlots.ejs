<%- include('partials/nav') %>

<div class="freed-slots-container">
  <!-- Header Section -->
  <div class="freed-slots-header">
    <h1>
      <i class="fas fa-unlock-alt"></i>
      Freed Slots Dashboard & Analysis
    </h1>
  </div>

  <!-- Instructions Alert -->
  <div class="instructions-alert">
    <ul>
      <li>View and filter recently freed timetable slots.</li>
      <li>Filter slots by <strong>venue</strong> or <strong>day</strong> in the sidebar.</li>
      <li>Table shows 20 records per page.</li>
      <li>Charts visualize which venues and times are freed most frequently.</li>
    </ul>
  </div>

  <div class="matrix-container">
    <!-- Left: Filter Sidebar -->
    <aside class="filter-sidebar">
      <h5>
        <i class="fas fa-filter"></i>
        Filter Slots
      </h5>
      <form method="GET" action="/manageTimetable/freed-slots" role="search" class="filter-form">
        <div class="mb-3">
          <label for="venue_id" class="form-label">Select Venue</label>
          <select name="venue_id" id="venue_id" class="form-select select2">
            <option value="">All Venues</option>
            <% venues.forEach(v => { %>
              <option value="<%= v.venue_id %>" <%= venue_id == v.venue_id ? 'selected' : '' %>>
                <%= v.venue_name %>
              </option>
            <% }) %>
          </select>
        </div>

        <div class="mb-3">
          <label for="day" class="form-label">Select Day</label>
          <select id="day" name="day" class="form-select select2">
            <option value="">Any Day</option>
            <% ['MONDAY','TUESDAY','WEDNESDAY','THURSDAY','FRIDAY','SATURDAY','SUNDAY'].forEach(d => { %>
              <option value="<%= d %>" <%= day == d ? 'selected' : '' %>><%= d %></option>
            <% }) %>
          </select>
        </div>

        <button type="submit" class="btn filter-apply-btn">
          <i class="fas fa-search"></i>
          Apply Filter
        </button>
        
        <% if (venue_id || day) { %>
        <a href="/manageTimetable/freed-slots" class="btn filter-reset-btn">
          <i class="fas fa-redo"></i>
          Reset
        </a>
        <% } %>
      </form>
    </aside>

    <!-- Right: Data Table & Charts -->
    <section class="data-section">
      <!-- Data Card -->
      <div class="freed-slots-card">
        <div class="freed-slots-card-header">
          <span>Freed Slots Data</span>
          <span class="page-badge">Page <%= page %> of <%= totalPages %></span>
        </div>
        <div class="freed-slots-card-body">
          <div class="freed-slots-table-wrapper">
            <table class="table table-hover table-bordered freed-slots-table">
              <caption>Recently freed slots list</caption>
              <thead>
                <tr>
                  <th>#</th>
                  <th>Venue</th>
                  <th>Day</th>
                  <th>Start</th>
                  <th>End</th>
                  <th>Released By</th>
                  <th>Reason</th>
                  <th>Released On</th>
                </tr>
              </thead>
              <tbody>
                <% if(freed.length === 0) { %>
                  <tr>
                    <td colspan="8" class="empty-row">No freed slots found.</td>
                  </tr>
                <% } else { %>
                  <% freed.forEach(f => { %>
                    <tr>
                      <td data-label="#"><%= f.id %></td>
                      <td data-label="Venue">
                        <%= f.venue_name %>
                        <span class="venue-badge">ID: <%= f.venue_id %></span>
                      </td>
                      <td data-label="Day"><%= f.day %></td>
                      <td data-label="Start"><%= f.start_time %></td>
                      <td data-label="End"><%= f.end_time %></td>
                      <td data-label="Released By"><%= f.released_by %></td>
                      <td data-label="Reason"><%= f.reason %></td>
                      <td data-label="Released On"><%= new Date(f.created_at).toLocaleString() %></td>
                    </tr>
                  <% }) %>
                <% } %>
              </tbody>
            </table>
          </div>

          <!-- Pagination -->
          <nav aria-label="Freed slots pagination" class="pagination-wrapper">
            <ul class="pagination">
              <% if(page > 1) { %>
                <li class="page-item">
                  <a class="page-link" href="?page=<%= page-1 %><%= venue_id ? '&venue_id='+venue_id : '' %><%= day ? '&day='+day : '' %>">
                    Previous
                  </a>
                </li>
              <% } %>
              
              <% for(let i = 1; i <= totalPages; i++) { %>
                <li class="page-item <%= page === i ? 'active' : '' %>">
                  <a class="page-link" href="?page=<%= i %><%= venue_id ? '&venue_id='+venue_id : '' %><%= day ? '&day='+day : '' %>">
                    <%= i %>
                  </a>
                </li>
              <% } %>
              
              <% if(page < totalPages) { %>
                <li class="page-item">
                  <a class="page-link" href="?page=<%= page+1 %><%= venue_id ? '&venue_id='+venue_id : '' %><%= day ? '&day='+day : '' %>">
                    Next
                  </a>
                </li>
              <% } %>
            </ul>
          </nav>
        </div>
      </div>

      <!-- Charts Section -->
      <div class="charts-row">
        <div class="chart-card">
          <h6>Venues Most Frequently Freed</h6>
          <canvas id="venuePieChart" class="chart-canvas"></canvas>
        </div>

        <div class="chart-card">
          <h6>Slots Most Frequently Freed (Hours)</h6>
          <canvas id="timeBarChart" class="chart-canvas"></canvas>
        </div>
      </div>
    </section>
  </div>
</div>

<!-- Chart.js -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<!-- Embed chart data for JavaScript -->
<script>
  // Make chart data available globally for freedSlots.js
  window.venueStats = <%- JSON.stringify(venueStats || []) %>;
  window.timeStats = <%- JSON.stringify(timeStats || []) %>;
</script>

</main>
<%- include('partials/footer') %>
