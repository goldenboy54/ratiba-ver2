<%- include('partials/nav') %>

  <div class="container tmaster-container">
    <div class="page-header">
      <h1>
        <i class="fas fa-calendar-alt"></i>Auto Timetable Generator
      </h1>
      <p class="lead">Arusha Technical College</p>
    </div>

    <div class="row justify-content-center">
      <div class="col-lg-8">
        <div class="card generation-card">
          <div class="card-body">

            <!-- Form -->
            <form id="generateForm" class="generation-form">
              <div class="form-group">
                <label for="semester">
                  <i class="fas fa-graduation-cap"></i> Select Semester
                </label>
                <select id="semester" name="semester" class="form-select select2" required>
                  <option value="">-- Choose Semester --</option>
                  <option value="I">Semester I</option>
                  <option value="II">Semester II</option>
                </select>
              </div>

              <button type="submit" id="generateBtn" class="btn btn-generate">
                <i class="fas fa-magic"></i> GENERATE TIMETABLE
              </button>
            </form>

            <!-- Generation Status -->
            <div id="generationStatus" class="status-section" style="display: none;">
              <div class="spinner-wheel" id="spinner"></div>
              <h3>
                <i class="fas fa-cog fa-spin"></i> Generating Timetable...
              </h3>
              <p>Please wait while we assign classes automatically</p>
            </div>

            <!-- Completion Message -->
            <div id="completionMessage" class="completion-section" style="display: none;">
              <div class="status-icon success">
                <i class="fas fa-check-circle"></i>
              </div>
              <h2 class="completion-message success">
                Timetable Generated Successfully!
              </h2>
              <p class="lead" id="successText"></p>
              <a href="/searchtimetable" class="btn btn-view">
                <i class="fas fa-eye"></i> View Timetable
              </a>
            </div>

            <!-- Error Message -->
            <div id="errorMessage" class="error-section" style="display: none;">
              <div class="status-icon error">
                <i class="fas fa-times-circle"></i>
              </div>
              <h3>Generation Failed</h3>
              <p id="errorText"></p>
            </div>

            <!-- Live Logs -->
            <div id="logsSection" class="logs-section" style="display: none;">
              <h5>
                <i class="fas fa-terminal"></i> Live Generation Logs
              </h5>
              <pre id="logOutput" class="log-output"></pre>
            </div>

          </div>
        </div>
      </div>
    </div>
  </div>

</main>
<%- include('partials/footer') %>