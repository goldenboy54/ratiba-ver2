<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login - ATC TMS  <script>document.querySelector('h5').textContent = `TIMETABLE  — ${((d=>d.getMonth()+1>=8?d.getFullYear():d.getFullYear()-1)(new Date()))}/${((d=>d.getMonth()+1>=8?d.getFullYear()+1:d.getFullYear())(new Date()))}`</script></title>

    <!-- Bootstrap 5 & Font Awesome -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/login.css">
  </head>
  <body>
    <header>
      <h1>
        <i class="fas fa-calendar-alt me-2"></i>
        ATC Timetable Management System
        (<script>document.write(`${((d=>d.getMonth()+1>=8?d.getFullYear():d.getFullYear()-1)(new Date()))}/${((d=>d.getMonth()+1>=8?d.getFullYear()+1:d.getFullYear())(new Date()))}`)</script>)
      </h1>
    </header>

    <main>
      <div class="container">
        <div class="row justify-content-center">
          <div class="col-lg-5 col-md-7 col-sm-9">
            <h2 class="text-center mb-4">
              <i class="fas fa-sign-in-alt me-2"></i>Login to Your Account
            </h2>
            <div class="card">
              <div class="card-body">
                <% if (message) { %>
                  <p class="error-message"><%= message %></p>
                <% } %>

                <form action="/login" method="POST">
                  <div class="mb-3">
                    <label for="email" class="form-label">
                      <i class="fas fa-envelope me-2"></i>Email Address
                    </label>
                    <input
                      type="email"
                      id="email"
                      class="form-control"
                      name="username"
                      placeholder="Enter your email"
                      required
                    />
                  </div>

                  <div class="mb-3 position-relative">
                    <label for="password" class="form-label">
                      <i class="fas fa-lock me-2"></i>Password
                    </label>
                    <input
                      type="password"
                      id="password"
                      class="form-control"
                      name="password"
                      placeholder="Enter your password"
                      required
                    />
                    <i
                      class="fas fa-eye password-toggle"
                      id="togglePassword"
                      title="Show/Hide Password"
                    ></i>
                  </div>

                  <button type="submit" class="btn btn-dark">
                    <i class="fas fa-sign-in-alt me-2"></i>Login
                  </button>
                </form>

                <div class="mt-4">
                  <div class="d-flex justify-content-between align-items-center">
                    <a href="/forgot-password" class="link-blue">
                      <i class="fas fa-key me-1"></i>Forgot Password?
                    </a>
                    <a href="/" class="link-blue">
                      <i class="fas fa-home me-1"></i>Back to Home
                    </a>
                  </div>
                  <div class="mt-3 text-center">
                    <a href="/searchtimetable" class="link-blue">
                      <i class="fas fa-calendar-alt me-1"></i>View Tutors Timetable
                    </a>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </main>

    <!-- Footer -->
    <footer>
      <p>
        &copy; <%= new Date().getFullYear() %> Arusha Technical College - Timetable Management System.
        All Rights Reserved. |
        <a href="#">Privacy Policy</a>
      </p>
    </footer>

    <!-- JavaScript for Show/Hide Password -->
    <script>
      const togglePassword = document.querySelector("#togglePassword");
      const passwordField = document.querySelector("#password");

      togglePassword.addEventListener("click", function () {
        const type =
          passwordField.getAttribute("type") === "password"
            ? "text"
            : "password";
        passwordField.setAttribute("type", type);
        this.classList.toggle("fa-eye-slash");
      });
    </script>
  </body>
</html>
