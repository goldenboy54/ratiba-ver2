<%- include('partials/nav') %>

  <div class="container">
    <h2 class="text-center text-primary mb-4">User Profile</h2>

    <div class="profile-container">

    <!-- Form Section -->
    <div class="profile-form">
      <% const alertMsg = typeof msg !== 'undefined' ? msg : null; %>
      <% if(alertMsg === 'change_password') { %>
        <div class="alert alert-info text-center">You must set a new password before proceeding!</div>
      <% } else if(alertMsg === 'update_password') { %>
        <div class="alert alert-info text-center">It has been 3 months since your last password change. Please update it.</div>
      <% } %>

      <% if(error){ %><div class="alert alert-danger"><%= error %></div><% } %>
      <% if(success){ %><div class="alert alert-success"><%= success %></div><% } %>

      <form action="/profile/update" method="POST" id="profileForm">
        <div class="mb-3">
          <label class="form-label text-primary fw-bold">Full Name</label>
          <input type="text" name="full_name" class="form-control" value="<%= user.full_name %>" required>
        </div>

        <div class="mb-3">
          <label class="form-label text-primary fw-bold">Department</label>
          <input type="text" name="department" class="form-control" value="<%= user.department %>">
        </div>

        <div class="mb-3">
          <label class="form-label text-primary fw-bold">Email</label>
          <input type="email" name="user_email" class="form-control" value="<%= user.user_email %>" required>
        </div>

        <div class="mb-3">
          <label class="form-label text-primary fw-bold">New Password 
            <% if(user.must_change_password) { %>
              <span class="text-danger">(Required)</span>
            <% } else { %>
              <small class="text-muted">(leave blank to keep current)</small>
            <% } %>
          </label>
          <div class="input-group">
            <input type="password" name="password" class="form-control" id="password" <%= user.must_change_password ? 'required' : '' %>>
            <button type="button" class="btn btn-outline-secondary" id="togglePassword">
              <i class="fas fa-eye" id="toggleIcon"></i>
            </button>
          </div>
          <div id="strengthMessage" class="mt-2"></div>
        </div>

        <button type="submit" class="btn btn-primary w-100 mt-3" id="submitBtn">
          <i class="fas fa-save me-2"></i>Update Profile
        </button>
      </form>
    </div>

    <!-- Info / Matrix Section -->
    <div class="profile-info">
      <h5 class="text-primary mb-3 fw-bold">
        <i class="fas fa-shield-alt me-2"></i>Password Security Tips
      </h5>
      <div class="info-matrix">
        <p><i class="fas fa-check-circle me-2"></i>Strong passwords protect your data from unauthorized access.</p>
        <p><i class="fas fa-check-circle me-2"></i>Include uppercase, lowercase, numbers, and special characters.</p>
        <p><i class="fas fa-check-circle me-2"></i>Minimum 8 characters recommended for strong protection.</p>
        <p><i class="fas fa-check-circle me-2"></i>Regularly update passwords every 3 months.</p>
        <p><i class="fas fa-calendar-alt me-2"></i>The timetable system ensures accurate, conflict-free scheduling.</p>
        <p><i class="fas fa-graduation-cap me-2"></i>Educated users benefit from efficient academic planning using this system.</p>
        <p><i class="fas fa-lock me-2"></i>Keeping your account secure maintains integrity of all scheduling operations.</p>
        <p><i class="fas fa-lightbulb me-2"></i>Remember: strong passwords + well-managed timetable = safe & efficient workflow.</p>
      </div>
    </div>

  </div>
</div>

<script>
  const passwordInput = document.getElementById('password');
  const strengthMessage = document.getElementById('strengthMessage');
  const submitBtn = document.getElementById('submitBtn');
  const profileForm = document.getElementById('profileForm');
  const togglePassword = document.getElementById('togglePassword');
  const toggleIcon = document.getElementById('toggleIcon');

  // Password strength checker
  passwordInput.addEventListener('input', updateStrength);

  function updateStrength() {
    const val = passwordInput.value;
    const strongRegex = /^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[\W_]).{8,}$/;
    const mediumRegex = /^(?=.*[a-z])(?=.*[A-Z])(?=.*\d).{6,}$/;

    if(val === "") {
      strengthMessage.textContent = "";
      strengthMessage.className = "";
      submitBtn.disabled = <%= user.must_change_password ? 'true' : 'false' %>;
    } else if(strongRegex.test(val)) {
      strengthMessage.innerHTML = '<i class="fas fa-check-circle text-success me-1"></i>Strong password';
      strengthMessage.className = "text-success fw-bold";
      submitBtn.disabled = false;
    } else if(mediumRegex.test(val)) {
      strengthMessage.innerHTML = '<i class="fas fa-exclamation-circle text-warning me-1"></i>Medium strength (add special char for strong)';
      strengthMessage.className = "text-warning fw-bold";
      submitBtn.disabled = true;
    } else {
      strengthMessage.innerHTML = '<i class="fas fa-times-circle text-danger me-1"></i>Weak password';
      strengthMessage.className = "text-danger fw-bold";
      submitBtn.disabled = true;
    }
  }

  // Toggle password visibility
  togglePassword.addEventListener('click', () => {
    const type = passwordInput.type === "password" ? "text" : "password";
    passwordInput.type = type;
    toggleIcon.className = type === "password" ? "fas fa-eye" : "fas fa-eye-slash";
  });

  // Form validation
  profileForm.addEventListener('submit', function(e){
    const val = passwordInput.value;
    const strongRegex = /^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[\W_]).{8,}$/;
    
    <% if(user.must_change_password) { %>
      if(!val || val.trim() === "") {
        e.preventDefault();
        alert("You are required to set a new password.");
        return;
      }
    <% } %>

    if(val && !strongRegex.test(val)){
      e.preventDefault();
      alert("Password must be strong! Include uppercase, lowercase, number, special character, min 8 chars.");
    }
  });
</script>

</main>

<%- include('partials/footer') %>
</body>
</html>
