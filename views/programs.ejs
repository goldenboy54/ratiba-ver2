<%- include('partials/nav') %>

<div class="container-fluid py-4">
  
  <div class="programs-header">
    <a href="/programs/form" class="btn btn-primary mb-3">
      <i class="fas fa-plus"></i> Add Program
    </a>
  </div>

  <% if (locals.Viewprograms) { %>

    <div class="filter-section">
      <h2>Filter Below to Customize Views</h2>
      
      <form method="get" action="/programs" id="filterForm">
        <div class="row">
          <div class="col-md-4 mb-3">
            <label for="program_name" class="form-label">Program Name:</label>
            <select id="program_name" name="program_name" class="form-select select2">
              <option value="">Select program name</option>
              <% pname.forEach(item => { %>
                <option value="<%= item.program_name %>" <%= locals.query?.program_name === item.program_name ? 'selected' : '' %>><%= item.program_name %></option>
              <% }); %>
            </select>
          </div>

          <div class="col-md-4 mb-3">
            <label for="program_code" class="form-label">Program Code:</label>
            <select id="program_code" name="program_code" class="form-select select2">
              <option value="">Select program code</option>
              <% pcode.forEach(item => { %>
                <option value="<%= item.program_code %>" <%= locals.query?.program_code === item.program_code ? 'selected' : '' %>><%= item.program_code %></option>
              <% }); %>
            </select>
          </div>

          <div class="col-md-4 mb-3">
            <label for="duration" class="form-label">Duration:</label>
            <select id="duration" name="duration" class="form-select select2">
              <option value="">Select duration</option>
              <% pduration.forEach(item => { %>
                <option value="<%= item.duration %>" <%= locals.query?.duration === item.duration ? 'selected' : '' %>><%= item.duration %></option>
              <% }); %>
            </select>
          </div>
        </div>

        <div class="row">
          <div class="col-md-4 mb-3">
            <label for="level" class="form-label">Level:</label>
            <select id="level" name="level" class="form-select select2">
              <option value="">Select level</option>
              <% plevel.forEach(item => { %>
                <option value="<%= item.level %>" <%= locals.query?.level === item.level ? 'selected' : '' %>><%= item.level %></option>
              <% }); %>
            </select>
          </div>

          <div class="col-md-4 mb-3">
            <label for="category" class="form-label">Program Department:</label>
            <select id="category" name="category" class="form-select select2">
              <option value="">Select program department</option>
              <% pcategory.forEach(item => { %>
                <option value="<%= item.category %>" <%= locals.query?.category === item.category ? 'selected' : '' %>><%= item.category %></option>
              <% }); %>
            </select>
          </div>

          <div class="col-md-4 mb-3">
            <label for="program_capacity" class="form-label">Program Capacity:</label>
            <select id="program_capacity" name="program_capacity" class="form-select select2">
              <option value="">Select program capacity</option>
              <% pcapacity.forEach(item => { %>
                <option value="<%= item.program_capacity %>" <%= locals.query?.program_capacity === item.program_capacity ? 'selected' : '' %>><%= item.program_capacity %></option>
              <% }); %>
            </select>
          </div>
        </div>

        <div class="row">
          <div class="col-md-4 mb-3">
            <label for="program_type" class="form-label">Program Type:</label>
            <select id="program_type" name="program_type" class="form-select select2">
              <option value="">Select program type</option>
              <% ptype.forEach(item => { %>
                <option value="<%= item.program_type %>" <%= locals.query?.program_type === item.program_type ? 'selected' : '' %>><%= item.program_type %></option>
              <% }); %>
            </select>
          </div>
        </div>

        <div class="text-center mt-3">
          <button type="submit" class="btn btn-primary">
            <i class="fas fa-filter"></i> Filter
          </button>
          <a href="/programs" class="btn btn-secondary ms-2">
            <i class="fas fa-sync"></i> Reset
          </a>
        </div>
      </form>
    </div>

    <div class="text-center mb-3">
        <button id="csvDownloadBtn" class="btn btn-success btn-download">Download CSV</button>
        <button id="pdfDownloadBtn" class="btn btn-info btn-download">Download PDF</button>
        <button id="printBtn" class="btn btn-secondary btn-download">Print</button>
      </div>

      <h2 class="mb-4">All Programs</h2>

      <div class="table-container" id="programTableContainer">
        <table class="table table-bordered table-striped" id="programTable">
          <thead class="thead-dark">
            <tr>
              <th>Program Name</th>
              <th>Program Code</th>
              <th>Program Duration</th>
              <th>Level</th>
              <th>Program Department</th>
              <th>Program Capacity</th>
              <th>Program Type</th>
              <th>Actions</th>
            </tr>
          </thead>

          <tbody>
            <% if (Viewprograms.length > 0) { %>
              <% Viewprograms.forEach(program => { %>
                <tr>
                  <td><%= program.program_name %></td>
                  <td><%= program.program_code %></td>
                  <td><%= program.duration %></td>
                  <td><%= program.level %></td>
                  <td><%= program.category %></td> <!-- program_department -->
                  <td><%= program.program_capacity %></td>
                  <td><%= program.program_type %></td>

                  <td>
                    <button type="button" class="btn btn-warning btn-sm" data-bs-toggle="modal" data-bs-target="#updateModal<%= program.program_id %>">Edit</button>
                    <a href="/programs/delete/<%= program.program_id %>" class="btn btn-danger btn-sm" onclick="return confirm('Are you sure you want to delete this program?');">Delete</a>
                  </td>
                </tr>

                <!-- Update Modal -->
                <div class="modal fade" id="updateModal<%= program.program_id %>" tabindex="-1" role="dialog">
                  <div class="modal-dialog" role="document">
                    <div class="modal-content">

                      <div class="modal-header">
                        <h5 class="modal-title">Update Program</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                      </div>

                      <div class="modal-body">
                        <form action="/programs/edit/<%= program.program_id %>" method="post">

                          <div class="form-group">
                            <label class="text-info">Program Name:</label>
                            <input type="text" name="name" class="form-control" value="<%= program.program_name %>" required>
                          </div>

                          <div class="form-group">
                            <label class="text-info">Program Code:</label>
                            <input type="text" name="program_code" class="form-control" value="<%= program.program_code %>" required>
                          </div>

                          <div class="form-group">
                            <label class="text-info">Duration:</label>
                            <input type="text" name="duration" class="form-control" value="<%= program.duration %>" required>
                          </div>

                          <div class="form-group">
                            <label class="text-info">Level:</label>
                            <input type="text" name="level" class="form-control" value="<%= program.level %>" required>
                          </div>

                          <div class="form-group">
                            <label for="category_<%= program.program_id %>" class="text-info">Department:</label>
                            <select id="category_<%= program.program_id %>" name="category" class="form-control select2" required>
                              <% departments.forEach(d => { %>
                                <option value="<%= d.department_name %>" <%= program.category === d.department_name ? 'selected' : '' %>><%= d.department_name %></option>
                              <% }); %>
                            </select>
                          </div>

                          <div class="form-group">
                            <label for="program_capacity_<%= program.program_id %>" class="text-info">Program Capacity:</label>
                            <input type="text" id="program_capacity_<%= program.program_id %>" name="program_capacity" class="form-control" value="<%= program.program_capacity %>">
                          </div>

                          <div class="form-group">
                            <label for="program_type_<%= program.program_id %>" class="text-info">Program Type:</label>
                            <select id="program_type_<%= program.program_id %>" name="program_type" class="form-control select2" required>
                              <option value="full-time" <%= program.program_type === 'full-time' ? 'selected' : '' %>>full-time</option>
                              <option value="evening" <%= program.program_type === 'evening' ? 'selected' : '' %>>evening</option>
                              <option value="veta" <%= program.program_type === 'veta' ? 'selected' : '' %>>veta</option>
                            </select>
                          </div>

                          <button type="submit" class="btn btn-success">Submit Changes</button>

                        </form>
                      </div>

                    </div>
                  </div>
                </div>

              <% }) %>
            <% } %>
          </tbody>
        </table>
      </div>

    <% } else { %>

      <h2 class="mb-4">Add Program</h2>

      <h3>Upload CSV/Excel File</h3>

      <form action="/programs/uploads" method="post" enctype="multipart/form-data">
        <div class="form-group">
          <label>Choose CSV/Excel File:</label>
          <input type="file" name="file" class="form-control" required>
        </div>
        <button type="submit" class="btn btn-success">Upload</button>
      </form>

      <form action="/programs" method="post">
        <div class="form-group">
          <label>Program Name:</label>
          <input type="text" name="name" class="form-control" required>
        </div>

        <div class="form-group">
          <label>Program Code:</label>
          <input type="text" name="program_code" class="form-control" required>
        </div>

        <div class="form-group">
          <label>Duration:</label>
          <input type="text" name="duration" class="form-control" required>
        </div>

        <div class="form-group">
          <label>Level:</label>
          <input type="text" name="level" class="form-control" required>
        </div>

        <div class="form-group">
          <label>Department:</label>
          <select name="category" class="form-control select2" required>
            <% departments.forEach(d => { %>
              <option value="<%= d.department_name %>"><%= d.department_name %></option>
            <% }) %>
          </select>
        </div>

        <div class="form-group">
          <label>Program Capacity:</label>
          <input type="text" name="program_capacity" class="form-control">
        </div>

        <div class="form-group">
          <label>program_type:</label>
          <select name="program_type" class="form-control select2" required>
            <option value="full-time">full-time</option>
            <option value="evening">evening</option>
            <option value="veta">veta</option>
          </select>
        </div>

        <button type="submit" class="btn btn-success">Add Program</button>
      </form>

    <% } %>

  </div>

  </main>
<%- include('partials/footer') %>

<script>
$(document).ready(function(){

  // Select2 is initialized by partials/footer.ejs (with allowClear + placeholder)

  $('#filterForm select').on('change', function(){ $('#filterForm').submit(); });

  function getFileName(type){
    const now = new Date();
    const t = now.getFullYear()+'-'+(now.getMonth()+1)+'-'+now.getDate()+'_'+now.getHours()+'-'+now.getMinutes();
    let f = '';
    $('#filterForm select').each(function(){ if($(this).val()) f += $(this).val()+'_'; });
    f = f ? f.slice(0,-1) : 'all';
    return `ATC_${f}_${t}.${type}`;
  }

  // CSV INCLUDING program_department
  $('#csvDownloadBtn').click(function(){
    const rows = document.querySelectorAll("#programTable tr");
    let csv = [];

    rows.forEach(row=>{
      let cols = row.querySelectorAll("td, th");
      let rowData = [];
      cols.forEach(col => rowData.push('"' + col.innerText + '"'));
      csv.push(rowData.join(","));
    });

    const file = new Blob([csv.join("\n")], {type:"text/csv"});
    const a = document.createElement("a");
    a.href = URL.createObjectURL(file);
    a.download = getFileName('csv');
    a.click();
  });

  // PRINT INCLUDING program_department
  $('#printBtn').click(function(){
    const content = document.getElementById('programTableContainer').innerHTML;
    const win = window.open('', '', 'height=700,width=900');
    win.document.write('<html><head><title>Programs Print</title></head><body>');
    win.document.write(content);
    win.document.write('</body></html>');
    win.document.close();
    win.focus();
    win.print();
  });

  // PDF INCLUDING program_department
  $('#pdfDownloadBtn').click(function(){
    const { jsPDF } = window.jspdf;
    const doc = new jsPDF('l', 'pt', 'a4');

    const table = document.getElementById('programTableContainer');
    const pageHeight = doc.internal.pageSize.getHeight();
    const pageWidth = doc.internal.pageSize.getWidth();

    html2canvas(table, { scale:2 }).then(canvas=>{
      const img = canvas.toDataURL('image/png');
      const props = doc.getImageProperties(img);
      const height = (props.height * pageWidth)/props.width;

      let left = height;
      let pos = 0;

      doc.addImage(img, 'PNG', 0, pos, pageWidth, height);
      left -= pageHeight;

      while(left > 0){
        pos = left - height;
        doc.addPage();
        doc.addImage(img, 'PNG', 0, pos, pageWidth, height);
        left -= pageHeight;
      }

      doc.save(getFileName('pdf'));
    });
  });

});
</script>

</main>
<%- include('partials/footer') %>