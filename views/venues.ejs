<%- include('partials/nav') %>

<div class="container-fluid py-4">
  <div class="venues-header">
    <h1>Venues Management</h1>
    <a href="/venues/form" class="btn btn-primary mb-3">
      <i class="fas fa-plus"></i> Add Venue
    </a>
  </div>

  <% if (locals.Viewvenues) { %>
    <!-- Filter Form -->
    <form method="get" action="/venues" class="filter-form" id="filterForm">
      <div class="row">
        <div class="col-md-4 mb-3">
          <label for="venue_name" class="form-label">Venue Name:</label>
          <select id="venue_name" name="venue_name" class="form-select select2 filterInput" data-placeholder="Venue Name">
            <option value="">Select venue name</option>
            <% vname.forEach(opt => { %>
              <option value="<%= opt.venue_name %>" <%= locals.venue_name === opt.venue_name ? 'selected' : '' %>><%= opt.venue_name %></option>
            <% }); %>
          </select>
        </div>

        <div class="col-md-4 mb-3">
          <label for="capacity" class="form-label">Capacity:</label>
          <select id="capacity" name="capacity" class="form-select select2 filterInput" data-placeholder="Capacity">
            <option value="">Select capacity</option>
            <% vcapacity.forEach(opt => { %>
              <option value="<%= opt.capacity %>" <%= locals.venue_capacity == opt.capacity ? 'selected' : '' %>><%= opt.capacity %></option>
            <% }); %>
          </select>
        </div>

        <div class="col-md-4 mb-3">
          <label for="location" class="form-label">Location:</label>
          <select id="location" name="location" class="form-select select2 filterInput" data-placeholder="Location">
            <option value="">Select location</option>
            <% vlocation.forEach(opt => { %>
              <option value="<%= opt.location %>" <%= locals.venue_location === opt.location ? 'selected' : '' %>><%= opt.location %></option>
            <% }); %>
          </select>
        </div>

        <div class="col-md-4 mb-3">
          <label for="type" class="form-label">Type:</label>
          <select id="type" name="type" class="form-select select2 filterInput" data-placeholder="Type">
            <option value="">Select type</option>
            <% vtype.forEach(opt => { %>
              <option value="<%= opt.type %>" <%= locals.venue_type === opt.type ? 'selected' : '' %>><%= opt.type %></option>
            <% }); %>
          </select>
        </div>

        <div class="col-md-4 mb-3">
          <label for="quality" class="form-label">Quality:</label>
          <select id="quality" name="quality" class="form-select select2 filterInput" data-placeholder="Quality">
            <option value="">Select quality</option>
            <% vquality.forEach(opt => { %>
              <option value="<%= opt.quality %>" <%= locals.venue_quality === opt.quality ? 'selected' : '' %>><%= opt.quality %></option>
            <% }); %>
          </select>
        </div>
        
        <div class="col-md-4 mb-3">
          <label for="department" class="form-label">Department:</label>
          <select id="department1" name="department" class="form-select select2 filterInput" data-placeholder="Department">
            <option value="">Select department</option>
            <% vdepartment.forEach(opt => { %>
              <option value="<%= opt.department %>" <%= locals.venue_department === opt.department ? 'selected' : '' %>> <%= opt.department %> </option>
            <% }); %>
          </select>
        </div>

        <div class="col-md-4 mb-3">
          <label for="status" class="form-label">Status:</label>
          <select id="status" name="status" class="form-select select2 filterInput" data-placeholder="Status">
            <option value="">Select status</option>
            <% vstatus.forEach(opt => { %>
              <option value="<%= opt.status %>" <%= locals.venue_status === opt.status ? 'selected' : '' %>><%= opt.status %></option>
            <% }); %>
          </select>
        </div>
      </div>

      <div class="text-center mt-3">
        <button type="submit" class="btn btn-primary">
          <i class="fas fa-filter"></i> Filter
        </button>
        <a href="/venues" class="btn btn-secondary ms-2">
          <i class="fas fa-sync"></i> Reset
        </a>
      </div>
    </form>

    <!-- Buttons for CSV, PDF, Print -->
    <div class="download-section">
      <button id="downloadCSV" class="btn btn-info btn-download">
        <i class="fas fa-file-csv"></i> Download CSV
      </button>
      <button id="downloadPDF" class="btn btn-warning btn-download">
        <i class="fas fa-file-pdf"></i> Download PDF
      </button>
      <button id="printTable" class="btn btn-success btn-download">
        <i class="fas fa-print"></i> Print Table
      </button>
    </div>

    <!-- Display Venues -->
    <% if (Viewvenues.length > 0) { %>
      <div class="table-container" id="venuesTableContainer">
        <table class="table table-bordered table-hover" id="venuesTable">
          <thead>
            <tr>
              <th>Name</th>
              <th>Capacity</th>
              <th>Location</th>
              <th>Type</th>
              <th>Quality</th>
              <th>Department</th>
              <th>Status</th>
              <th>mnos++(1-18)</th>
              <th>tnos++(1-18)</th>
              <th>wnos++(1-18)</th>
              <th>thnos++(1-18)</th>
              <th>frnos++(1-18)</th>
              <th>satnos++(1-18)</th>
              <th>sunnos++(1-18)</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody id="venuesTbody">
            <% Viewvenues.forEach(venue => { %>
              <tr>
                <td title="ID <%= venue.venue_id %>"><%= venue.venue_name %></td>
                <td><%= venue.capacity %></td>
                <td><%= venue.location %></td>
                <td><%= venue.type %></td>
                <td><%= venue.quality %></td>
                <td><%= venue.department %></td>
                <td><%= venue.status %></td>
                <td><%= venue.mnos %></td>
                <td><%= venue.tnos %></td>
                <td><%= venue.wnos %></td>
                <td><%= venue.thnos %></td>
                <td><%= venue.frnos %></td>
                <td><%= venue.satnos %></td>
                <td><%= venue.sunnos %></td>
                <td class="action-buttons">
                  <button type="button" class="btn btn-warning btn-sm" data-bs-toggle="modal" data-bs-target="#updateModal<%= venue.venue_id %>">
                    <i class="fas fa-edit"></i> Edit
                  </button>
                  <a href="/venues/delete/<%= venue.venue_id %>" class="btn btn-danger btn-sm" onclick="return confirm('Are you sure?');">
                    <i class="fas fa-trash"></i> Delete
                  </a>
                </td>
              </tr>
              <!-- Update Modal -->
              <div class="modal fade" id="updateModal<%= venue.venue_id %>" tabindex="-1" aria-labelledby="updateModalLabel<%= venue.venue_id %>" aria-hidden="true">
                <div class="modal-dialog modal-lg">
                  <div class="modal-content">
                    <div class="modal-header">
                      <h5 class="modal-title" id="updateModalLabel<%= venue.venue_id %>">Update Venue</h5>
                      <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                      <form action="/venues/edit/<%= venue.venue_id %>" method="post">
                        <div class="mb-3">
                          <label for="name_<%= venue.venue_id %>" class="form-label text-info">Name:</label>
                          <input type="text" id="name_<%= venue.venue_id %>" name="name" class="form-control" value="<%= venue.venue_name %>" required>
                        </div>
                        <div class="mb-3">
                          <label for="capacity_<%= venue.venue_id %>" class="form-label text-info">Capacity:</label>
                          <input type="number" id="capacity_<%= venue.venue_id %>" name="capacity" class="form-control" value="<%= venue.capacity %>" required>
                        </div>
                        <div class="mb-3">
                          <label for="location_<%= venue.venue_id %>" class="form-label text-info">Location:</label>
                          <input type="text" id="location_<%= venue.venue_id %>" name="location" class="form-control" value="<%= venue.location %>" required>
                        </div>
                        <div class="mb-3">
                          <label for="type_<%= venue.venue_id %>" class="form-label text-info">Type:</label>
                          <input type="text" id="type_<%= venue.venue_id %>" name="type" class="form-control" value="<%= venue.type %>" required>
                        </div>
                        <div class="mb-3">
                          <label for="quality_<%= venue.venue_id %>" class="form-label text-info">Quality:</label>
                          <input type="text" id="quality_<%= venue.venue_id %>" name="quality" class="form-control" value="<%= venue.quality %>">
                        </div>
                        <div class="mb-3">
                          <label for="department_<%= venue.venue_id %>" class="form-label text-info">Department:</label>
                          <select id="department_<%= venue.venue_id %>" name="department" class="form-select select2" required>
                            <% departments.forEach(department => { %>
                              <option value="<%= department.department_name %>" <%= venue.department === department.department_name ? 'selected' : '' %>><%= department.department_name %></option>
                            <% }); %>
                          </select>
                        </div>
                        <div class="mb-3">
                          <label for="status_<%= venue.venue_id %>" class="form-label text-info">Status:</label>
                          <input type="text" id="status_<%= venue.venue_id %>" name="status" class="form-control" value="<%= venue.status %>" required>
                        </div>
                        <button type="submit" class="btn btn-success">
                          <i class="fas fa-save"></i> Submit Changes
                        </button>
                      </form>
                    </div>
                  </div>
                </div>
              </div>
            <% }) %>
          </tbody>
        </table>
      </div>
   <% } %>
    <% } else { %>

    <!-- Form Section -->
    <div class="form-section">
      <!-- Upload Form -->
      <h3><i class="fas fa-upload"></i> Upload CSV/Excel File</h3>
      <form action="/venues/uploads" method="post" enctype="multipart/form-data">
        <div class="mb-3">
          <label for="file" class="form-label">Choose CSV/Excel File:</label>
          <input type="file" name="file" class="form-control" required>
        </div>
        <button type="submit" class="btn btn-success">
          <i class="fas fa-cloud-upload-alt"></i> Upload
        </button>
      </form>

      <hr class="my-4">

      <!-- Add Venue Form -->
      <h2><i class="fas fa-plus-circle"></i> Add Venue</h2>
      <form action="/venues" method="post">
        <div class="row">
          <div class="col-md-6 mb-3">
            <label for="name" class="form-label">Venue Name:</label>
            <input type="text" id="name" name="name" class="form-control" required>
          </div>
          <div class="col-md-6 mb-3">
            <label for="capacity" class="form-label">Venue Capacity:</label>
            <input type="number" id="capacity" name="capacity" class="form-control" required>
          </div>
        </div>
        
        <div class="row">
          <div class="col-md-6 mb-3">
            <label for="location" class="form-label">Venue Location:</label>
            <input type="text" id="location" name="location" class="form-control" required>
          </div>
          <div class="col-md-6 mb-3">
            <label for="type" class="form-label">Venue Type:</label>
            <select id="type" name="type" class="form-select select2" required>
              <option value="Theory">Theory</option>
              <option value="Lab">Lab</option>
            </select>
          </div>
        </div>
        
        <div class="row">
          <div class="col-md-6 mb-3">
            <label for="quality" class="form-label">Venue Quality:</label>
            <input type="text" id="quality" name="quality" class="form-control">
          </div>
          <div class="col-md-6 mb-3">
            <label for="department" class="form-label">Venue Department:</label>
            <select id="department" name="department" class="form-select select2" required>
              <% departments.forEach(department => { %>
                <option value="<%= department.department_name %>"><%= department.department_name %></option>
              <% }); %>
            </select>
          </div>
        </div>

        <input type="hidden" id="status" name="status" value="used">
        <button type="submit" class="btn btn-success">
          <i class="fas fa-save"></i> Add Venue
        </button>
      </form>
    </div>
    <% } %>

  <!-- Timetable Slot Guide -->
  <div class="slot-guide">
    <h1><i class="fas fa-clock"></i> Timetable Slot Guide</h1>
    <p class="text-danger">
      THE MORE ASSIGNED VENUE WILL BE AT THE UPPER OF ALL VENUES AND IF SLOT OF THE VENUE IS FULL UP TO SUNDAY THE VENUE WILL BE REMOVED IN THE LIST
    </p>
    <div class="info-block">
      <h2><span class="key">Key:</span></h2>
      <p><span class="key">mnos to sunnos:</span> "Monday number of slots" to "Sunday number of slots".</p>
      <p><span class="key">nos:</span> "Number of slots".</p>
    </div>
  
    <div class="info-block">
      <p><span class="key">Slot Details:</span></p>
      <p class="slot">nos=1: 07:30 - 08:15</p>
      <p class="slot">nos=2: 08:15 - 09:00</p>
      <p class="slot">nos=3: 09:05 - 09:50</p>
      <p class="slot">nos=4: 09:50 - 10:35</p>
      <p><span class="key">Tea Break:</span> 10:35 - 11:00</p>
      <p class="slot">nos=5: 11:00 - 11:45</p>
      <p class="slot">nos=6: 11:45 - 12:30</p>
    </div>
  
    <div class="info-block">
      <p><span class="key">Lunch Break:</span> 12:30 - 13:15</p>
      <p class="slot">nos=7: 13:15 - 14:00</p>
      <p><span class="key"> Full_time session + veta:</span></p>
      <p class="slot">nos=8: 14:00 - 14:45</p>
      <p class="slot">nos=9: 14:50 - 15:35</p>
      <p class="slot">nos=10: 15:35 - 16:20</p>
     <p><span class="key">Evening Session + Full_time session + veta:</span></p>
      <p class="slot">nos=11: 16:25 - 17:10</p>
      <p class="slot">nos=12: 17:10 - 17:55 (End of Full-Time and veta Session)</p>
    </div>
    <div class="info-block">
      <p><span class="key">Extended Sessions (ONLY FOR EVENING SESSION):</span></p>
      <p class="slot">nos=13: 18:00 - 18:45</p>
      <p class="slot">nos=14: 18:45 - 19:35</p>
      <p class="slot">nos=15: 19:40 - 20:25</p>
      <p class="slot">nos=16: 20:25 - 21:05</p>
      <p class="slot">nos=17: 21:10 - 21:55</p>
      <p class="slot">nos=18: 22:00 - 22:45 (End of All Sessions in a Day)</p>
    </div>
  </div>
</div>

</main>

<%- include('partials/footer') %>

<script src="/js/venues.js"></script>
