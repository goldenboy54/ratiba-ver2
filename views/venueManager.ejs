<%- include('partials/nav') %>

<div class="venue-manager-header text-center py-4 mb-4">
  <div class="container">
    <h1 class="mb-2"><i class="fas fa-university me-3"></i>Venue Manager</h1>
    <p class="lead mb-0">View, Filter, and Manage All Venue Slots</p>
  </div>
</div>

<div class="container-fluid px-4">
  
  <div class="venue-manager-actions mb-4">
    <a href="/venues/form" class="btn btn-success btn-lg shadow">
      <i class="fas fa-plus-circle"></i> Add New Venue
    </a>
  </div>

  <!-- Filter Section -->
  <div class="filter-section">
    <h2>Filter Below to Customize Views</h2>
    
    <form method="GET" action="/venueManager" id="filterForm">
      <div class="row">
        <div class="col-md-4 mb-3">
          <label for="venue_name" class="form-label">Venue Name:</label>
          <select name="venue_name" id="venue_name" class="form-select select2">
            <option value="">Select venue</option>
            <% Vname.forEach(v => { %>
              <option value="<%= v.venue_name %>" <%= venue_name === v.venue_name ? 'selected' : '' %>><%= v.venue_name %></option>
            <% }) %>
          </select>
        </div>
        
        <div class="col-md-4 mb-3">
          <label for="capacity" class="form-label">Capacity:</label>
          <select name="capacity" id="capacity" class="form-select select2">
            <option value="">Select capacity</option>
            <% Vcap.forEach(v => { %>
              <option value="<%= v.capacity %>" <%= capacity == v.capacity ? 'selected' : '' %>><%= v.capacity %></option>
            <% }) %>
          </select>
        </div>
        
        <div class="col-md-4 mb-3">
          <label for="department" class="form-label">Department:</label>
          <select name="department" id="department" class="form-select select2">
            <option value="">Select department</option>
            <% Vdep.forEach(v => { %>
              <option value="<%= v.department %>" <%= department === v.department ? 'selected' : '' %>><%= v.department %></option>
            <% }) %>
          </select>
        </div>
      </div>
      
      <div class="row">
        <div class="col-md-4 mb-3">
          <label for="status" class="form-label">Status:</label>
          <select name="status" id="status" class="form-select select2">
            <option value="">Select status</option>
            <% Vstat.forEach(v => { %>
              <option value="<%= v.status %>" <%= status === v.status ? 'selected' : '' %>><%= v.status %></option>
            <% }) %>
          </select>
        </div>
        
        <div class="col-md-4 mb-3">
          <label for="day" class="form-label">Day:</label>
          <select name="day" id="day" class="form-select select2">
            <option value="">Select day</option>
            <% days.forEach(d => { %>
              <option value="<%= d %>" <%= day === d ? 'selected' : '' %>><%= d %></option>
            <% }) %>
          </select>
        </div>
        
        <div class="col-md-4 mb-3">
          <label for="slot" class="form-label">Slot:</label>
          <select name="slot" id="slot" class="form-select select2">
            <option value="">Select slot</option>
            <% slots.forEach(s => { %>
              <option value="<%= s %>" <%= slot == s ? 'selected' : '' %>>Slot <%= s %></option>
            <% }) %>
          </select>
        </div>
      </div>
      
      <div class="row">
        <div class="col-md-4 mb-3">
          <label for="slot_status" class="form-label">Slot Status:</label>
          <select name="slot_status" id="slot_status" class="form-select select2">
            <option value="">Select slot status</option>
            <% slotStatuses.forEach(st => { %>
              <option value="<%= st %>" <%= slot_status === st ? 'selected' : '' %>><%= st.charAt(0).toUpperCase() + st.slice(1) %></option>
            <% }) %>
          </select>
        </div>
      </div>
      
      <div class="text-center mt-3">
        <button type="submit" class="btn btn-primary">
          <i class="fas fa-filter"></i> Filter
        </button>
        <a href="/venueManager" class="btn btn-secondary ms-2">
          <i class="fas fa-sync"></i> Clear
        </a>
      </div>
    </form>
  </div>

  <!-- Venues List -->
  <% if (Viewvenues && Viewvenues.length > 0) { %>
    <% Viewvenues.forEach(v => { %>
      <div class="card venue-card">
        <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
          <h5 class="mb-0">
            <i class="fas fa-map-marker-alt"></i> <%= v.venue_name %>
            <small class="ml-3">(Capacity: <%= v.capacity %> | <%= v.location %> | <%= v.department %>)</small>
          </h5>
          <div>
            <button class="btn btn-warning btn-sm action-btn" data-bs-toggle="modal" data-bs-target="#editModal<%= v.venue_id %>">
              <i class="fas fa-edit"></i> Edit
            </button>
            <a href="/venueManager/delete/<%= v.venue_id %>" class="btn btn-danger btn-sm action-btn" onclick="return confirm('Delete <%= v.venue_name %> permanently?')">
              <i class="fas fa-trash"></i>
            </a>
            <button class="btn btn-info btn-sm action-btn" type="button" data-bs-toggle="collapse" data-bs-target="#matrix<%= v.venue_id %>">
              <i class="fas fa-calendar-alt"></i> Slots
            </button>
          </div>
        </div>
        <div class="card-body collapse show" id="matrix<%= v.venue_id %>">
          <div class="table-responsive">
            <table class="table table-sm table-bordered slot-matrix text-center">
              <thead>
                <tr>
                  <th>Slot</th>
                  <% days.forEach(d => { %>
                    <th><%= d.slice(0,3) %></th>
                  <% }) %>
                </tr>
              </thead>
              <tbody>
                <% slots.forEach(s => { %>
                  <tr>
                    <td class="slot-time">Slot <%= s %><br><small><%= standardTimes[s-1] %></small></td>
                    <% days.forEach(d => { %>
                      <% const status = v[`${d.toLowerCase()}_slot${s}_status`] || 'unused' %>
                      <td class="status-<%= status %>">
                        <span class="badge badge-pill <%= status === 'unused' ? 'badge-success' : status === 'booked' ? 'badge-danger' : 'badge-warning' %>">
                          <%= status.toUpperCase() %>
                        </span>
                      </td>
                    <% }) %>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- Edit Modal -->
      <div class="modal fade" id="editModal<%= v.venue_id %>" tabindex="-1">
        <div class="modal-dialog modal-xl">
          <div class="modal-content">
            <div class="modal-header bg-primary text-white">
              <h5 class="modal-title"><i class="fas fa-edit"></i> Edit Venue: <%= v.venue_name %></h5>
              <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
              <form action="/venueManager/edit/<%= v.venue_id %>" method="post">
                <!-- Basic Info -->
                <div class="row">
                  <div class="col-md-6">
                    <div class="form-group">
                      <label>Venue Name</label>
                      <input type="text" name="venue_name" value="<%= v.venue_name %>" class="form-control" required>
                    </div>
                  </div>
                  <div class="col-md-6">
                    <div class="form-group">
                      <label>Capacity</label>
                      <input type="number" name="capacity" value="<%= v.capacity %>" class="form-control" required>
                    </div>
                  </div>
                  <div class="col-md-6">
                    <div class="form-group">
                      <label>Location</label>
                      <input type="text" name="location" value="<%= v.location %>" class="form-control" required>
                    </div>
                  </div>
                  <div class="col-md-6">
                    <div class="form-group">
                      <label>Type</label>
                      <input type="text" name="type" value="<%= v.type %>" class="form-control" required>
                    </div>
                  </div>
                  <div class="col-md-6">
                    <div class="form-group">
                      <label>Quality</label>
                      <input type="text" name="quality" value="<%= v.quality %>" class="form-control" required>
                    </div>
                  </div>
                  <div class="col-md-6">
                    <div class="form-group">
                      <label>Department</label>
                      <select name="department" class="form-control" required>
                        <% departments.forEach(d => { %>
                          <option value="<%= d.department_name %>" <%= v.department === d.department_name ? 'selected' : '' %>><%= d.department_name %></option>
                        <% }) %>
                      </select>
                    </div>
                  </div>
                </div>

                <!-- Full Slot Editor (Accordion per Day) -->
                <hr>
                <h5>Edit All Slots</h5>
                <div class="accordion" id="slotEditAccordion<%= v.venue_id %>">
                  <% days.forEach((day, idx) => { %>
                    <div class="card">
                      <div class="card-header">
                        <h2 class="mb-0">
                          <button class="btn btn-block text-left <%= idx === 0 ? '' : 'collapsed' %>" type="button" data-bs-toggle="collapse" data-bs-target="#day<%= day %><%= v.venue_id %>">
                            <%= day %> Slots
                          </button>
                        </h2>
                      </div>
                      <div id="day<%= day %><%= v.venue_id %>" class="collapse <%= idx === 0 ? 'show' : '' %>" data-bs-parent="#slotEditAccordion<%= v.venue_id %>">
                        <div class="card-body p-2">
                          <table class="table table-sm">
                            <% slots.forEach(s => { %>
                              <tr>
                                <td width="10%"><strong>Slot <%= s %></strong></td>
                                <td width="50%">
                                  <input type="text" name="<%= day.toLowerCase() %>_slot<%= s %>" value="<%= v[`${day.toLowerCase()}_slot${s}`] || standardTimes[s-1] %>" class="form-control form-control-sm">
                                </td>
                                <td width="40%">
                                  <select name="<%= day.toLowerCase() %>_slot<%= s %>_status" class="form-control form-control-sm">
                                    <% slotStatuses.forEach(st => { %>
                                      <option value="<%= st %>" <%= (v[`${day.toLowerCase()}_slot${s}_status`] || 'unused') === st ? 'selected' : '' %>><%= st.charAt(0).toUpperCase() + st.slice(1) %></option>
                                    <% }) %>
                                  </select>
                                </td>
                              </tr>
                            <% }) %>
                          </table>
                        </div>
                      </div>
                    </div>
                  <% }) %>
                </div>

                <div class="text-center mt-4">
                  <button type="submit" class="btn btn-success btn-lg"><i class="fas fa-save"></i> Save Changes</button>
                </div>
              </form>
            </div>
          </div>
        </div>
      </div>
    <% }) %>
  <% } else { %>
    <div class="text-center py-5">
      <i class="fas fa-inbox fa-5x text-muted mb-4"></i>
      <h3>No venues found</h3>
      <p class="text-muted">Try adjusting your filters or <a href="/venueManager/form">add a new venue</a>.</p>
    </div>
  <% } %>
</div>

  </main>
<%- include('partials/footer') %>