<%- include('partials/nav') %>

<div class="container-fluid py-4">
  
  <div class="subjects-header">
    <a href="/subjects/form" class="btn btn-primary mb-3">
      <i class="fas fa-plus"></i> Assign New Informations Here
    </a>
  </div>

  <div id="successAlert" class="alert alert-success d-none" role="alert">
    Updated successfully!
  </div>

  <% if (locals.subjects) { %>

    <div class="filter-section">
      <h2>Filter Below to Customize Views</h2>
      
      <form method="get" action="/subjects">
        <div class="row">
          <div class="col-md-4 mb-3">
            <label for="user" class="form-label">User:</label>
            <select id="user" name="user" class="form-select select2">
              <option value="">Select user</option>
              <% uname.forEach(user => { %>
                <option value="<%= user.full_name %>" <%= user_name === user.full_name ? 'selected' : '' %>><%= user.full_name %></option>
              <% }); %>
            </select>
          </div>
          
          <div class="col-md-4 mb-3">
            <label for="program_name" class="form-label">Program Name:</label>
            <select id="program_name" name="program_name" class="form-select select2">
              <option value="">Select program</option>
              <% pname.forEach(program => { %>
                <option value="<%= program.program_name %>" <%= program_name === program.program_name ? 'selected' : '' %>><%= program.program_name %></option>
              <% }); %>
            </select>
          </div>
          
          <div class="col-md-4 mb-3">
            <label for="category" class="form-label">Mother Program Department:</label>
            <select id="category" name="category" class="form-select select2">
              <option value="">Select program department</option>
              <% pcategory.forEach(program => { %>
                <option value="<%= program.program_category %>" <%= category === program.program_category ? 'selected' : '' %>><%= program.program_category %></option>
              <% }); %>
            </select>
          </div>
        </div>
        
        <div class="row">
          <div class="col-md-4 mb-3">
            <label for="level" class="form-label">Level:</label>
            <select id="level" name="level" class="form-select select2">
              <option value="">Select level</option>
              <% plevel.forEach(program => { %>
                <option value="<%= program.program_level %>" <%= level === program.program_level ? 'selected' : '' %>><%= program.program_level %></option>
              <% }); %>
            </select>
          </div>
          
          <div class="col-md-4 mb-3">
            <label for="title" class="form-label">Subject Name:</label>
            <select id="title" name="title" class="form-select select2">
              <option value="">Select subject name</option>
              <% sname.forEach(subject => { %>
                <option value="<%= subject.title %>" <%= title === subject.title ? 'selected' : '' %>><%= subject.title %></option>
              <% }); %>
            </select>
          </div>
          
          <div class="col-md-4 mb-3">
            <label for="subject_code" class="form-label">Subject Code:</label>
            <select id="subject_code" name="subject_code" class="form-select select2">
              <option value="">Select subject code</option>
              <% scode.forEach(subject => { %>
                <option value="<%= subject.subject_code %>" <%= subject_code === subject.subject_code ? 'selected' : '' %>><%= subject.subject_code %></option>
              <% }); %>
            </select>
          </div>
        </div>

        <div class="row">
          <div class="col-md-4 mb-3">
            <label for="subject_department" class="form-label">Mother Subject Department:</label>
            <select id="subject_department" name="subject_department" class="form-select select2">
              <option value="">Select subject department</option>
              <% idara.forEach(department => { %>
                <option value="<%= department.subject_department %>" <%= subject_department === department.subject_department ? 'selected' : '' %>><%= department.subject_department %></option>
              <% }); %>
            </select>
          </div>
        
          <div class="col-md-4 mb-3">
            <label for="semester" class="form-label">Semester:</label>
            <select id="semester" name="semester" class="form-select select2">
              <option value="">Select semester</option>
              <% semesters.forEach(semester => { %>
                <option value="<%= semester.semester %>" <%= semester === semester.semester ? 'selected' : '' %>><%= semester.semester %></option>
              <% }); %>
            </select>
          </div>
          
          <div class="col-md-4 mb-3">
            <label for="program_type" class="form-label">Program Type:</label>
            <select id="program_type" name="program_type" class="form-select select2">
              <option value="">Select type</option>
              <% ptypes.forEach(type => { %>
                <option value="<%= type.program_type %>" <%= program_type === type.program_type ? 'selected' : '' %>><%= type.program_type %></option>
              <% }); %>
            </select>
          </div>
        </div>
        
        <div class="text-center mt-3">
          <button type="submit" class="btn btn-primary">
            <i class="fas fa-filter"></i> Filter
          </button>
        </div>
      </form>
    </div>
    
    <!-- CSV / PDF / Print Buttons -->
    <div class="download-section">
      <button id="csvDownloadBtn" class="btn btn-success btn-download">
        <i class="fas fa-file-csv"></i> Download CSV
      </button>
      <button id="pdfDownloadBtn" class="btn btn-info btn-download">
        <i class="fas fa-file-pdf"></i> Download PDF
      </button>
      <button id="printBtn" class="btn btn-secondary btn-download">
        <i class="fas fa-print"></i> Print
      </button>
    </div>

    <!-- Display timetables -->
    <% if (user_name || semester || program_type || program_name || level || subject_department || title || subject_code || category) { %>
    
      <h2 class="mb-4">List of Assigned Subjects</h2>
      <div id="subjectTableContainer" class="table-container">
        <table id="subjectTable" class="table table-bordered table-hover">
          <thead>
            <tr>
              <th>Tutor</th>
              <th>Subject</th>
              <th>Program</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% subjects.forEach(subject => { %>
              <tr>
                <td class="subject-details">
                  <b><%= subject.full_name %></b><br>
                  Email: <%= subject.user_email %><br>
                  Mother Department: <%= subject.user_department %><br>
                  Original Role: <%= subject.user_role %><br>
                  Status: <%= subject.user_status %>
                </td>
                <td class="subject-details">
                  <b><%= subject.title %></b><br>
                  Code: <%= subject.subject_code %><br>
                  Mother Subject Department: <%= subject.subject_department %><br>
                  Credit: <%= subject.credit %><br>
                  LTPA: <%= subject.total_hours_per_week %><br>
                  LTPA Assigned by Tmaster: <%= subject.ltpa %><br>
                  Type: <%= subject.type_prac_or_theory %><br>
                  Semester: <%= subject.semester %>
                </td>
                <td class="subject-details">
                  <b><%= subject.program_name %></b><br>
                  Code: <%= subject.program_code %><br>
                  Mother Program Department: <%= subject.category %><br>
                  Type: <%= subject.program_type %><br>
                  Level: <%= subject.program_level %><br>
                  Capacity: <%= subject.program_capacity %><br>
                  Duration: <%= subject.program_duration %> yrs
                </td>
                <td>
                  <button type="button" class="btn btn-warning btn-sm fixed-size-btn" data-bs-toggle="modal" data-bs-target="#updateModal<%= subject.subject_id %>">
                    <i class="fas fa-edit"></i> Edit
                  </button>
                  <a href="/subjects/delete/<%= subject.subject_id %>" class="btn btn-danger btn-sm fixed-size-btn" onclick="return confirm('Are you sure you want to delete this subject?');">
                    <i class="fas fa-trash"></i> Delete
                  </a>
                </td>
              </tr>

              <!-- Update Modal -->
              <div class="modal fade" id="updateModal<%= subject.subject_id %>" tabindex="-1" aria-labelledby="updateModalLabel<%= subject.subject_id %>" aria-hidden="true">
                <div class="modal-dialog modal-lg">
                  <div class="modal-content">
                    <div class="modal-header">
                      <h5 class="modal-title" id="updateModalLabel<%= subject.subject_id %>">Update Subject Assignment</h5>
                      <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                      <form action="/subjects/edit/<%= subject.subject_id %>" method="post">
                        <div class="mb-3">
                          <label for="user_id" class="form-label text-info">User Name:</label>
                          <select id="user_id" name="user_id" class="form-select select2" required>
                            <% users.forEach(user => { %>
                              <option value="<%= user.user_id %>" <%= subject.user_id === user.user_id ? 'selected' : '' %>>
                                <%= user.user_id %> - <%= user.full_name %>
                              </option>
                            <% }); %>
                          </select>
                        </div>
                        
                        <div class="mb-3">
                          <label for="title" class="form-label text-info">Subject Name:</label>
                          <input type="text" id="title" name="title" class="form-control" value="<%= subject.title %>" required>
                        </div>
                        
                        <div class="mb-3">
                          <label for="subject_code" class="form-label text-info">Subject Code:</label>
                          <input type="text" id="subject_code" name="subject_code" class="form-control" value="<%= subject.subject_code %>" required>
                        </div>
                        
                        <div class="row">
                          <div class="col-md-6 mb-3">
                            <label for="credit" class="form-label text-info">Subject Credit:</label>
                            <input type="number" id="credit" name="credit" class="form-control" value="<%= subject.credit %>" required>
                          </div>
                          
                          <div class="col-md-6 mb-3">
                            <label for="total_hours_per_week" class="form-label text-info">Total Hours Per Week:</label>
                            <input type="number" id="total_hours_per_week" name="total_hours_per_week" class="form-control" value="<%= subject.total_hours_per_week %>" required>
                          </div>
                        </div>
                        
                        <div class="mb-3">
                          <label for="program_id" class="form-label text-info">Program:</label>
                          <select id="program_id" name="program_id" class="form-select select2" required>
                            <% programs.forEach(program => { %>
                              <option value="<%= program.program_id %>" <%= subject.program_id === program.program_id ? 'selected' : '' %>>
                                <%= program.program_name %> (CODE: <%= program.program_code %>, LEVEL <%= program.level %> <%= program.program_type %>)
                              </option>
                            <% }); %>
                          </select>
                        </div>
                        
                        <div class="row">
                          <div class="col-md-6 mb-3">
                            <label for="subject_department" class="form-label text-info">Subject Department:</label>
                            <input type="text" id="subject_department" name="subject_department" class="form-control" value="<%= subject.subject_department %>" required>
                          </div>
                          
                          <div class="col-md-6 mb-3">
                            <label for="type_prac_or_theory" class="form-label text-info">Subject Type:</label>
                            <input type="text" id="type_prac_or_theory" name="type_prac_or_theory" class="form-control" value="<%= subject.type_prac_or_theory %>" required>
                          </div>
                        </div>
                        
                        <div class="mb-3">
                          <label for="semester" class="form-label text-info">Semester:</label>
                          <input type="text" id="semester" name="semester" class="form-control" value="<%= subject.semester %>" required>
                        </div>
                        
                        <button type="submit" class="btn btn-success">
                          <i class="fas fa-save"></i> Submit Changes
                        </button>
                      </form>
                    </div>
                  </div>
                </div>
              </div>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } 
    } else { %>

    <!-- Add/Upload Form Section -->
    <div class="form-section">
      <h4><i class="fas fa-upload"></i> Upload CSV / Excel</h4>
      <form action="/subjects/upload" method="post" enctype="multipart/form-data">
        <div class="mb-3">
          <label for="file" class="form-label">Choose file (CSV or XLSX)</label>
          <p><small class="text-muted">Required columns: <strong>user_email, subject_code, program_code (single or combined with +), total_hours_per_week, semester</strong></small></p>
          <input type="file" name="file" class="form-control" accept=".csv, .xlsx" required>
        </div>
        <button type="submit" class="btn btn-success">
          <i class="fas fa-cloud-upload-alt"></i> Upload & Import
        </button>
      </form>

      <hr>

      <h4><i class="fas fa-plus-circle"></i> Or Add Manually</h4>
      <form action="/subjects/form" method="post">
        <div class="row">
          <div class="col-md-6 mb-3">
            <label for="user_id" class="form-label">Tutor (select)</label>
            <select id="user_id" name="user_id" class="form-select select2" required>
              <% users.forEach(user => { %>
                <option value="<%= user.user_id %>"><%= user.full_name %> (<%= user.user_email %>)</option>
              <% }); %>
            </select>
          </div>

          <div class="col-md-6 mb-3">
            <label for="subject_id" class="form-label">Registered Subject</label>
            <select id="subject_id" name="subject_id" class="form-select select2" required>
              <% registered_subjects.forEach(rs => { %>
                <option value="<%= rs.registered_subject_id %>">
                  <%= rs.registered_subject_name %> (code: <%= rs.registered_subject_code %>)
                </option>
              <% }); %>
            </select>
          </div>
        </div>

        <div class="row">
          <div class="col-md-4 mb-3">
            <label for="total_hours_per_week" class="form-label">Total Hours Per Week</label>
            <input type="number" id="total_hours_per_week" name="total_hours_per_week" class="form-control" value="0" required>
          </div>

          <div class="col-md-4 mb-3">
            <label for="semester" class="form-label">Semester</label>
            <select id="semester" name="semester" class="form-select select2" required>
              <option value="I">I</option>
              <option value="II">II</option>
            </select>
          </div>

          <div class="col-md-4 mb-3">
            <label for="type_prac_or_theory" class="form-label">Type</label>
            <select id="type_prac_or_theory" name="type_prac_or_theory" class="form-select select2" required>
              <option value="Theory">Theory</option>
              <option value="Lab">Lab</option>
            </select>
          </div>
        </div>

        <div class="mb-3">
          <label for="program_ids" class="form-label">Programs (select one or many)</label>
          <select id="program_ids" name="program_ids[]" class="form-select select2" multiple required>
            <% programs.forEach(program => { %>
              <option value="<%= program.program_id %>"><%= program.program_name %> (CODE: <%= program.program_code %>)</option>
            <% }); %>
          </select>
        </div>

        <button type="submit" class="btn btn-primary">
          <i class="fas fa-save"></i> Add Subject
        </button>
      </form>
    </div>

<% } %>
    
</div>

</main>

<%- include('partials/footer') %>
<script src="/js/subjects.js"></script>
