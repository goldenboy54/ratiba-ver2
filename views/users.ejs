<%- include('partials/nav') %>

<div class="container-fluid py-4">
  <div class="users-header">
    <h1><i class="fas fa-users"></i> Users Management</h1>
    <div class="d-flex gap-3 align-items-center">
      <span class="user-info"><%= sessionUser ? sessionUser.full_name : "Guest" %> - <%= sessionUser ? sessionUser.role.toUpperCase() : "" %></span>
      <a href="/users/form" class="btn btn-primary"><i class="fas fa-plus"></i> Register User</a>
    </div>
  </div>

  <!-- User Registration Form (when no users exist) -->
  <% if(!ViewUsers || ViewUsers.length === 0) { %>
    <div class="form-section">
      <!-- Upload CSV/Excel -->
      <h3><i class="fas fa-upload"></i> Upload CSV/Excel File</h3>
      <form action="/users/uploads" method="post" enctype="multipart/form-data">
        <div class="mb-3">
          <label for="file" class="form-label">Choose CSV/Excel File:</label>
          <input type="file" name="file" class="form-control" accept=".csv,.xlsx,.xls" required>
        </div>
        <button type="submit" class="btn btn-success">
          <i class="fas fa-cloud-upload-alt"></i> Upload File
        </button>
      </form>

      <hr>

      <!-- Manual Add Form -->
      <h2><i class="fas fa-user-plus"></i> Add Staff Member</h2>
      <form action="/users" method="post">
        <div class="row">
          <div class="col-md-6 mb-3">
            <label for="full_name" class="form-label">Full Name:</label>
            <input type="text" id="full_name" name="full_name" class="form-control" required>
          </div>

          <div class="col-md-6 mb-3">
            <label for="department" class="form-label">Department:</label>
            <select id="department" name="department" class="form-select select2" required>
          <option value="">-- Select Department --</option>
          <% departments.forEach(department => { %>
            <option value="<%= department.department_name %>"><%= department.department_name %></option>
          <% }); %>
            </select>
          </div>
        </div>

        <div class="row">
          <div class="col-md-6 mb-3">
            <label for="user_email" class="form-label">Email:</label>
            <input type="email" id="user_email" name="user_email" class="form-control" required>
          </div>

          <div class="col-md-6 mb-3">
            <label for="role" class="form-label">Role:</label>
            <select id="role" name="role" class="form-select select2" required>
          <option value="tutor">Tutor</option>
          <% if (sessionUser && sessionUser.role === "tmaster") { %>
            <option value="tmaster">Tmaster</option>
            <option value="admin">Admin</option>
          <% } %>
          <option value="hod">HOD</option>
            </select>
          </div>
        </div>

        <div class="row">
          <div class="col-md-6 mb-3">
            <label for="password" class="form-label">Password:</label>
            <input type="password" id="password" name="password" class="form-control" required>
          </div>

          <div class="col-md-6 mb-3">
            <label for="status" class="form-label">Status:</label>
            <select id="status" name="status" class="form-select select2" required>
              <option value="active">Active</option>
              <option value="inactive">Inactive</option>
            </select>
          </div>
        </div>

        <button type="submit" class="btn btn-primary btn-lg">
          <i class="fas fa-save"></i> Submit
        </button>
      </form>
    </div>
  <% } %>

  <!-- Users Table & Filters -->
  <% if (ViewUsers && ViewUsers.length > 0) { %>
    <form method="get" action="/users" class="filter-section" id="filterForm">
      <div class="row">
        <% const filters = [
          {id:'full_name', name:'full_name', label:'Full Name', values: uname},
          {id:'department', name:'department', label:'Department', values: udepartment},
          {id:'user_email', name:'user_email', label:'Email', values: uemail},
          {id:'role', name:'role', label:'Role', values: urole},
          {id:'status', name:'status', label:'Status', values: ustatus}
        ]; %>

        <% filters.forEach(f => { %>
          <div class="col-md-4 mb-3">
            <label for="<%= f.id %>" class="form-label"><%= f.label %>:</label>
            <select id="<%= f.id %>" name="<%= f.name %>" class="form-select select2 filterInput">
              <option value="">All <%= f.label %></option>
              <% f.values.forEach(val => { %>
                <option value="<%= val[f.name] %>" <%= locals[f.name] === val[f.name] ? 'selected' : '' %>>
                  <%= val[f.name] %>
                </option>
              <% }) %>
            </select>
          </div>
        <% }) %>
      </div>
    </form>

    <div class="download-section">
      <button id="downloadCSV" class="btn btn-success btn-download"><i class="fas fa-file-csv"></i> Download CSV</button>
      <button id="downloadPDF" class="btn btn-info btn-download"><i class="fas fa-file-pdf"></i> Download PDF</button>
      <button id="printTable" class="btn btn-secondary btn-download"><i class="fas fa-print"></i> Print Table</button>
    </div>

    <div class="table-container" id="usersTableContainer">
      <table class="table table-bordered table-hover" id="usersTable">
        <thead>
          <tr>
            <th>Full Name</th>
            <th>Department</th>
            <th>Email</th>
            <th>Role</th>
            <th>Status</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% ViewUsers.forEach(user => { %>
            <tr>
              <td><%= user.full_name %></td>
              <td><%= user.department %></td>
              <td><%= user.user_email %></td>
              <td><%= user.role %></td>
              <td>
                <span class="badge <%= user.status === 'active' ? 'badge-success' : 'badge-secondary' %>">
                  <%= user.status %>
                </span>
              </td>
              <td class="action-buttons">
                <button type="button" class="btn btn-warning btn-sm" data-bs-toggle="modal" data-bs-target="#updateModal<%= user.user_id %>">
                  <i class="fas fa-edit"></i> Edit
                </button>
                <a href="/users/delete/<%= user.user_id %>" class="btn btn-danger btn-sm" onclick="return confirm('Are you sure you want to delete this user?');">
                  <i class="fas fa-trash"></i> Delete
                </a>
              </td>
            </tr>

            <!-- Edit Modal -->
            <div class="modal fade" id="updateModal<%= user.user_id %>" tabindex="-1" aria-labelledby="updateModalLabel<%= user.user_id %>" aria-hidden="true">
              <div class="modal-dialog">
                <div class="modal-content">
                  <div class="modal-header">
                    <h5 class="modal-title" id="updateModalLabel<%= user.user_id %>">Update User: <%= user.full_name %></h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                  </div>
                  <div class="modal-body">
                    <form action="/users/edit/<%= user.user_id %>" method="post">
                      <div class="mb-3">
                        <label class="form-label">Full Name:</label>
                        <input type="text" name="full_name" class="form-control" value="<%= user.full_name %>" required>
                      </div>

                      <div class="mb-3">
                        <label class="form-label">Department:</label>
                        <select name="department" class="form-select select2-modal" required>
                          <option value="">-- Select Department --</option>
                          <% departments.forEach(d => { %>
                            <option value="<%= d.department_name %>" 
                              <%= user.department === d.department_name ? 'selected' : '' %>>
                              <%= d.department_name %>
                            </option>
                          <% }) %>
                        </select>
                      </div>

                      <div class="mb-3">
                        <label class="form-label">Email:</label>
                        <input type="email" name="user_email" class="form-control" value="<%= user.user_email %>" required>
                      </div>

                      <div class="mb-3">
                        <label class="form-label">Role:</label>
                        <% if(sessionUser && sessionUser.role === 'tmaster'){ %>
                          <select name="role" class="form-select select2-modal" required>
                            <% ['tutor', 'tmaster', 'hod', 'admin'].forEach(r => { %>
                              <option value="<%= r %>" <%= user.role === r ? 'selected' : '' %>><%= r.charAt(0).toUpperCase() + r.slice(1) %></option>
                            <% }) %>
                          </select>
                        <% } else { %>
                          <input type="text" class="form-control" value="<%= user.role.charAt(0).toUpperCase() + user.role.slice(1) %>" readonly>
                        <% } %>
                      </div>

                      <div class="mb-3">
                        <label class="form-label">Status:</label>
                        <select name="status" class="form-select select2-modal" required>
                          <option value="active" <%= user.status === 'active' ? 'selected' : '' %>>Active</option>
                          <option value="inactive" <%= user.status === 'inactive' ? 'selected' : '' %>>Inactive</option>
                        </select>
                      </div>

                      <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-success"><i class="fas fa-save"></i> Save Changes</button>
                      </div>
                    </form>
                  </div>
                </div>
              </div>
            </div>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>

</main>

<script src="/js/users.js"></script>

<%- include('partials/footer') %>
