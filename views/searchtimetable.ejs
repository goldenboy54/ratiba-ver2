<%- include('partials/nav') %>

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Search Timetables</title>
  <!-- Bootstrap 5 + Select2 CSS already loaded by partials/nav.ejs above -->

  <style>
    body { background: #f7f9fc; font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif; }
    h2 { font-weight: 700; text-transform: uppercase; margin-bottom: 30px; }
    .select2-container .select2-selection--single { height: 38px; border: 1px solid #007bff; }
    .select2-selection__rendered { line-height: 38px !important; }
    .select2-selection__arrow { height: 38px !important; }
    .animated-graphic { font-size: 40px; animation: spin 2s linear infinite; margin-bottom: 20px; }
    @keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }
    .table-container { overflow-x: auto; margin-top: 20px; }
    th { background-color: #007bff; color: white; text-align: center; }
    td { vertical-align: middle; text-align: center; }
    .btn-download { margin: 5px; }
  </style>
</head>
<body>
  <div class="text-center mb-4 mt-3">
    <div class="animated-graphic" title="Timetable autogenerating system">🕑</div>
    <h2 class="text-primary mt-2">FILTER YOUR TIMETABLE</h2>
  </div>

  <!-- SEMESTER SELECTION -->
  <div class="container mb-3">
    <form method="get" action="/searchtimetable" id="semesterForm">
      <div class="form-group col-md-4 mx-auto">
        <select id="semester" name="semester" class="form-control select2" required>
          <option value="">-- Choose Semester --</option>
          <% semesters.forEach(sem => { %>
            <option value="<%= sem.semester %>" <%= semester === sem.semester ? 'selected' : '' %>>
              <%= sem.semester %>
            </option>
          <% }); %>
        </select>
      </div>
    </form>
  </div>

  <!-- SEARCH FILTER FORM -->
  <div class="container">
    <form method="get" action="/searchtimetable" id="filterForm" class="mb-4">
      <input type="hidden" name="semester" value="<%= semester %>" />
      <div class="form-row">
        <% const filterFields = [
          {id:'tutor', label:'Tutor', options: tutors, valueField:'tutor_name', selected: tutor_name}
        ]; %>

        <% filterFields.forEach(field => { %>
          <div class="form-group col-md-4">
            <label><%= field.label %>:</label>
            <select id="<%= field.id %>" name="<%= field.id %>" class="form-control select2">
              <option value="">Select <%= field.label %></option>
              <% field.options.forEach(opt => { %>
                <option value="<%= opt[field.valueField] %>" <%= field.selected === opt[field.valueField] ? 'selected' : '' %>>
                  <%= opt[field.valueField] %>
                </option>
              <% }); %>
            </select>
          </div>
        <% }); %>
      </div>
    </form>
  </div>

  <!-- TIMETABLE RESULTS -->
  <div class="container">
    <% if (timetables && timetables.length > 0 && (tutor_name || (program_name && program_level) )) { %>
      <h3 class="text-center mt-4 text-primary">ARUSHA TECHNICAL COLLEGE</h3>
      <h5 class="text-center text-dark mb-3">
        TIMETABLE - SEMESTER <%= semester %> (
        <script>
          document.write(`${((d=>d.getMonth()+1>=8?d.getFullYear():d.getFullYear()-1)(new Date()))}/${((d=>d.getMonth()+1>=8?d.getFullYear()+1:d.getFullYear())(new Date()))}`);
        </script>)
      </h5>

      <% 
        const weekdayOrder = ["MONDAY","TUESDAY","WEDNESDAY","THURSDAY","FRIDAY","SATURDAY","SUNDAY"];
        const uniqueDays = weekdayOrder.filter(day => timetables.some(t => t.day === day));

        const grouped = timetables.reduce((acc, t) => {
          const start = t.start_time ? t.start_time.split(":").slice(0,2).join(":") : null;
          const end = t.end_time ? t.end_time.split(":").slice(0,2).join(":") : null;
          if(start && end){
            const slot = `${start} - ${end}`;
            if(!acc[slot]) acc[slot] = [];
            acc[slot].push(t);
          }
          return acc;
        }, {});

        const breaks = [
          {nos:5, time:"10:35 - 11:00", type:"Tea Break"},
          {nos:6, time:"12:30 - 13:15", type:"Lunch Break"}
        ];

        // Merge DB slots + breaks, sort chronologically
        const allSlots = [...new Set([...Object.keys(grouped), ...breaks.map(b => b.time)])]
                          .sort((a,b) => {
                            const getMinutes = time => {
                              const [start] = time.split(" - ");
                              const [h,m] = start.split(":").map(Number);
                              return h*60 + m;
                            };
                            return getMinutes(a) - getMinutes(b);
                          });
      %>

      <div class="table-container" id="timetableContent">
        <table class="table table-bordered table-striped">
          <thead>
            <tr>
              <th>TIME</th>
              <% uniqueDays.forEach(day => { %>
                <th><%= day %></th>
              <% }); %>
            </tr>
          </thead>
          <tbody>
            <% allSlots.forEach(slot => { %>
              <tr>
                <td><b><%= slot %></b></td>
                <% uniqueDays.forEach(day => { 
                  const entry = grouped[slot] ? grouped[slot].find(t => t.day === day) : null;
                  const brk = breaks.find(b => b.time === slot);
                %>
                  <td>
                    <% if(entry){ %>
                      <b>Venue:</b> <%= entry.venue_name || '---' %> (<%= entry.venue_type || '---' %>)<br>
                      <b>Subject:</b> <%= entry.subject_name || '---' %> (<%= entry.subject_code || '---' %>)<br>
                      <b>Tutor:</b> <%= entry.tutor_name || '---' %><br>
                      <b>Program:</b> <%= entry.program_code || '---' %> (<%= entry.program_level || '---' %>)
                    <% } else if(brk) { %>
                      <i><%= brk.type %></i>
                    <% } else { %>
                      <i>---</i>
                    <% } %>
                  </td>
                <% }); %>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>

      <div class="text-center my-4">
        <button id="frontendPrintBtn" class="btn btn-secondary btn-download">Print/Download Timetable</button>
      </div>

    <% } else if (semester) { %>
      <p class="text-center text-danger mt-4">Filter to view the timetable.</p>
    <% } %>
  </div>

  <!-- JS (self-hosted: CDN scanning/rewriting by some browser security suites was corrupting the JS) -->
  <script src="/vendor/jquery/jquery-3.7.0.min.js"></script>
  <script src="/vendor/select2/js/select2.min.js"></script>
  <script src="/vendor/jspdf/jspdf.umd.min.js"></script>
  <script src="/vendor/html2canvas/html2canvas.min.js"></script>
  <script>
  $(document).ready(function() {
    $('.select2').each(function() {
      var $el = $(this);
      $el.select2({
        allowClear: true,
        placeholder: $el.data('placeholder') || $el.find('option[value=""]').first().text() || 'Select an option'
      });
    });

    $('#semester').on('change', function(){ $('#semesterForm').submit(); });
    $('#filterForm select').on('change', function(){ $('#filterForm').submit(); });

    function getAcademicYear() {
      const now = new Date();
      const month = now.getMonth() + 1;
      const year = now.getFullYear();
      return month >= 8 ? `${year}/${year+1}` : `${year-1}/${year}`;
    }

    $('#frontendPrintBtn').on('click', function(){
      const content = document.getElementById('timetableContent').innerHTML;
      const win = window.open('', '', 'width=1000,height=800');
      const academicYear = getAcademicYear();
      win.document.write('<html><head><title>ATC Timetable</title>');
      win.document.write('<style>body{font-family:Arial,sans-serif;margin:20px;} table{width:100%;border-collapse:collapse;} th,td{border:1px solid #000;padding:6px;text-align:center;} th{background:#007bff;color:#fff;} tbody tr:nth-child(even){background:#f2f2f2;}</style>');
      win.document.write('</head><body>');
      win.document.write('<h1 style="text-align:center;">ARUSHA TECHNICAL COLLEGE</h1>');
      win.document.write('<h2 style="text-align:center;">Timetable - Semester <%= semester %> (' + academicYear + ')</h2>');
      win.document.write(content);
      win.document.write('</body></html>');
      win.document.close();
      win.focus();
      win.print();
    });
  });
  </script>
</body>
</html>

