<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Search Timetables</title>
  <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/select2/4.0.13/css/select2.min.css" />
  <style>
    .table-container {
      overflow-x: auto; /* Ensures horizontal scrolling if table overflows */
    }
    .animated-graphic {
      font-size: 3rem; /* Adjust as needed */
      animation: spin 3s linear infinite; /* Add a spinning animation */
    }
    @keyframes spin {
      0% { transform: rotate(0deg); }
      100% { transform: rotate(360deg); }
    }
    .table thead {
      background: linear-gradient(45deg, #28a745, #007bff); /* Green-blue gradient */
      color: #fff;
    }
    .table th, .table td {
      vertical-align: middle;
      text-align: center;
      font-size: 1.1rem;
    }
  
    .btn-primary {
      background-color: #007bff;
      border-color: #007bff;
      transition: background-color 0.3s ease, border-color 0.3s ease;
    }
    .btn-primary:hover {
      background-color: #0056b3;
      border-color: #004085;
    }
  </style>

  <style>
    /* Gradient Background */
    body {
      background: linear-gradient(to bottom, green, #66cc66, blue);
      background-size: cover;
      height: 100vh;  /* Ensure the background covers the full viewport height */
      margin: 0;
      color: #fff;  /* Ensure text stands out on the background */
    }
  
    .fixed-size-btn {
      width: 80px;
      height: 35px;
    }
  
    .modal-dialog {
      max-width: 90%;
    }
  
    /* Responsive button size */
    @media (max-width: 768px) {
      .fixed-size-btn {
        width: 100px;
        height: 40px;
      }
    }
  
    /* Additional custom styling for readability */
    h2, h1, label {
      color: #fff;  /* White text to stand out against the background */
    }
  
    .btn-primary {
      background-color: #007bff; /* Blue buttons */
      border-color: #007bff;
    }
  
    /* Make table headers and rows stand out */
    .table th, .table td {
      color: #fff;  /* White text for table */
    }
  
    /* Ensure form controls are more visible */
    .form-control {
      background-color: #f8f9fa;
      color: #495057;
    }
    
    .thead-dark {
      background-color: #343a40;
    }
  </style>
  
</head>
<body>
  <%- include('partials/nav') %>

  <div class="container mt-5">
    <div class="text-center mb-4">
      <div class="animated-graphic" title="Timetable autogenerating system">🕑</div> 
    </div> 
 <h2 class="text-center text-primary">FILTER YOUR TIMETABLE BASED ON BELOW INFORMATION</h2>
    <!-- Search Form -->
    <form method="get" action="/searchtimetable" class="mb-4">
      <div class="form-row">
        <div class="form-group col-md-4">
          <label for="program">Program:</label>
          <select id="program" name="program" class="form-control select2">
            <option value="">Select Program</option>
            <% programs.forEach(program => { %>
              <option value="<%= program.program_name %>" <%= program_name === program.program_name ? 'selected' : '' %>><%= program.program_name %></option>
            <% }); %>
          </select>
        </div>

        <div class="form-group col-md-4">
          <label for="program_type">program_type:</label>
          <select id="program_type" name="program_type" class="form-control select2">
            <option value="">Select type</option>
            <% ptypes.forEach(type => { %>
              <option value="<%= type.program_type %>" <%= program_type === type.program_type ? 'selected' : '' %>><%= type.program_type %></option>
            <% }); %>
          </select>
        </div>

        <div class="form-group col-md-4">
          <label for="level">Level:</label>
          <select id="level" name="level" class="form-control select2">
            <option value="">Select Level</option>
            <% levels.forEach(level => { %>
              <option value="<%= level.program_level %>" <%= program_level === level.program_level ? 'selected' : '' %>><%= level.program_level %></option>
            <% }); %>
          </select>
        </div>

        <div class="form-group col-md-4">
          <label for="venue">Venue:</label>
          <select id="venue" name="venue" class="form-control select2">
            <option value="">Select Venue</option>
            <% venues.forEach(venue => { %>
              <option value="<%= venue.venue_name %>" <%= venue_name === venue.venue_name ? 'selected' : '' %>><%= venue.venue_name %></option>
            <% }); %>
          </select>
        </div>

        <div class="form-group col-md-4">
          <label for="tutor">Tutor:</label>
          <select id="tutor" name="tutor" class="form-control select2">
            <option value="">Select Tutor</option>
            <% tutors.forEach(tutor => { %>
              <option value="<%= tutor.tutor_name %>" <%= tutor_name === tutor.tutor_name ? 'selected' : '' %>><%= tutor.tutor_name %></option>
            <% }); %>
          </select>
        </div>

        <div class="form-group col-md-4">
          <label for="department">Department:</label>
          <select id="department" name="department" class="form-control select2">
            <option value="">Select Department</option>
            <% departments.forEach(department => { %>
              <option value="<%= department.department_name %>" <%= department_name === department.department_name ? 'selected' : '' %>><%= department.department_name %></option>
            <% }); %>
          </select>
        </div>

        <div class="form-group col-md-4">
          <label for="subject">Subject:</label>
          <select id="subject" name="subject" class="form-control select2">
            <option value="">Select Subject</option>
            <% subjects.forEach(subject => { %>
              <option value="<%= subject.subject_name %>" <%= subject_name === subject.subject_name ? 'selected' : '' %>><%= subject.subject_name %></option>
            <% }); %>
          </select>
        </div>
          
      <div class="form-group col-md-4">
        <label for="semester">semester:</label>
        <select id="semester" name="semester" class="form-control select2">
          <option value="">Select semester</option>
          <% semesters.forEach(semester => { %>
            <option value="<%= semester.semester %>" <%= semester === semester.semester ? 'selected' : '' %>><%= semester.semester %></option>
          <% }); %>
        </select>
      </div>
    </div>


      <button type="submit" class="btn btn-primary">Filter</button>
    </form>

    <!-- Display Timetables -->
    <% if ((program_name || program_level || venue_name || tutor_name || department_name || subject_name) && semesters ) { %> 
      <% if (timetables.length > 0) { %>
        <h1>ARUSHA TECHNICAL COLLEGE</h1>
        <h1>TIMETABLE</h1>
        <div class="table-container">
          <table class="table table-bordered table-striped">
            <thead>
              <tr>
                <th>TIME</th>
                <% 
                  // Extract unique days from the timetable
                  const uniqueDays = [...new Set(timetables.map(t => t.day))];
                  uniqueDays.forEach(day => { 
                %>
                  <th><%= day.toUpperCase() %></th>
                <% }); %>
              </tr>
            </thead>
            <tbody>
              <% 
                // Extract unique time slots
                const uniqueTimes = [...new Set(timetables.map(t => `${t.start_time} - ${t.end_time}`))];
                uniqueTimes.forEach(timeSlot => { 
              %>
                <tr>
                  <td><b><%= timeSlot %></b></td>
                  <% 
                    // Loop through each day and match data
                    uniqueDays.forEach(day => { 
                      const entry = timetables.find(t => `${t.start_time} - ${t.end_time}` === timeSlot && t.day === day);
                  %>
                    <td>
                      <% if (entry) { %>
                        <b>Venue:</b> <%= entry.venue_name %> (<%= entry.venue_type %>)<br>
                        <b>Subject:</b> <%= entry.subject_name %> (<%= entry.subject_code %>)<br>
                        <b>Tutor:</b> <%= entry.tutor_name %><br>
                        <b>Program:</b> <%= entry.program_name %> (<%= entry.program_level %>)<br>
                      <% } else { %>
                        <i>---</i>
                      <% } %>
                    </td>
                  <% }); %>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } else { %>
        <p class="text-center">No timetables found for the selected filters.</p>
      <% } %>
    <% } %>

    <!-- Download Button -->
    <div class="text-center mt-4">
      <a href="/download-timetable?program=<%= program_name %>&level=<%= program_level %>&venue=<%= venue_name %>&tutor=<%= tutor_name %>&department=<%= department_name %>" class="btn btn-primary">Download Timetables (CSV)</a>
      <a href="/download-timetable-pdf?program=<%= program_name %>&level=<%= program_level %>&venue=<%= venue_name %>&tutor=<%= tutor_name %>&department=<%= department_name %>" class="btn btn-secondary">Download Timetables (PDF)</a>
    </div>
  </div>

  <script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.0.7/dist/umd/popper.min.js"></script>
  <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/select2/4.0.13/js/select2.min.js"></script>
  <script>
    $(document).ready(function() {
      $('.select2').select2();
    });
  </script>
</body>
</html>
