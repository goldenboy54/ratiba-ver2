<%- include('partials/nav') %>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Manage Timetable</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
  <link href="https://cdn.jsdelivr.net/npm/@ttskch/select2-bootstrap4-theme@1.5.2/dist/select2-bootstrap4.min.css" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>

<div class="container py-5">
  <!-- Page Header -->
  <div class="text-center mb-5">
    <h1 class="display-5 fw-bold">🎛️ Mix Timetable</h1>
    <p class="lead text-muted">Optimize your timetable, resolve conflicts, and efficiently manage program schedules.</p>
  </div>

  <!-- Alert Messages -->
  <% if(error){ %>
    <div class="alert alert-danger shadow-sm" role="alert"><i class="fa fa-exclamation-circle me-2"></i> <%= error %></div>
  <% } %>
  <% if(success){ %>
    <div class="alert alert-success shadow-sm" role="alert"><i class="fa fa-check-circle me-2"></i> <%= success %></div>
  <% } %>

  <!-- Instructions Card -->
  <div class="card shadow-sm mb-4 border-primary">
    <div class="card-header bg-primary text-white">
      <i class="fa fa-info-circle me-2"></i> Instructions
    </div>
    <div class="card-body">
      <ul class="mb-0">
        <li>Select a <strong>Tutor</strong> or <strong>Subject</strong> to filter available slots (optional).</li>
        <li>Choose a <strong>Target Slot</strong> where you want to merge selected programs.</li>
        <li>Select one or more <strong>Programs to Mix</strong>. Click on the badges to remove programs before submitting.</li>
        <li>Click <strong>Mix Selected Programs</strong> to combine the selected programs into the target slot.</li>
        <li>This page helps manage timetable conflicts and optimize venue usage while ensuring schedule clarity.</li>
      </ul>
    </div>
  </div>

  <!-- Filters -->
  <form method="GET" class="row g-3 mb-5">
    <div class="col-md-6">
      <label class="form-label fw-semibold" for="tutorSelect">Tutor</label>
      <select id="tutorSelect" name="tutor" class="form-select select2" onchange="this.form.submit()">
        <option value="">--Select Tutor--</option>
        <% tutors.forEach(t => { %>
          <option value="<%= t.tutor_name %>" <%= filter.tutor_name===t.tutor_name?'selected':'' %>><%= t.tutor_name %></option>
        <% }) %>
      </select>
    </div>

    <div class="col-md-6">
      <label class="form-label fw-semibold" for="subjectSelect">Subject</label>
      <select id="subjectSelect" name="subject_code" class="form-select select2" onchange="this.form.submit()">
        <option value="">--Select Subject--</option>
        <% subjects.forEach(s => { %>
          <option value="<%= s.subject_code %>" <%= filter.subject_code===s.subject_code?'selected':'' %>><%= s.subject_name %> | <%= s.subject_code %></option>
        <% }) %>
      </select>
    </div>
  </form>

  <!-- Mixing Form Card -->
  <div class="card shadow-sm border-success mb-5">
    <div class="card-header bg-success text-white fw-bold"><i class="fa fa-layer-group me-2"></i> Mix Programs</div>
    <div class="card-body">
      <form method="POST" action="/manageTimetable/mix">
        <!-- Target Slot -->
        <div class="mb-4">
          <label class="form-label fw-semibold" for="targetSlot">Target Slot</label>
          <select id="targetSlot" name="targetSlotId" class="form-select" required>
            <option value="">--Select Slot--</option>
            <% slots.forEach(slot => { %>
              <option value="<%= slot.id %>" title=" <%= slot.program_name %> (<%= slot.program_code %> )|  <%= slot.subject_name %> (<%= slot.subject_code %> <%= slot.venue_type %>) |  <%= slot.day %> | <%= slot.start_time %>-<%= slot.end_time %> | <%= slot.venue_name %>">
                <%= slot.program_name %> (<%= slot.program_code %> )|  <%= slot.subject_name %> (<%= slot.subject_code %> <%= slot.venue_type %>) |  <%= slot.day %> | <%= slot.start_time %>-<%= slot.end_time %> | <%= slot.venue_name %>
              </option>
            <% }) %>
          </select>
          <div class="form-text">Choose the slot where the selected programs will be merged.</div>
        </div>

        <!-- Programs to Mix -->
        <div class="mb-4">
          <label class="form-label fw-semibold" for="programSelect">Programs to Mix</label>
          <select id="programSelect" class="form-select">
            <option value="">--Select Program--</option>
            <% programs.forEach(p => { %>
              <option value="<%= p.id %>" title="<%= p.program_name %> (<%= p.program_code %> ) | <%= p.subject_name %> (<%= p.subject_code %>  <%= p.venue_type %>)|  <%= p.day %> | <%= p.start_time %>-<%= p.end_time %>  <%= p.venue_name %>">
                <%= p.program_name %>(<%= p.program_code %> ) | <%= p.subject_name %> (<%= p.subject_code %>  <%= p.venue_type %>)|  <%= p.day %> | <%= p.start_time %>-<%= p.end_time %>  <%= p.venue_name %></option>
            <% }) %>
          </select>
          <div id="selectedProgramsList" class="mt-3 d-flex flex-wrap" aria-live="polite"></div>
          <div class="form-text">Click on badges to remove programs before submitting.</div>
        </div>

        <div id="hiddenInputs"></div>
        <button type="submit" class="btn btn-success w-100 fw-bold"><i class="fa fa-play me-2"></i> Mix Selected Programs</button>
      </form>
    </div>
  </div>
</div>

<!-- Scripts -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
<script>
  $(document).ready(function() {
    $('.select2').select2({
      theme: 'bootstrap-5',
      width: '100%',
      placeholder: "Select an option",
      allowClear: true
    });
  });

  // Program selection & badge creation
  const programSelect = document.getElementById('programSelect');
  const hiddenDiv = document.getElementById('hiddenInputs');
  const listDiv = document.getElementById('selectedProgramsList');
  let selectedPrograms = [];

  programSelect.addEventListener('change', () => {
    const val = programSelect.value;
    const text = programSelect.options[programSelect.selectedIndex].text;
    if (val && !selectedPrograms.includes(val)) {
      selectedPrograms.push(val);

      // Hidden input for POST
      const input = document.createElement('input');
      input.type = 'hidden';
      input.name = 'selectedProgramIds';
      input.value = val;
      input.id = 'hidden-' + val;
      hiddenDiv.appendChild(input);

      // Badge
      const badge = document.createElement('span');
      badge.className = 'badge bg-primary me-2 mb-2 p-2';
      badge.id = 'span-' + val;
      badge.textContent = text + ' ×';
      badge.style.cursor = 'pointer';
      badge.onclick = () => removeProgram(val);
      listDiv.appendChild(badge);
    }
    programSelect.selectedIndex = 0;
  });

  function removeProgram(id){
    selectedPrograms = selectedPrograms.filter(p => p !== id);
    document.getElementById('hidden-' + id)?.remove();
    document.getElementById('span-' + id)?.remove();
  }
</script>

<style>
  body {
    background: linear-gradient(to right, #f8f9fa, #e9ecef);
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
  }

  .card {
    border-radius: 1rem;
  }

  .form-label {
    font-weight: 500;
  }

  .badge {
    font-size: 0.9rem;
  }

  .select2-container--bootstrap-5 .select2-selection--single {
    height: calc(2.5rem + 2px);
    padding: 0.375rem 0.75rem;
  }

  button:focus, select:focus {
    box-shadow: 0 0 0 0.25rem rgba(25, 135, 84, 0.25);
  }

  @media (max-width: 768px) {
    #selectedProgramsList {
      flex-direction: column;
    }
  }
</style>



