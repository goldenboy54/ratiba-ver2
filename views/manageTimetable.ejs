<%- include('partials/nav') %>

<div class="container manage-timetable-container">
  <!-- Page Header -->
  <div class="page-header">
    <h1>🎛️ Mix Timetable</h1>
    <p class="lead">Optimize your timetable, resolve conflicts, and efficiently manage program schedules.</p>
  </div>

  <!-- Alert Messages -->
  <% if(error){ %>
    <div class="alert alert-danger" role="alert">
      <i class="fa fa-exclamation-circle"></i> <%= error %>
    </div>
  <% } %>
  <% if(success){ %>
    <div class="alert alert-success" role="alert">
      <i class="fa fa-check-circle"></i> <%= success %>
    </div>
  <% } %>

  <!-- Instructions Card -->
  <div class="card instructions-card">
    <div class="card-header">
      <i class="fa fa-info-circle"></i> Instructions
    </div>
    <div class="card-body">
      <ul>
        <li>Select a <strong>Tutor</strong> or <strong>Subject</strong> to filter available slots (optional).</li>
        <li>Choose a <strong>Target Slot</strong> where you want to merge selected programs.</li>
        <li>Select one or more <strong>Programs to Mix</strong>. Click on the badges to remove programs before submitting.</li>
        <li>Click <strong>Mix Selected Programs</strong> to combine the selected programs into the target slot.</li>
        <li>This page helps manage timetable conflicts and optimize venue usage while ensuring schedule clarity.</li>
      </ul>
    </div>
  </div>

  <!-- Filters -->
  <form method="GET" class="row g-3 filter-form">
    <div class="col-md-6">
      <label class="form-label" for="tutorSelect">Tutor</label>
      <select id="tutorSelect" name="tutor" class="form-select select2" onchange="this.form.submit()">
        <option value="">--Select Tutor--</option>
        <% tutors.forEach(t => { %>
          <option value="<%= t.tutor_name %>" <%= filter.tutor_name===t.tutor_name?'selected':'' %>>
            <%= t.tutor_name %>
          </option>
        <% }) %>
      </select>
    </div>

    <div class="col-md-6">
      <label class="form-label" for="subjectSelect">Subject</label>
      <select id="subjectSelect" name="subject_code" class="form-select select2" onchange="this.form.submit()">
        <option value="">--Select Subject--</option>
        <% subjects.forEach(s => { %>
          <option value="<%= s.subject_code %>" <%= filter.subject_code===s.subject_code?'selected':'' %>>
            <%= s.subject_name %> | <%= s.subject_code %>
          </option>
        <% }) %>
      </select>
    </div>
  </form>

  <!-- Mixing Form Card -->
  <div class="card mixing-card">
    <div class="card-header">
      <i class="fa fa-layer-group"></i> Mix Programs
    </div>
    <div class="card-body">
      <form method="POST" action="/manageTimetable/mix">
        <!-- Target Slot -->
        <div class="mb-4">
          <label class="form-label" for="targetSlot">Target Slot</label>
          <select id="targetSlot" name="targetSlotId" class="form-select select2" required>
            <option value="">--Select Slot--</option>
            <% slots.forEach(slot => { %>
              <option value="<%= slot.id %>" title="<%= slot.program_name %> (<%= slot.program_code %>) | <%= slot.subject_name %> (<%= slot.subject_code %> <%= slot.venue_type %>) | <%= slot.day %> | <%= slot.start_time %>-<%= slot.end_time %> | <%= slot.venue_name %>">
                <%= slot.program_name %> (<%= slot.program_code %>) | <%= slot.subject_name %> (<%= slot.subject_code %> <%= slot.venue_type %>) | <%= slot.day %> | <%= slot.start_time %>-<%= slot.end_time %> | <%= slot.venue_name %>
              </option>
            <% }) %>
          </select>
          <div class="form-text">Choose the slot where the selected programs will be merged.</div>
        </div>

        <!-- Programs to Mix -->
        <div class="mb-4">
          <label class="form-label" for="programSelect">Programs to Mix</label>
          <select id="programSelect" class="form-select select2">
            <option value="">--Select Program--</option>
            <% programs.forEach(p => { %>
              <option value="<%= p.id %>" title="<%= p.program_name %> (<%= p.program_code %>) | <%= p.subject_name %> (<%= p.subject_code %> <%= p.venue_type %>) | <%= p.day %> | <%= p.start_time %>-<%= p.end_time %> <%= p.venue_name %>">
                <%= p.program_name %> (<%= p.program_code %>) | <%= p.subject_name %> (<%= p.subject_code %> <%= p.venue_type %>) | <%= p.day %> | <%= p.start_time %>-<%= p.end_time %> <%= p.venue_name %>
              </option>
            <% }) %>
          </select>
          <div id="selectedProgramsList" class="selected-programs-list" aria-live="polite"></div>
          <div class="form-text">Click on badges to remove programs before submitting.</div>
        </div>

        <div id="hiddenInputs"></div>
        <button type="submit" class="btn btn-mix-programs">
          <i class="fa fa-play"></i> Mix Selected Programs
        </button>
      </form>
    </div>
  </div>
</div>

</main>
<%- include('partials/footer') %>
