<%- include('partials/nav') %>

<div class="work-reports-container">
  <!-- Header Section -->
  <div class="work-reports-header">
    <h1>
      <i class="fas fa-chart-bar"></i>
      Work Load Report
    </h1>
  </div>

  <!-- Filter Section -->
  <div class="filter-section">
    <h2>Filter Below To Customize Views</h2>
    
    <form method="get" action="/work_reports" class="filter-form">
      <div class="row">
        <!-- User Filter -->
        <div class="col-md-4 mb-3">
          <label for="user" class="form-label">
            <i class="fas fa-user"></i>
            User:
          </label>
          <select id="user" name="user" class="form-control select2" data-placeholder="Select user">
            <option value="">Select user</option>
            <% users.forEach(user => { %>
              <option value="<%= user.full_name %>" <%= user_name === user.full_name ? 'selected' : '' %>>
                <%= user.full_name %>
              </option>
            <% }); %>
          </select>
        </div>
        
        <!-- Program Name Filter -->
        <div class="col-md-4 mb-3">
          <label for="program_name" class="form-label">
            <i class="fas fa-graduation-cap"></i>
            Program Name:
          </label>
          <select id="program_name" name="program_name" class="form-control select2" data-placeholder="Select program">
            <option value="">Select program</option>
            <% pname.forEach(program => { %>
              <option value="<%= program.program_name %>" <%= program_name === program.program_name ? 'selected' : '' %>>
                <%= program.program_name %>
              </option>
            <% }); %>
          </select>
        </div>
        
        <!-- Mother Program Department Filter -->
        <div class="col-md-4 mb-3">
          <label for="category" class="form-label">
            <i class="fas fa-building"></i>
            Mother Program Department:
          </label>
          <select id="category" name="category" class="form-control select2" data-placeholder="Select program department">
            <option value="">Select program department</option>
            <% pcategory.forEach(program => { %>
              <option value="<%= program.category %>" <%= category === program.category ? 'selected' : '' %>>
                <%= program.category %>
              </option>
            <% }); %>
          </select>
        </div>
      </div>
      
      <div class="row">
        <!-- Level Filter -->
        <div class="col-md-4 mb-3">
          <label for="level" class="form-label">
            <i class="fas fa-layer-group"></i>
            Level:
          </label>
          <select id="level" name="level" class="form-control select2" data-placeholder="Select level">
            <option value="">Select level</option>
            <% plevel.forEach(program => { %>
              <option value="<%= program.level %>" <%= level === program.level ? 'selected' : '' %>>
                <%= program.level %>
              </option>
            <% }); %>
          </select>
        </div>
    
        <!-- Subject Name Filter -->
        <div class="col-md-4 mb-3">
          <label for="title" class="form-label">
            <i class="fas fa-book"></i>
            Subject Name:
          </label>
          <select id="title" name="title" class="form-control select2" data-placeholder="Select subject name">
            <option value="">Select subject name</option>
            <% sname.forEach(subject => { %>
              <option value="<%= subject.title %>" <%= title === subject.title ? 'selected' : '' %>>
                <%= subject.title %>
              </option>
            <% }); %>
          </select>
        </div>
        
        <!-- Mother Subject Department Filter -->
        <div class="col-md-4 mb-3">
          <label for="subject_department" class="form-label">
            <i class="fas fa-sitemap"></i>
            Mother Subject Department:
          </label>
          <select id="subject_department" name="subject_department" class="form-control select2" data-placeholder="Select subject department">
            <option value="">Select subject department</option>
            <% idara.forEach(department => { %>
              <option value="<%= department.subject_department %>" <%= subject_department === department.subject_department ? 'selected' : '' %>>
                <%= department.subject_department %>
              </option>
            <% }); %>
          </select>
        </div>
      </div>
      
      <div class="row">
        <!-- Semester Filter -->
        <div class="col-md-4 mb-3">
          <label for="semester" class="form-label">
            <i class="fas fa-calendar-alt"></i>
            Semester:
          </label>
          <select id="semester" name="semester" class="form-control select2" data-placeholder="Select semester">
            <option value="">Select semester</option>
            <% semesters.forEach(opt => { %>
              <option value="<%= opt.semester %>" <%= locals.semester === opt.semester ? 'selected' : '' %>>
                <%= opt.semester %>
              </option>
            <% }); %>
          </select>
        </div>
        
        <!-- Program Type Filter -->
        <div class="col-md-4 mb-3">
          <label for="program_type" class="form-label">
            <i class="fas fa-tag"></i>
            Program Type:
          </label>
          <select id="program_type" name="program_type" class="form-control select2" data-placeholder="Select type">
            <option value="">Select type</option>
            <% ptypes.forEach(type => { %>
              <option value="<%= type.program_type %>" <%= program_type === type.program_type ? 'selected' : '' %>>
                <%= type.program_type %>
              </option>
            <% }); %>
          </select>
        </div>
      </div>
      
      <div class="text-center">
        <button type="submit" class="filter-submit-btn">
          <i class="fas fa-filter"></i>
          Apply Filters
        </button>
        <a href="/work_reports" class="btn btn-secondary ms-2">
          <i class="fas fa-sync"></i> Reset
        </a>
      </div>
    </form>
  </div>

  <% if (locals.subjects && subjects.length > 0) { %>
    <!-- Check if any filters are applied -->
    <% if (user_name || semester || program_type || program_name || level || subject_department || title || category) { %>
      
      <!-- Report Header with Export Buttons -->
      <div class="report-header">
        <h2 class="report-title">
          <i class="fas fa-file-alt"></i>
          Work Load Report
        </h2>
        <div class="export-buttons">
          <button id="exportCSV" class="export-btn export-csv">
            <i class="fas fa-file-csv"></i>
            Export CSV
          </button>
          <button id="exportPDF" class="export-btn export-pdf">
            <i class="fas fa-file-pdf"></i>
            Export PDF
          </button>
          <button id="exportPrint" class="export-btn export-print">
            <i class="fas fa-print"></i>
            Print
          </button>
        </div>
      </div>

      <!-- Report Table -->
      <div class="report-table-wrapper">
        <table class="table table-bordered table-hover work-reports-table">
          <thead>
            <tr>
              <th>Tutor/Staff Information</th>
              <th>Total Hours Per Week</th>
              <th>Program Assigned</th>
            </tr>
          </thead>
          <tbody>
            <% subjects.forEach(subject => { %>
              <tr>
                <!-- Tutor Information -->
                <td data-label="Tutor/Staff Information">
                  <div class="tutor-info">
                    <div>
                      <span class="info-label">Name:</span>
                      <span class="info-value"><b><%= subject.full_name %></b></span>
                    </div>
                    <div>
                      <span class="info-label">Email:</span>
                      <span class="info-value"><%= subject.user_email %></span>
                    </div>
                    <div>
                      <span class="info-label">Mother Department:</span>
                      <span class="department-tag"><%= subject.user_department %></span>
                    </div>
                    <div>
                      <span class="info-label">Original Role:</span>
                      <span class="info-value"><%= subject.user_role %></span>
                    </div>
                    <div>
                      <span class="info-label">Status:</span>
                      <span class="status-badge <%= subject.user_status === 'active' ? 'status-active' : 'status-inactive' %>">
                        <%= subject.user_status %>
                      </span>
                    </div>
                  </div>
                </td>

                <!-- Workload Information -->
                <td data-label="Total Hours Per Week">
                  <div class="workload-info">
                    <div>
                      <span class="info-label">Subject Name:</span>
                      <span class="info-value"><%= subject.title %></span>
                    </div>
                    <div>
                      <span class="info-label">Subject Code:</span>
                      <span class="info-value"><%= subject.subject_code %></span>
                    </div>
                    <div class="total-hours">
                      <span class="total-hours-label">Total Hours Per Week</span>
                      <%= subject.total_hours_per_week %>
                    </div>
                  </div>
                </td>

                <!-- Program Information -->
                <td data-label="Program Assigned">
                  <div class="program-info">
                    <div>
                      <span class="info-label">Program Name:</span>
                      <span class="info-value"><%= subject.program_name %></span>
                    </div>
                    <div>
                      <span class="info-label">Program Code:</span>
                      <span class="info-value"><%= subject.program_code %></span>
                    </div>
                    <div>
                      <span class="info-label">Mother Program Department:</span>
                      <span class="info-value"><%= subject.category %></span>
                    </div>
                    <div>
                      <span class="info-label">Program Type:</span>
                      <span class="program-type-badge"><%= subject.program_type %></span>
                    </div>
                    <div>
                      <span class="info-label">Program Level:</span>
                      <span class="info-value"><%= subject.program_level %></span>
                    </div>
                    <div>
                      <span class="info-label">Program Capacity:</span>
                      <span class="info-value"><%= subject.program_capacity %></span>
                    </div>
                    <div>
                      <span class="info-label">Program Duration:</span>
                      <span class="info-value"><%= subject.program_duration %> yrs</span>
                    </div>
                  </div>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>

    <% } else { %>
      <!-- No Filters Applied Message -->
      <div class="no-filters-message">
        <i class="fas fa-info-circle"></i>
        <h3>No Filters Applied</h3>
        <p>Please select at least one filter above to view the work load report.</p>
      </div>
    <% } %>

  <% } else { %>
    <!-- Empty State -->
    <div class="empty-state">
      <i class="fas fa-inbox"></i>
      <h2>No Information Available</h2>
      <p>There are no work reports matching your criteria. Please adjust your filters and try again.</p>
    </div>
  <% } %>
</div>

<!-- Include html2pdf library for PDF export -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>

</main>
<%- include('partials/footer') %>
