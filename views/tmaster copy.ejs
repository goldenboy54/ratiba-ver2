<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Auto Generate timetable</title>
  <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/select2/4.0.13/css/select2.min.css" />

 
  
</head>
<body>
  <%- include('partials/nav') %>

  <div class="container mt-5">
    <div class="text-center mb-4">
      <div class="animated-graphic" title="Timetable autogenerating system">🕑</div> 
    </div> 

    <h2 class="text-center text-primary">AUTO GENERATION OF TIMETABLE</h2>
    
    
   
  
<br>
        <p class="text-primary text-center">ARUSHA TECHNICAL COLLEGE</p>
       
        <p class="text-success text-center">TIMETABLE GENERATION</p>
        <div class="table-container">
          <table class="table table-bordered table-striped">
            <thead>
              <tr>
                
               <form action="/tmaster/add" method="post">

                    <div class="form-group">
                         <label for="semester">SEMESTER:</label>
                         <select id="semester" name="semester" class="form-control select2" required>
                        
                              <option value="I">I</option>
                           <option value="II">II</option>    
                          
                         </select>
                       </div>
                      
                       
                     

                 <button type="submit" class="btn btn-primary">GENERATE</button>
               </form>
     
     
     
          
     
              </tr>
            </thead>
          

  <script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.0.7/dist/umd/popper.min.js"></script>
  <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/select2/4.0.13/js/select2.min.js"></script>
  <script>
    $(document).ready(function() {
      $('.select2').select2();
    });
  </script>
</body>
</html>
