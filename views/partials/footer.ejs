<script>
  $(document).ready(function() {
    // Initialize Select2 on all select elements with select2 class.
    // Skip elements a page-specific script already initialized (e.g. modal-scoped
    // selects needing dropdownParent, or custom matchers) so this stays a safe default,
    // not a clobber of more specific config.
    $('.select2').each(function() {
      var $el = $(this);
      if ($el.hasClass('select2-hidden-accessible')) return;
      $el.select2({
        theme: 'bootstrap-5',
        width: '100%',
        allowClear: true,
        placeholder: $el.data('placeholder') || $el.find('option[value=""]').first().text() || 'Select an option'
      });
    });
  });
</script>

