<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Timetable Management System</title>

  <!-- Bootstrap 5 CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
  <!-- Font Awesome Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"/>
  <!-- <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" /> -->

  <style>
    body {
      background: linear-gradient(to right, #e0eafc, #cfdef3);
      min-height: 100vh;
      display: flex;
      overflow-x: hidden;
      color: #333;
    }

    .table-container {
      overflow-x: auto; /* Enables horizontal scrolling if table overflows */
    }

    .key {
      font-weight: bold;
      color: #e91e63;
    }
    .slot {
      padding: 5px;
      margin: 5px 0;
      border-bottom: 1px solid rgba(0, 0, 0, 0.1);
    }
    .sidebar {
      min-width: 250px;
      max-width: 250px;
      background: linear-gradient(135deg, #6a11cb 0%, #2575fc 100%);
      color: white;
      padding: 20px 0;
      position: fixed;
      height: 100vh;
      overflow-y: auto;
      box-shadow: 2px 0 5px rgba(0,0,0,0.1);
    }

    .sidebar a {
      color: white;
      padding: 15px 25px;
      display: flex;
      align-items: center;
      font-size: 16px;
      text-decoration: none;
      transition: all 0.3s;
    }

    .sidebar a:hover {
      background-color: rgba(255, 255, 255, 0.2);
      text-decoration: none;
      border-left: 4px solid #fff;
    }

    .sidebar a i {
      margin-right: 10px;
      font-size: 18px;
    }

    .main-content {
      margin-left: 250px;
      padding: 20px;
      width: 100%;
      animation: fadeIn 1s ease-in;
    }

    .logo {
      text-align: center;
      margin-bottom: 30px;
    }

    .logo img {
      width: 120px;
      border-radius: 50%;
      border: 3px solid white;
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(20px); }
      to { opacity: 1; transform: translateY(0); }
    }

    /* Responsive Sidebar */
    @media (max-width: 768px) {
      .sidebar {
        position: relative;
        height: auto;
        width: 100%;
      }
      .main-content {
        margin-left: 0;
      }
    }

  </style>
</head>
<body>

  <div class="sidebar">
    <div class="logo">
      <a href="/viewtimetable"><img src="/images/atc.jpg" alt="ATC Logo" class="img-fluid" /></a>
    </div>

  <a href="/viewtimetable"><i class="fas fa-calendar-alt"></i> View Timetable</a>
        <!--  <a href="/searchtimetable"><i class="fas fa-calendar-alt"></i> View Timetable</a> -->

    <a href="/"><i class="fas fa-sign-out-alt"></i>Back</a>
  </div>

  <div class="main-content">


 