<!-- partials/nav.ejs -->
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>ATC Timetable Management System</title>

  <!-- Bootstrap 5 -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <!-- Font Awesome -->
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">

   <style>
    body {
      background: linear-gradient(to right, #e0eafc, #cfdef3);
      min-height: 100vh;
      display: flex;
      overflow-x: hidden;
      color: #333;
    }

    .table-container {
      overflow-x: auto; /* Enables horizontal scrolling if table overflows */
    }

    .key {
      font-weight: bold;
      color: #e91e63;
    }
    .slot {
      padding: 5px;
      margin: 5px 0;
      border-bottom: 1px solid rgba(0, 0, 0, 0.1);
    }
    .sidebar {
      min-width: 250px;
      max-width: 250px;
      background: linear-gradient(135deg, #6a11cb 0%, #2575fc 100%);
      color: white;
      padding: 20px 0;
      position: fixed;
      height: 100vh;
      overflow-y: auto;
      box-shadow: 2px 0 5px rgba(0,0,0,0.1);
    }

    .sidebar a {
      color: white;
      padding: 15px 25px;
      display: flex;
      align-items: center;
      font-size: 16px;
      text-decoration: none;
      transition: all 0.3s;
    }

    .sidebar a:hover {
      background-color: rgba(255, 255, 255, 0.2);
      text-decoration: none;
      border-left: 4px solid #fff;
    }

    .sidebar a i {
      margin-right: 10px;
      font-size: 18px;
    }

    .main-content {
      margin-left: 250px;
      padding: 20px;
      width: 100%;
      animation: fadeIn 1s ease-in;
    }

    .logo {
      text-align: center;
      margin-bottom: 30px;
    }

    .logo img {
      width: 120px;
      border-radius: 50%;
      border: 3px solid white;
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(20px); }
      to { opacity: 1; transform: translateY(0); }
    }

    /* Responsive Sidebar */
    @media (max-width: 768px) {
      .sidebar {
        position: relative;
        height: auto;
        width: 100%;
      }
      .main-content {
        margin-left: 0;
      }
    }

  </style>
  
  <style>
    body {
      background: linear-gradient(to right, #e0eafc, #cfdef3);
      color: #333;
      overflow-x: hidden;
      min-height: 100vh;
      display: flex;
    }

    .sidebar {
      width: 250px;
      background: linear-gradient(135deg, #2575fc 0%, #6a11cb 100%);
      color: white;
      position: fixed;
      height: 100vh;
      padding-top: 20px;
      box-shadow: 2px 0 6px rgba(0, 0, 0, 0.15);
    }

    .sidebar .logo {
      text-align: center;
      margin-bottom: 25px;
    }

    .sidebar .logo img {
      width: 100px;
      border-radius: 50%;
      border: 3px solid #fff;
      transition: transform 0.3s;
    }

    .sidebar .logo img:hover {
      transform: scale(1.08);
    }

    .sidebar a {
      display: flex;
      align-items: center;
      padding: 12px 25px;
      color: white;
      text-decoration: none;
      font-size: 15px;
      transition: all 0.3s ease;
    }

    .sidebar a:hover {
      background-color: rgba(255, 255, 255, 0.15);
      border-left: 4px solid #fff;
    }

    .sidebar a i {
      margin-right: 10px;
      font-size: 18px;
    }

    .main-content {
      margin-left: 250px;
      padding: 25px;
      width: 100%;
      animation: fadeIn 0.8s ease-in;
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(15px); }
      to { opacity: 1; transform: translateY(0); }
    }

    /* Responsive */
    @media (max-width: 768px) {
      .sidebar {
        position: relative;
        width: 100%;
        height: auto;
      }
      .main-content {
        margin-left: 0;
      }
    }
  </style>
</head>
<body>

<!-- Sidebar -->
<div class="sidebar">
  <div class="logo">
    <a href="/dashboard">
      <img src="/images/atc.jpg" alt="ATC Logo">
    </a>
    <h5 class="mt-2">ATC Timetable  (<script>document.write(`${((d=>d.getMonth()+1>=8?d.getFullYear():d.getFullYear()-1)(new Date()))}/${((d=>d.getMonth()+1>=8?d.getFullYear()+1:d.getFullYear())(new Date()))}`)</script>)</h5>
  </div>

  <% if (user && (user.role === "tmaster" || user.role === "admin")) { %>
    <a href="/timetables"><i class="fas fa-gear"></i> System Settings</a>
    <a href="/manageTimetable"><i class="fas fa-layer-group"></i> Mix Programmes</a>
    <a href="/manageTimetable/freed-slots"><i class="fas fa-clock"></i> Freed Slots</a>
    <a href="/fillFreedSlots"><i class="fas fa-plus-circle"></i> Assign Freed Slots</a>
    <a href="/tmaster"><i class="fas fa-robot"></i> Auto Generate Timetable <span class="text-warning small">(Recommended)</span></a>
    <a href="/manualtimetable"><i class="fas fa-table"></i> Manual Timetable <span class="text-warning small">(Time-Consuming)</span></a>
    <a href="/programs"><i class="fas fa-graduation-cap"></i> Programmes</a>
    <a href="/venues"><i class="fas fa-school"></i> Venues</a>
    <a href="/users"><i class="fas fa-user-tie"></i> Tutors</a>
    <a href="/registered_subjects"><i class="fas fa-book"></i> Modules</a>
    <a href="/work_reports"><i class="fas fa-clipboard-check"></i> Tutor Workload</a>
    <a href="/departments"><i class="fas fa-building"></i> Departments</a>
    <a href="/subjects"><i class="fas fa-book-open-reader"></i> Allocated Modules</a>
     <a href="/searchtimetable"><i class="fas fa-calendar-alt"></i> VIew timetable</a>
    <a href="/collision-report"><i class="fas fa-clipboard-check"></i> Collision Report</a>

  <% } %>

  <% if (user && user.role === "hod") { %>
    <!-- <a href="/programs"><i class="fas fa-graduation-cap"></i> Programmes</a> -->
    <a href="/subjects"><i class="fas fa-book-open"></i> Allocate Modules</a>
    <!-- <a href="/registered_subjects"><i class="fas fa-book"></i> Modules</a>
    <a href="/departments"><i class="fas fa-building-columns"></i> Departments</a>
    <a href="/venues"><i class="fas fa-school"></i> Venues</a>
    <a href="/users"><i class="fas fa-user-tie"></i> Tutors</a>
    <a href="/manageTimetable"><i class="fas fa-layer-group"></i> Mix Programmes</a>
    <a href="/manageTimetable/freed-slots"><i class="fas fa-clock"></i> Freed Slots</a>
    <a href="/fillFreedSlots"><i class="fas fa-plus-circle"></i> Assign Freed Slots</a> -->
     <a href="/searchtimetable"><i class="fas fa-calendar-alt"></i> VIew timetable</a>

  <% } %>

  <% if (user && ["student", "tutor", "hod", "tmaster"].includes(user.role)) { %>
    <!-- <a href="/searchtimetable"><i class="fas fa-calendar-alt"></i> View Timetable</a> -->
    <a href="/profile"><i class="fas fa-user-cog"></i> Profile Settings</a>
    <a href="/logout"><i class="fas fa-sign-out-alt"></i> Logout</a>
  <% } %>

  <% if (!user) { %>
    <a href="/"><i class="fas fa-arrow-left"></i> Back to Home</a>
  <% } %>
</div>

<!-- Main Content -->
<div class="main-content">
