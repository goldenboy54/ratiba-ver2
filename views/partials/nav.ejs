<!-- partials/nav.ejs -->
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>ATC Timetable Management System</title>

  <!-- Bootstrap 5 -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <!-- Font Awesome -->
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
  <!-- Select2 CSS -->
  <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
  
  <!-- Design Tokens & Utilities (load first) -->
  <link rel="stylesheet" href="/css/design-tokens.css">
  <!-- Navigation CSS -->
  <link rel="stylesheet" href="/css/nav.css">
  <!-- Dashboard CSS -->
  <link rel="stylesheet" href="/css/dashboard.css">
  <!-- User Profile CSS -->
  <link rel="stylesheet" href="/css/userProfile.css">
  <!-- Tmaster CSS -->
  <link rel="stylesheet" href="/css/tmaster.css">
  <!-- Manage Timetable CSS -->
  <link rel="stylesheet" href="/css/manageTimetable.css">
  <!-- View Timetable CSS -->
  <link rel="stylesheet" href="/css/viewtimetable.css">
  <!-- Subjects CSS -->
  <link rel="stylesheet" href="/css/subjects.css">
  <!-- Venues CSS -->
  <link rel="stylesheet" href="/css/venues.css">
  <!-- Departments CSS -->
  <link rel="stylesheet" href="/css/departments.css">
  <!-- Users CSS -->
  <link rel="stylesheet" href="/css/users.css">
  <!-- Registered Subjects CSS -->
  <link rel="stylesheet" href="/css/registered_subjects.css">
  <!-- Manual Timetable CSS -->
  <link rel="stylesheet" href="/css/manualTimetable.css">
  <!-- Timetables CSS -->
  <link rel="stylesheet" href="/css/timetables.css">
  <!-- Collision Report CSS -->
  <link rel="stylesheet" href="/css/collisionReport.css">
  <!-- Collision Monitor CSS -->
  <link rel="stylesheet" href="/css/collision_monitor.css">
  <!-- Work Reports CSS -->
  <link rel="stylesheet" href="/css/work_reports.css">
  <!-- Freed Slots CSS -->
  <link rel="stylesheet" href="/css/freedSlots.css">
  <!-- Venue Manager CSS -->
  <link rel="stylesheet" href="/css/venueManager.css">
  <!-- Responsive Enhancements (load last) -->
  <link rel="stylesheet" href="/css/responsive-enhancements.css">
</head>
<body>

<!-- Mobile Toggle Button -->
<button class="mobile-toggle" id="sidebarToggle" aria-label="Toggle Navigation">
  <i class="fas fa-bars"></i>
</button>

<!-- Sidebar -->
<nav class="sidebar" id="sidebar">
  <div class="logo">
    <a href="/dashboard">
      <img src="/images/atc.jpg" alt="ATC Logo">
    </a>
    <h5 class="mt-2">ATC Timetable  (<script>document.write(`${((d=>d.getMonth()+1>=8?d.getFullYear():d.getFullYear()-1)(new Date()))}/${((d=>d.getMonth()+1>=8?d.getFullYear()+1:d.getFullYear())(new Date()))}`)</script>)</h5>
  </div>

  <div class="nav-links">
    <% if (user && (user.role === "tmaster" || user.role === "admin")) { %>
      <a href="/timetables" class="nav-link-item"><i class="fas fa-gear"></i> <span>System Settings</span></a>
      <a href="/manageTimetable" class="nav-link-item"><i class="fas fa-layer-group"></i> <span>Mix Programmes</span></a>
      <a href="/manageTimetable/freed-slots" class="nav-link-item"><i class="fas fa-clock"></i> <span>Freed Slots</span></a>
      <a href="/fillFreedSlots" class="nav-link-item"><i class="fas fa-plus-circle"></i> <span>Assign Freed Slots</span></a>
      <a href="/tmaster" class="nav-link-item">
        <i class="fas fa-robot"></i> 
        <span>Auto Generate <small class="badge-recommended">Recommended</small></span>
      </a>
      <a href="/manualtimetable" class="nav-link-item">
        <i class="fas fa-table"></i> 
        <span>Manual Timetable <small class="badge-warning">Slow</small></span>
      </a>
      <a href="/programs" class="nav-link-item"><i class="fas fa-graduation-cap"></i> <span>Programmes</span></a>
      <a href="/venues" class="nav-link-item"><i class="fas fa-school"></i> <span>Venues</span></a>
      <a href="/venueManager" class="nav-link-item"><i class="fas fa-building"></i> <span>Venue Manager</span></a>
      <a href="/users" class="nav-link-item"><i class="fas fa-user-tie"></i> <span>Tutors</span></a>
      <a href="/registered_subjects" class="nav-link-item"><i class="fas fa-book"></i> <span>Modules</span></a>
      <a href="/work_reports" class="nav-link-item"><i class="fas fa-clipboard-check"></i> <span>Tutor Workload</span></a>
      <a href="/departments" class="nav-link-item"><i class="fas fa-building"></i> <span>Departments</span></a>
      <a href="/subjects" class="nav-link-item"><i class="fas fa-book-open-reader"></i> <span>Allocated Modules</span></a>
      <a href="/searchtimetable" class="nav-link-item"><i class="fas fa-calendar-alt"></i> <span>View Timetable</span></a>
      <a href="/collision-report" class="nav-link-item"><i class="fas fa-clipboard-check"></i> <span>Collision Report</span></a>
    <% } %>

    <% if (user && user.role === "hod") { %>
      <a href="/subjects" class="nav-link-item"><i class="fas fa-book-open"></i> <span>Allocate Modules</span></a>
      <a href="/searchtimetable" class="nav-link-item"><i class="fas fa-calendar-alt"></i> <span>View Timetable</span></a>
    <% } %>

    <% if (user && ["student", "tutor", "hod", "tmaster"].includes(user.role)) { %>
      <div class="nav-divider"></div>
      <a href="/profile" class="nav-link-item"><i class="fas fa-user-cog"></i> <span>Profile Settings</span></a>
      <a href="/logout" class="nav-link-item logout-link"><i class="fas fa-sign-out-alt"></i> <span>Logout</span></a>
    <% } %>

    <% if (!user) { %>
      <a href="/viewtimetable" class="nav-link-item"><i class="fas fa-calendar-alt"></i> <span>View Timetable by program name</span></a>
      <a href="/timetable/by-program-code" class="nav-link-item"><i class="fas fa-calendar-alt"></i> <span>View Timetable by program code</span></a>
      <a href="/" class="nav-link-item"><i class="fas fa-arrow-left"></i> <span>Back to Home</span></a>
    <% } %>
  </div>
</nav>

<!-- Overlay for mobile -->
<div class="sidebar-overlay" id="sidebarOverlay"></div>

<!-- Main Content -->
<main class="main-content" id="mainContent">
  <!-- Page content will be inserted here by individual pages -->
