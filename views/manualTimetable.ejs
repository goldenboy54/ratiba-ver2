<%- include('partials/nav') %>

<div class="container manual-timetable-container">

  <!-- Page Header -->
  <div class="page-header-manual">
    <div class="header-icon">🕒</div>
    <h3>Manual Timetable Generation</h3>
    <p class="subtitle">Assign timetable entries manually after filtering above.</p>
  </div>

  <!-- Alert Messages -->
  <% if (error) { %>
    <div class="alert-manual alert-danger">
      <i class="bi bi-exclamation-triangle-fill"></i>
      <span><%= error %></span>
    </div>
  <% } %>

  <% if (success) { %>
    <div class="alert-manual alert-success">
      <i class="bi bi-check-circle-fill"></i>
      <span><%= success %></span>
    </div>
  <% } %>

  <!-- Logs Box -->
  <% if (logs && logs.length > 0) { %>
    <div class="logs-box">
      <ul>
        <% logs.forEach(log => { %>
          <li>
            <i class="bi bi-chevron-right"></i>
            <span><%= log %></span>
          </li>
        <% }) %>
      </ul>
    </div>
  <% } %>

  <!-- Filter Form Section -->
  <div class="form-section-manual">
    <div class="section-title">
      <i class="bi bi-funnel-fill"></i>
      <span>Filter Options</span>
    </div>

    <form method="get" action="/manualTimetable">
      <div class="row g-3">

        <div class="col-md-4">
          <label for="tutor_select" class="form-label">
            <i class="bi bi-person-badge"></i>
            Tutor
          </label>
          <select 
            name="tutor" 
            id="tutor_select" 
            class="form-select select2" 
            required
          >
            <option value="">Select Tutor</option>
            <% tutors.forEach(tutor => { %>
              <option 
                value="<%= tutor.full_name %>" 
                <%= tutor_name === tutor.full_name ? 'selected' : '' %>
              >
                <%= tutor.full_name %>
              </option>
            <% }) %>
          </select>
        </div>

        <div class="col-md-4">
          <label for="semester_select" class="form-label">
            <i class="bi bi-layers"></i>
            Semester
          </label>
          <select 
            name="semester" 
            id="semester_select" 
            class="form-select select2" 
            required
          >
            <option value="">Select Semester</option>
            <% semesters.forEach(sem => { %>
              <option 
                value="<%= sem.semester %>" 
                <%= semester === sem.semester ? 'selected' : '' %>
              >
                <%= sem.semester %>
              </option>
            <% }) %>
          </select>
        </div>

        <div class="col-md-4">
          <label for="program_type_select" class="form-label">
            <i class="bi bi-diagram-3"></i>
            Program Type
          </label>
          <select 
            name="program_type" 
            id="program_type_select" 
            class="form-select select2" 
            required
          >
            <option value="">Select Type</option>
            <% ptypes.forEach(type => { %>
              <option 
                value="<%= type.program_type %>" 
                <%= program_type === type.program_type ? 'selected' : '' %>
              >
                <%= type.program_type %>
              </option>
            <% }) %>
          </select>
        </div>

      </div>

      <button type="submit" class="btn-filter">
        <i class="bi bi-search"></i>
        Filter Timetable Data
      </button>
    </form>
  </div>

  <!-- Assign Form Section -->
  <% if (tutor_name && timetables.length > 0) { %>
    <div class="form-section-manual">
      <div class="section-title">
        <i class="bi bi-calendar-plus-fill"></i>
        <span>Assign New Timetable Slot</span>
      </div>

      <form action="/manualTimetable/add" method="post">

        <!-- Carry the active filter forward so the page can re-show this same
             filtered view after the assignment succeeds, instead of resetting it -->
        <input type="hidden" name="tutor_name" value="<%= tutor_name %>" />
        <input type="hidden" name="semester" value="<%= semester %>" />
        <input type="hidden" name="program_type" value="<%= program_type %>" />

        <div class="row g-3">

          <div class="col-md-3">
            <label for="day" class="form-label">
              <i class="bi bi-calendar-week"></i>
              Day
            </label>
            <input 
              type="text" 
              id="day" 
              name="day" 
              class="form-control" 
              readonly 
              placeholder="Auto-filled after slot selection"
            />
          </div>

          <div class="col-md-4">
            <label for="venueSelect" class="form-label">
              <i class="bi bi-house-door"></i>
              Venue
            </label>
            <select 
              id="venueSelect" 
              name="venue_id" 
              class="form-select select2" 
              required
            >
              <option value="">Select Venue</option>
              <% venues.forEach(v => { %>
                <option value="<%= v.venue_id %>">
                  <%= v.venue_name %> | Cap: <%= v.capacity %> | Type: <%= v.department %>
                </option>
              <% }) %>
            </select>
          </div>

          <div class="col-md-5">
            <label for="slotSelect" class="form-label">
              <i class="bi bi-clock-history"></i>
              Slot
            </label>
            <select 
              id="slotSelect" 
              name="slot" 
              class="form-select select2" 
              required 
              disabled
            >
              <option>Select Venue First</option>
            </select>
          </div>

          <div class="col-12">
            <label for="subject_select" class="form-label">
              <i class="bi bi-book"></i>
              Subject
            </label>
            <select 
              name="subject_ids[]" 
              id="subject_select" 
              class="form-select select2" 
              multiple 
              required
            >
              <% timetables.forEach(tt => { %>
                <option value="<%= tt.subject_id %>">
                  <%= tt.subject_name %> - (<%= tt.subject_code %>) | 
                  Tutor: <%= tt.tutor_name %> | 
                  Prog: <%= tt.program_name %> <%= tt.program_code %> <%= tt.program_type %>
                </option>
              <% }) %>
            </select>
            <small class="text-muted">
              ⚠️ Select only one subject at a time.
            </small>
          </div>

        </div>

        <div class="form-actions">
          <button type="submit" id="assign-btn" class="btn-assign">
            <i class="bi bi-plus-circle"></i>
            Assign to Timetable
          </button>
        </div>

      </form>
    </div>
  <% } %>

  <!-- Hidden slots data for JavaScript -->
  <script type="application/json" id="slotsData">
    <%- JSON.stringify(slots) %>
  </script>

</div>

</main>
<%- include('partials/footer') %>
