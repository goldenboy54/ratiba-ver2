  <script>
document.addEventListener("DOMContentLoaded", function () {
  const timeSlots = {
    "07:30": "08:15",
    "08:15": "09:00",
    "09:05": "09:50",
    "09:50": "10:35",

    // tea break 10:35 - 11:00  (break haitakuwa option)

    "11:00": "11:45",
    "11:45": "12:30",

    // lunch break 12:30 - 13:15 (break haitakuwa option)

    "13:15": "14:00",
    "14:00": "14:45",
    "14:50": "15:35",
    "15:35": "16:20",
    "16:25": "17:10",
    "17:10": "17:55",
    "18:00": "18:45",
    "18:45": "19:30",
    "19:35": "20:20", 
    "20:20": "21:05",
    "21:10": "21:55",
    "21:55": "22:40",
  };

  document.querySelectorAll('.modal').forEach(modal => {
    const startInput = modal.querySelector("#start_time");
    const endInput = modal.querySelector("#end_time");

    if (!startInput || !endInput) return;

    startInput.addEventListener("change", () => {
      const selected = startInput.value.substring(0,5); // take HH:MM only
      if (timeSlots[selected]) {
        endInput.value = timeSlots[selected];
      }
    });
  });
});
</script>

