
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="ie=edge" />
    <title>Home - ATC TMS</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/home.css">
    
  </head>
  <body>
    <div class="d-flex flex-column min-vh-100">
      <!-- Navigation -->
      <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container-fluid">
          <a class="navbar-brand d-flex align-items-center" href="/">
            <img src="/images/atc.jpg" alt="ATC" width="40" height="40" class="rounded-circle me-2">
            <span>ATC TMS</span>
          </a>
          <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
            <span class="navbar-toggler-icon"></span>
          </button>
          <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav ms-auto">
              <li class="nav-item">
                <a class="nav-link" href="/login"><i class="fas fa-sign-in-alt me-1"></i> Login</a>
              </li>
              <li class="nav-item">
                <a class="nav-link" href="/viewtimetable"><i class="fas fa-calendar-alt me-1"></i> View Timetable</a>
              </li>
            </ul>
          </div>
        </div>
      </nav>

      <!-- Hero Section -->
      <header class="bg-white shadow-sm">
        <div class="container py-5">
          <div class="row justify-content-center">
            <div class="col-lg-10">
              <div class="card border-primary shadow-lg">
                <div class="card-header bg-primary text-white">
                  <h2 class="mb-0 text-uppercase"><i class="fas fa-calendar-alt me-2"></i>Access Your Timetable</h2>
                </div>
                <div class="card-body p-4">
                  <p class="text-muted mb-2">
                    <strong class="text-primary">Students:</strong> view your class schedule by program name or program code.
                  </p>
                  <p class="text-muted mb-3">
                    <strong class="text-primary">Tutors:</strong> view your teaching schedule by searching your full name.
                  </p>
                  <div class="d-flex flex-wrap justify-content-center gap-2">
                    <a href="/viewtimetable" class="btn btn-primary btn-sm">
                      <i class="fas fa-calendar-alt me-1"></i>By Program Name
                    </a>
                    <a href="/timetable/by-program-code" class="btn btn-outline-primary btn-sm">
                      <i class="fas fa-calendar-alt me-1"></i>By Program Code
                    </a>
                    <a href="/searchtimetable" class="btn btn-outline-primary btn-sm">
                      <i class="fas fa-user me-1"></i>By Tutor Name
                    </a>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </header>
      
      <main class="flex-fill py-5">
        <div class="container">
          <div class="row">
            <div class="col-12 text-center">
              <h3 class="text-white mb-4">Welcome to ATC Timetable Management System</h3>
              <p class="text-white-50">Access your timetables and manage your academic schedule efficiently.</p>
            </div>
          </div>
        </div>
      </main>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
