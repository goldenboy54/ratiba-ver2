<%- include('partials/nav') %>

<div class="container-fluid py-4">
  <div class="departments-header">
    <h1><i class="fas fa-building"></i> Departments Management</h1>
    <a href="/departments/form" class="btn btn-primary mb-3">
      <i class="fas fa-plus"></i> Add Department
    </a>
  </div>

  <!-- Display departments -->
  <% if (locals.ViewDepartments) { %>
    <!-- Filter Form -->
    <form method="get" action="/departments" class="filter-section">
      <div class="row">
        <div class="col-md-3 mb-3">
          <label for="department_name" class="form-label">Department Name:</label>
          <select id="department_name" name="department_name" class="form-select select2">
              <option value="">department_name</option>
              <% dname.forEach(department_name => { %>
                <option value="<%= department_name.department_name %>" <%= department_name === department_name.department_name ? 'selected' : '' %>><%= department_name.department_name %></option>
              <% }); %>
            </select>
        </div>

        <div class="col-md-3 mb-3">
          <label for="department_code" class="form-label">Department Code:</label>
          <select id="department_code" name="department_code" class="form-select select2">
              <option value="">department_code</option>
              <% dcode.forEach(department_code => { %>
                <option value="<%= department_code.department_code %>" <%= department_code === department_code.department_code ? 'selected' : '' %>><%= department_code.department_code %></option>
              <% }); %>
            </select>
        </div>

        <div class="col-md-3 mb-3">
          <label for="hod_name" class="form-label">HOD Name:</label>
          <select id="hod_name" name="hod_name" class="form-select select2">
              <option value="">hod_name</option>
              <% dhname.forEach(hod_name => { %>
                <option value="<%= hod_name.hod_name %>" <%= hod_name === hod_name.hod_name ? 'selected' : '' %>><%= hod_name.hod_name %></option>
              <% }); %>
            </select>
        </div>

        <div class="col-md-3 mb-3">
          <label for="hod_email" class="form-label">HOD Email:</label>
          <select id="hod_email" name="hod_email" class="form-select select2">
              <option value="">hod_email</option>
              <% dhemail.forEach(hod_email => { %>
                <option value="<%= hod_email.hod_email %>" <%= hod_email === hod_email.hod_email ? 'selected' : '' %>><%= hod_email.hod_email %></option>
              <% }); %>
            </select>
        </div>
      </div>

      <div class="text-center">
        <button type="submit" class="btn btn-primary">
          <i class="fas fa-filter"></i> Filter
        </button>
      </div>
    </form>

    <!-- Departments Table -->
    <div class="table-section">
      <h2>Department List</h2>
      <% if (ViewDepartments.length > 0) { %>
        <table class="table table-bordered table-hover">
          <thead>
            <tr>
              <th>Department Name</th>
              <th>Department Code</th>
              <th>HOD Name</th>
              <th>HOD Email</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
          <% ViewDepartments.forEach(department => { %>
            <tr>
              <td><b><%= department.department_name %></b></td>
              <td><%= department.department_code %></td>
              <td><%= department.hod_name %></td>
              <td><%= department.hod_email %></td>
              <td>
                <!-- Edit Button -->
                <button type="button" class="btn btn-warning btn-sm fixed-size-btn" data-bs-toggle="modal" data-bs-target="#updateModal<%= department.department_id %>">
                  <i class="fas fa-edit"></i> Edit
                </button>
                <!-- Delete Button -->
                <a href="/departments/delete/<%= department.department_id %>" class="btn btn-danger btn-sm fixed-size-btn" onclick="return confirm('Are you sure you want to delete this department?');">
                  <i class="fas fa-trash"></i> Delete
                </a>
              </td>
            </tr>

            <!-- Update Modal -->
            <div class="modal fade" id="updateModal<%= department.department_id %>" tabindex="-1" aria-labelledby="updateModalLabel<%= department.department_id %>" aria-hidden="true">
              <div class="modal-dialog">
                <div class="modal-content">
                  <div class="modal-header">
                    <h5 class="modal-title" id="updateModalLabel<%= department.department_id %>">Update Department</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                  </div>
                  <div class="modal-body">
                    <form action="/departments/edit/<%= department.department_id %>" method="post">
                      <div class="mb-3">
                        <label for="department_name" class="form-label text-info">Department Name:</label>
                        <input type="text" id="department_name" name="department_name" class="form-control" value="<%= department.department_name %>" required>
                      </div>

                      <div class="mb-3">
                        <label for="department_code" class="form-label text-info">Department Code:</label>
                        <input type="text" id="department_code" name="department_code" class="form-control" value="<%= department.department_code %>" required>
                      </div>

                      <div class="mb-3">
                        <label for="hod_name" class="form-label text-info">HOD Name:</label>
                        <input type="text" id="hod_name" name="hod_name" class="form-control" value="<%= department.hod_name %>" required>
                      </div>

                      <div class="mb-3">
                        <label for="hod_email" class="form-label text-info">HOD Email:</label>
                        <input type="email" id="hod_email" name="hod_email" class="form-control" value="<%= department.hod_email %>" required>
                      </div>

                      <button type="submit" class="btn btn-success">
                        <i class="fas fa-save"></i> Submit Changes
                      </button>
                    </form>
                  </div>
                </div>
              </div>
            </div>
          <% }); %>
          </tbody>
        </table>
      <% } else { %>
        <div class="empty-state">
          <i class="fas fa-inbox"></i>
          <p>No departments found matching your criteria.</p>
        </div>
      <% } %>
    </div>
  <% } else { %>

    <!-- Form Section -->
    <div class="form-section">
      <!-- Upload Form -->
      <h3><i class="fas fa-upload"></i> Upload CSV/Excel File</h3>
      <form action="/departments/uploads" method="post" enctype="multipart/form-data">
        <div class="mb-3">
          <label for="file" class="form-label">Choose CSV/Excel File:</label>
          <input type="file" name="file" class="form-control" required>
        </div>
        <button type="submit" class="btn btn-success">
          <i class="fas fa-cloud-upload-alt"></i> Upload
        </button>
      </form>

      <hr>

      <!-- Add Department Form -->
      <h2><i class="fas fa-plus-circle"></i> Add Department</h2>
      <form action="/departments" method="post">
        <div class="row">
          <div class="col-md-6 mb-3">
            <label for="department_name" class="form-label">Department Name:</label>
            <input type="text" id="department_name" name="department_name" class="form-control" required>
          </div>

          <div class="col-md-6 mb-3">
            <label for="department_code" class="form-label">Department Code:</label>
            <input type="text" id="department_code" name="department_code" class="form-control" required>
          </div>
        </div>

        <div class="row">
          <div class="col-md-6 mb-3">
            <label for="hod_name" class="form-label">HOD Name:</label>
            <input type="text" id="hod_name" name="hod_name" class="form-control" required>
          </div>

          <div class="col-md-6 mb-3">
            <label for="hod_email" class="form-label">HOD Email:</label>
            <input type="email" id="hod_email" name="hod_email" class="form-control" required>
          </div>
        </div>

        <button type="submit" name="submit" class="btn btn-success">
          <i class="fas fa-save"></i> Add Department
        </button>
      </form>
    </div>
  <% } %>
</div>

</main>

<script src="/js/departments.js"></script>

<%- include('partials/footer') %>

















