<%- include('partials/nav') %>

<div class="collision-monitor-container">
  <!-- Header Section -->
  <div class="collision-monitor-header">
    <h1>
      <i class="fas fa-shield-alt"></i>
      Collision Monitor
    </h1>
    <p class="description">
      Run the collision monitor to detect and resolve timetable conflicts. 
      View comprehensive information on relocated, skipped, failed, exchanged slots and collision details.
    </p>
  </div>

  <!-- Run Button -->
  <button id="runBtn" class="run-monitor-btn">
    <i class="fas fa-play-circle"></i>
    Run Collision Monitor
  </button>

  <!-- Status Display -->
  <div id="status" class="status-display"></div>

  <!-- Dynamic Results Container -->
  <div id="results" class="results-container"></div>

  <!-- Exchanged / Swapped Slots Section -->
  <div class="results-section">
    <h5>
      <i class="fas fa-exchange-alt"></i>
      Exchanged / Swapped Slots
    </h5>
    <div class="table-wrapper">
      <table class="table table-striped table-bordered table-hover table-info collision-monitor-table">
        <thead>
          <tr>
            <th>Slot ID</th>
            <th>Tutor</th>
            <th>Program(s)</th>
            <th>Subject</th>
            <th>From Venue</th>
            <th>From Day</th>
            <th>From Time</th>
            <th>To Day</th>
            <th>To Time</th>
            <th>Consecutive</th>
          </tr>
        </thead>
        <tbody id="exchangeBody">
          <tr>
            <td colspan="10" class="no-data">Run monitor to see exchanged slots</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Collision Details Section -->
  <div class="results-section">
    <h5>
      <i class="fas fa-exclamation-circle"></i>
      Collision Details
    </h5>
    <div class="table-wrapper">
      <table class="table table-striped table-bordered table-hover table-info collision-monitor-table">
        <thead>
          <tr>
            <th>Slot 1 ID</th>
            <th>Tutor 1</th>
            <th>Program 1</th>
            <th>Subject 1</th>
            <th>Slot 2 ID</th>
            <th>Tutor 2</th>
            <th>Program 2</th>
            <th>Subject 2</th>
            <th>Venue</th>
            <th>Day</th>
          </tr>
        </thead>
        <tbody id="collisionBody">
          <tr>
            <td colspan="10" class="no-data">Run monitor to see collision details</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</div>

</main>
<%- include('partials/footer') %>
