<%- include('layout') %>
<%- include('partials/nav') %>

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Timetables Management</title>
  <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
  <link rel="stylesheet" href="../public/css/styles.css">
  <style>
    .table-container {
      overflow-x: auto; /* Ensures horizontal scrolling if table overflows */
    }
    .animated-graphic {
      font-size: 3rem; /* Adjust as needed */
    }
    /* Responsive adjustments */
    @media (max-width: 768px) {
      .animated-graphic {
        font-size: 2rem;
      }
      .btn-custom {
        font-size: 0.9rem;
      }
      .fixed-size-btn {
        font-size: 0.8rem;
      }
    }
    @media (max-width: 576px) {
      .animated-graphic {
        font-size: 1.5rem;
      }
    }
  </style>
</head>
<body>
  <div class="container mt-5">
    <div class="animated-graphic" title="Timetable autogenerating system">🕑</div> 

    <h2 class="text-center text-primary">FILTER BELOW AND   <h1>EDIT TIMETABLE DATA HERE</h1>
    </h2>

    <!-- Search Filter Form -->
    <form action="/timetables" method="GET" class="mb-3">
      <div class="form-row">
        <div class="form-group col-md-4">
          <label for="program">Program:</label>
          <select id="program" name="program" class="form-control select2">
            <option value="">Select Program</option>
            <% programs.forEach(program => { %>
              <option value="<%= program.program_name %>" <%= program_name === program.program_name ? 'selected' : '' %>><%= program.program_name %></option>
            <% }); %>
          </select>
        </div>

        <div class="form-group col-md-4">
          <label for="level">Level:</label>
          <select id="level" name="level" class="form-control select2">
            <option value="">Select Level</option>
            <% levels.forEach(level => { %>
              <option value="<%= level.program_level %>" <%= program_level === level.program_level ? 'selected' : '' %>><%= level.program_level %></option>
            <% }); %>
          </select>
        </div>

        
        <div class="form-group col-md-4">
          <label for="program_type">program_type:</label>
          <select id="program_type" name="program_type" class="form-control select2">
            <option value="">Select type</option>
            <% ptypes.forEach(type => { %>
              <option value="<%= type.program_type %>" <%= program_type === type.program_type ? 'selected' : '' %>><%= type.program_type %></option>
            <% }); %>
          </select>
        </div>

        <div class="form-group col-md-4">
          <label for="venue">Venue:</label>
          <select id="venue" name="venue" class="form-control select2">
            <option value="">Select Venue</option>
            <% venues.forEach(venue => { %>
              <option value="<%= venue.venue_name %>" <%= venue_name === venue.venue_name ? 'selected' : '' %>><%= venue.venue_name %></option>
            <% }); %>
          </select>
        </div>

        <div class="form-group col-md-4">
          <label for="tutor">Tutor:</label>
          <select id="tutor" name="tutor" class="form-control select2">
            <option value="">Select Tutor</option>
            <% tutors.forEach(tutor => { %>
              <option value="<%= tutor.tutor_name %>" <%= tutor_name === tutor.tutor_name ? 'selected' : '' %>><%= tutor.tutor_name %></option>
            <% }); %>
          </select>
        </div>

        <div class="form-group col-md-4">
          <label for="department">Department:</label>
          <select id="department" name="department" class="form-control select2">
            <option value="">Select Department</option>
            <% departments.forEach(department => { %>
              <option value="<%= department.department_name %>" <%= department_name === department.department_name ? 'selected' : '' %>><%= department.department_name %></option>
            <% }); %>
          </select>
        </div>

        <div class="form-group col-md-4">
          <label for="subject">Subject:</label>
          <select id="subject" name="subject" class="form-control select2">
            <option value="">Select Subject</option>
            <% subjects.forEach(subject => { %>
              <option value="<%= subject.subject_name %>" <%= subject_name === subject.subject_name ? 'selected' : '' %>><%= subject.subject_name %></option>
            <% }); %>
          </select>
        </div>
      

      
      <div class="form-group col-md-4">
        <label for="semester">semester:</label>
        <select id="semester" name="semester" class="form-control select2">
          <option value="">Select semester</option>
          <% semesters.forEach(semester => { %>
            <option value="<%= semester.semester %>" <%= semester === semester.semester ? 'selected' : '' %>><%= semester.semester %></option>
          <% }); %>
        </select>
      </div>
    </div>

      <button type="submit" class="btn btn-primary">Filter</button>
    </form>

    <!-- Display timetables -->
    <% if (program_name || program_level || venue_name || tutor_name || department_name || subject_name) { %>
      <% if (timetables.length > 0) { %>

        <div class="table-container">
          <table class="table table-bordered table-striped">
            <thead>
              <tr>
                <th>DAY</th>
                <th>TIME</th>
                <th>VENUE</th>
                <th>SUBJECT</th>
                <th>TUTOR</th>  
                <th>PROGRAM</th>
                <th>ACTION</th>

              </tr>
            </thead>
            <tbody>
              <% timetables.forEach(timetable => { %>
                <tr>
                  <td>
                    <%= timetable.day %> <br>
                  
                  </td>


                  <td>
                    <b><%= timetable.start_time %> - <%= timetable.end_time %></b>
                  </td>

                  <td>
                venue name  <b><%= timetable.venue_name %></b> <br>
                venue type  <%= timetable.venue_type %><br>
                venue location <%= timetable.venue_location %><br>
                venue status  <%= timetable.venue_status %>
                venue capacity  <%= timetable.venue_capacity %> students

                  </td>


                  <td>
                   subject name  <b> <%= timetable.subject_name %> </b> <br>
                   subject code  <%= timetable.subject_code %><br>
                  subject credit <%= timetable.subject_credit %><br>
                   original department for subject  <%= timetable.department_name %><br>

                  </td>

                  <td>
                  tutor name <b> <%= timetable.tutor_name %> </b><br> 
              
                  </td>

                  
                  <td>
                    
                  program name  <b><%= timetable.program_name %></b><br> 
                  program level   <%= timetable.program_level %><br>
                  program type <%= timetable.program_type %><br>
                  program capacity <%= timetable.program_capacity %> students<br>
                  program duration <%= timetable.year %> yrs <br>


                    
                  </td>
                  <td>
                    <!-- Edit Button -->
                    <button title="Option to edit if there is any case" type="button" class="btn btn-warning btn-sm fixed-size-btn" data-toggle="modal" data-target="#updateModal<%= timetable.id %>">EDIT</button>
                  </td>
                </tr>

                <!-- Update Modal -->
                <div class="modal fade" id="updateModal<%= timetable.id %>" tabindex="-1" role="dialog" aria-labelledby="updateModalLabel<%= timetable.id %>" aria-hidden="true">
                  <div class="modal-dialog" role="document">
                    <div class="modal-content">
                      <div class="modal-header">
                        <h5 class="modal-title" id="updateModalLabel<%= timetable.id %>">Update Timetable</h5>
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                          <span aria-hidden="true">&times;</span>
                        </button>
                      </div>
                      <div class="modal-body">
                        <form action="/timetables/edit/<%= timetable.id %>" method="post">
                          <div class="form-group">
                            <label for="day">Day:</label>
                            <input type="text" id="day" name="day" class="form-control" value="<%= timetable.day %>" required>
                          </div>
                          <div class="form-group">
                            <label for="start_time">Start Time:</label>
                            <input type="text" id="start_time" name="start_time" class="form-control" value="<%= timetable.start_time %>" required>
                          </div>
                          <div class="form-group">
                            <label for="end_time">End Time:</label>
                            <input type="text" id="end_time" name="end_time" class="form-control" value="<%= timetable.end_time %>">
                          </div>
                          <div class="form-group">
                            <label for="subject_code">Subject Code:</label>
                            <input type="text" id="subject_code" name="subject_code" class="form-control" value="<%= timetable.subject_code %>" required>
                          </div>
                          <div class="form-group">
                            <label for="subject_name">Subject Name:</label>
                            <input type="text" id="subject_name" name="subject_name" class="form-control" value="<%= timetable.subject_name %>" required>
                          </div>
                          <div class="form-group">
                            <label for="venue_name">Venue Name:</label>
                            <input type="text" id="venue_name" name="venue_name" class="form-control" value="<%= timetable.venue_name %>" required>
                          </div>
                          <div class="form-group">
                            <label for="venue_location">Venue Location:</label>
                            <input type="text" id="venue_location" name="venue_location" class="form-control" value="<%= timetable.venue_location %>" required>
                          </div>
                          <div class="form-group">
                            <label for="tutor_name">Tutor Name:</label>
                            <input type="text" id="tutor_name" name="tutor_name" class="form-control" value="<%= timetable.tutor_name %>" required>
                          </div>
                          <div class="form-group">
                            <label for="subject_credit">Credit:</label>
                            <input type="text" id="subject_credit" name="subject_credit" class="form-control" value="<%= timetable.subject_credit %>" required>
                          </div>
                          <div class="form-group">
                            <label for="venue_type">Venue Type:</label>
                            <input type="text" id="venue_type" name="venue_type" class="form-control" value="<%= timetable.venue_type %>" required>
                          </div>
                          <div class="form-group">
                            <label for="venue_status">Status:</label>
                            <input type="text" id="venue_status" name="venue_status" class="form-control" value="<%= timetable.venue_status %>" required>
                          </div>
                          <div class="form-group">
                            <label for="program_name">Program Name:</label>
                            <input type="text" id="program_name" name="program_name" class="form-control" value="<%= timetable.program_name %>" required>
                          </div>
                          <div class="form-group">
                            <label for="program_level">Program Level:</label>
                            <input type="text" id="program_level" name="program_level" class="form-control" value="<%= timetable.program_level %>" required>
                          </div>
                          <div class="form-group">
                            <label for="department_name">Department Name:</label>
                            <input type="text" id="department_name" name="department_name" class="form-control" value="<%= timetable.department_name %>" required>
                          </div>
                          <div class="form-group">
                            <label for="year">Duration:</label>
                            <input type="text" id="year" name="year" class="form-control" value="<%= timetable.year %>" required>
                          </div>
                          <button type="submit" class="btn btn-primary">Update</button>
                        </form>
                      </div>
                    </div>
                  </div>
                </div>
              <% }); %>
            </tbody>
          </table>
        </div>
        <br><br><br>   <!-- Delete Button -->
        <a title="CLEAR ALL THE WHOLE TIMETABLE IN ALL SEMESTERS WILL BE LOST" href="/timetables/delete/0.0001" class="btn btn-danger btn-sm " onclick="return confirm('Are you sure you want to delete this timetable?');">CLEAN ALL TIMETABLES </a>
    <br> <br><br><br> 
      <% } else { %>
        <h2>No Timetable Found</h2>
      <% } %>
    <% } %>
  </div>

  <script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.6/dist/umd/popper.min.js"></script>
  <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
</body>
</html>
