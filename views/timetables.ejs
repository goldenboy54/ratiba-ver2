<%- include('partials/nav') %>

<div class="container timetables-container">

  <!-- Page Header -->
  <div class="timetables-header">
    <div class="animated-graphic" title="Timetable autogenerating system">🕑</div>
    <h2>FILTER BELOW AND</h2>
    <h1>EDIT TIMETABLE DATA HERE</h1>
  </div>

  <!-- Alert Messages -->
  <% if (error) { %>
    <div class="alert alert-danger alert-dismissible fade show">
      <%= error %>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  <% } %>

  <% if (success) { %>
    <div class="alert alert-success alert-dismissible fade show">
      <%= success %>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  <% } %>

  <!-- Filter Form -->
  <form action="/timetables" method="GET" class="filter-form-timetables">
    <div class="row g-3">

      <div class="col-md-4">
        <label for="program" class="form-label">Program:</label>
        <select id="program" name="program" class="form-select select2">
          <option value="">Select Program</option>
          <% programs.forEach(program => { %>
            <option value="<%= program.program_name %>" <%= program_name === program.program_name ? 'selected' : '' %>>
              <%= program.program_name %>
            </option>
          <% }); %>
        </select>
      </div>

      <div class="col-md-4">
        <label for="level" class="form-label">Level:</label>
        <select id="level" name="level" class="form-select select2">
          <option value="">Select Level</option>
          <% levels.forEach(level => { %>
            <option value="<%= level.program_level %>" <%= program_level === level.program_level ? 'selected' : '' %>>
              <%= level.program_level %>
            </option>
          <% }); %>
        </select>
      </div>

      <div class="col-md-4">
        <label for="program_type" class="form-label">Program Type:</label>
        <select id="program_type" name="program_type" class="form-select select2">
          <option value="">Select Type</option>
          <% ptypes.forEach(type => { %>
            <option value="<%= type.program_type %>" <%= program_type === type.program_type ? 'selected' : '' %>>
              <%= type.program_type %>
            </option>
          <% }); %>
        </select>
      </div>

      <div class="col-md-4">
        <label for="venue" class="form-label">Venue:</label>
        <select id="venue" name="venue" class="form-select select2">
          <option value="">Select Venue</option>
          <% venues.forEach(venue => { %>
            <option value="<%= venue.venue_name %>" <%= venue_name === venue.venue_name ? 'selected' : '' %>>
              <%= venue.venue_name %>
            </option>
          <% }); %>
        </select>
      </div>

      <div class="col-md-4">
        <label for="tutor" class="form-label">Tutor:</label>
        <select id="tutor" name="tutor" class="form-select select2">
          <option value="">Select Tutor</option>
          <% tutors.forEach(tutor => { %>
            <option value="<%= tutor.tutor_name %>" <%= tutor_name === tutor.tutor_name ? 'selected' : '' %>>
              <%= tutor.tutor_name %>
            </option>
          <% }); %>
        </select>
      </div>

      <div class="col-md-4">
        <label for="department" class="form-label">Department:</label>
        <select id="department" name="department" class="form-select select2">
          <option value="">Select Department</option>
          <% departments.forEach(department => { %>
            <option value="<%= department.department_name %>" <%= department_name === department.department_name ? 'selected' : '' %>>
              <%= department.department_name %>
            </option>
          <% }); %>
        </select>
      </div>

      <div class="col-md-4">
        <label for="subject" class="form-label">Subject:</label>
        <select id="subject" name="subject" class="form-select select2">
          <option value="">Select Subject</option>
          <% subjects.forEach(subject => { %>
            <option value="<%= subject.subject_name %>" <%= subject_name === subject.subject_name ? 'selected' : '' %>>
              <%= subject.subject_name %> <%= subject.subject_code %>
            </option>
          <% }); %>
        </select>
      </div>

      <div class="col-md-4">
        <label for="semester" class="form-label">Semester:</label>
        <select id="semester" name="semester" class="form-select select2">
          <option value="">Select Semester</option>
          <% semesters.forEach(semester => { %>
            <option value="<%= semester.semester %>" <%= semester === semester.semester ? 'selected' : '' %>>
              <%= semester.semester %>
            </option>
          <% }); %>
        </select>
      </div>

    </div>

    <button type="submit" class="btn-filter-timetables">Filter</button>
  </form>

  <!-- Clean All Button -->
  <form action="/timetables/delete-all" method="POST" onsubmit="return confirm('Are you sure you want to delete ALL timetables?');">
    <button type="submit" class="btn-clean-all">
      ⚠️ CLEAN ALL TIMETABLES
    </button>
  </form>

  <!-- Display Timetables -->
  <% if (program_name || program_level || venue_name || tutor_name || department_name || subject_name) { %>
    <% if (timetables.length > 0) { %>

      <div class="table-container-timetables">
        <table class="table timetables-table">
          <thead>
            <tr>
              <th>DAY</th>
              <th>TIME</th>
              <th>VENUE</th>
              <th>SUBJECT</th>
              <th>TUTOR</th>
              <th>PROGRAM</th>
              <th>ACTION</th>
            </tr>
          </thead>
          <tbody>
            <% timetables.forEach(timetable => { %>
              <tr>
                <td>
                  <span class="cell-label">ID:</span> <%= timetable.id %><br>
                  <b><%= timetable.day %></b>
                </td>

                <td>
                  <b><%= timetable.slot %></b>
                </td>

                <td>
                  <span class="cell-label">Name:</span> <b><%= timetable.venue_name %></b><br>
                  <span class="cell-label">Type:</span> <%= timetable.venue_type %><br>
                  <span class="cell-label">Location:</span> <%= timetable.venue_location %><br>
                  <span class="cell-label">Status:</span> <%= timetable.venue_status %><br>
                  <span class="cell-label">Capacity:</span> <%= timetable.venue_capacity %> students
                </td>

                <td>
                  <span class="cell-label">Name:</span> <b><%= timetable.subject_name %></b><br>
                  <span class="cell-label">Code:</span> <%= timetable.subject_code %><br>
                  <span class="cell-label">Credit:</span> <%= timetable.subject_credit %><br>
                  <span class="cell-label">Department:</span> <%= timetable.department_name %>
                </td>

                <td>
                  <b><%= timetable.tutor_name %></b>
                </td>

                <td>
                  <span class="cell-label">Name:</span> <b><%= timetable.program_name %></b><br>
                  <span class="cell-label">Level:</span> <%= timetable.program_level %><br>
                  <span class="cell-label">Type:</span> <%= timetable.program_type %><br>
                  <span class="cell-label">Capacity:</span> <%= timetable.program_capacity %> students<br>
                  <span class="cell-label">Duration:</span> <%= timetable.year %> yrs
                </td>

                <td>
                  <button 
                    type="button" 
                    class="btn-action-table edit" 
                    data-bs-toggle="modal" 
                    data-bs-target="#updateModal<%= timetable.id %>"
                  >
                    EDIT
                  </button>

                  <button 
                    class="btn-action-table delete" 
                    data-bs-toggle="modal" 
                    data-bs-target="#deleteModal<%= timetable.id %>"
                  >
                    DELETE
                  </button>
                </td>
              </tr>

              <%- include('partials/timetable_modals', { timetable, subjects, venues, tutors, programs, levels, departments, ptypes }) %>

            <% }); %>
          </tbody>
        </table>
      </div>

    <% } else { %>
      <div class="no-data-state">
        <h2>No Timetable Found</h2>
      </div>
    <% } %>
  <% } %>

</div>

</main>
<%- include('partials/footer') %>
