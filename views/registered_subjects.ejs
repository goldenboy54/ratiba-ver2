<%- include('partials/nav') %>

<div class="container registered-subjects-container">

  <% if (locals.Viewregistered_subject) { %>
    <!-- ==================================================
         LIST VIEW - Display all registered subjects
         ================================================== -->

    <!-- Page Header -->
    <div class="page-header">
      <h2><i class="fas fa-book"></i> Registered Subjects</h2>
      <a href="/registered_subjects/form" class="btn-add-subject">
        <i class="fas fa-plus"></i> Add Subject
      </a>
    </div>

    <!-- Filter Form -->
    <form method="get" action="/registered_subjects" class="filter-form" id="filterForm">
      <div class="row g-3">

        <div class="col-md-4">
          <label for="filter_name" class="form-label">Subject Name</label>
          <select 
            name="registered_subject_name" 
            id="filter_name" 
            class="form-select select2 filterInput"
          >
            <option value="">All Subjects</option>
            <% Rsname.forEach(r => { %>
              <option value="<%= r.registered_subject_name %>">
                <%= r.registered_subject_name %>
              </option>
            <% }) %>
          </select>
        </div>

        <div class="col-md-4">
          <label for="filter_code" class="form-label">Subject Code</label>
          <select 
            name="registered_subject_code" 
            id="filter_code" 
            class="form-select select2 filterInput"
          >
            <option value="">All Codes</option>
            <% Rscode.forEach(r => { %>
              <option value="<%= r.registered_subject_code %>">
                <%= r.registered_subject_code %>
              </option>
            <% }) %>
          </select>
        </div>

        <div class="col-md-4">
          <label for="filter_credit" class="form-label">Credit</label>
          <select 
            name="credit" 
            id="filter_credit" 
            class="form-select select2 filterInput"
          >
            <option value="">All Credits</option>
            <% Rscredit.forEach(r => { %>
              <option value="<%= r.credit %>">
                <%= r.credit %>
              </option>
            <% }) %>
          </select>
        </div>

        <div class="col-md-4">
          <label for="filter_hours" class="form-label">Hours Per Week</label>
          <select 
            name="total_hours_per_week" 
            id="filter_hours" 
            class="form-select select2 filterInput"
          >
            <option value="">All Hours</option>
            <% Rsltpa.forEach(r => { %>
              <option value="<%= r.total_hours_per_week %>">
                <%= r.total_hours_per_week %>
              </option>
            <% }) %>
          </select>
        </div>

        <div class="col-md-4">
          <label for="filter_department" class="form-label">Department</label>
          <select 
            name="registered_subject_department" 
            id="filter_department" 
            class="form-select select2 filterInput"
          >
            <option value="">All Departments</option>
            <% Rsdepartment.forEach(r => { %>
              <option value="<%= r.registered_subject_department %>">
                <%= r.registered_subject_department %>
              </option>
            <% }) %>
          </select>
        </div>

      </div>
    </form>

    <!-- Export Buttons -->
    <div class="export-buttons">
      <button id="downloadCSV" class="btn-export csv">
        <i class="fas fa-file-csv"></i> Download CSV
      </button>
      <button id="downloadPDF" class="btn-export pdf">
        <i class="fas fa-file-pdf"></i> Download PDF
      </button>
      <button id="printTable" class="btn-export print">
        <i class="fas fa-print"></i> Print Table
      </button>
    </div>

    <!-- Subjects Table -->
    <% if (Viewregistered_subject.length > 0) { %>
      <div class="table-container">
        <table class="table subjects-table" id="subjectsTable">
          <thead>
            <tr>
              <th>Subject Name</th>
              <th>Subject Code</th>
              <th>Credit</th>
              <th>Hours/Week</th>
              <th>Department</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% Viewregistered_subject.forEach(s => { %>
              <tr>
                <td><%= s.registered_subject_name %></td>
                <td><%= s.registered_subject_code %></td>
                <td><%= s.credit %></td>
                <td><%= s.total_hours_per_week %></td>
                <td><%= s.registered_subject_department %></td>
                <td>
                  <button 
                    class="btn-action edit" 
                    data-bs-toggle="modal" 
                    data-bs-target="#updateModal<%= s.registered_subject_id %>"
                  >
                    <i class="fas fa-edit"></i> Edit
                  </button>
                  <a 
                    href="/registered_subjects/delete/<%= s.registered_subject_id %>" 
                    class="btn-action delete"
                  >
                    <i class="fas fa-trash"></i> Delete
                  </a>
                </td>
              </tr>

              <!-- Edit Modal -->
              <div 
                class="modal fade" 
                id="updateModal<%= s.registered_subject_id %>" 
                tabindex="-1" 
                aria-labelledby="updateModalLabel<%= s.registered_subject_id %>" 
                aria-hidden="true"
              >
                <div class="modal-dialog modal-dialog-centered">
                  <div class="modal-content">

                    <div class="modal-header">
                      <h5 class="modal-title" id="updateModalLabel<%= s.registered_subject_id %>">
                        <i class="fas fa-edit"></i> Update Subject
                      </h5>
                      <button 
                        type="button" 
                        class="btn-close" 
                        data-bs-dismiss="modal" 
                        aria-label="Close"
                      ></button>
                    </div>

                    <div class="modal-body">
                      <form 
                        action="/registered_subjects/edit/<%= s.registered_subject_id %>" 
                        method="post"
                      >

                        <div class="form-group">
                          <label for="edit_name_<%= s.registered_subject_id %>" class="form-label">
                            Subject Name
                          </label>
                          <input 
                            type="text" 
                            name="registered_subject_name" 
                            id="edit_name_<%= s.registered_subject_id %>"
                            value="<%= s.registered_subject_name %>" 
                            class="form-control" 
                            required
                          >
                        </div>

                        <div class="form-group">
                          <label for="edit_code_<%= s.registered_subject_id %>" class="form-label">
                            Subject Code
                          </label>
                          <input 
                            type="text" 
                            name="registered_subject_code" 
                            id="edit_code_<%= s.registered_subject_id %>"
                            value="<%= s.registered_subject_code %>" 
                            class="form-control" 
                            required
                          >
                        </div>

                        <div class="form-group">
                          <label for="edit_credit_<%= s.registered_subject_id %>" class="form-label">
                            Credit
                          </label>
                          <input 
                            type="number" 
                            name="credit" 
                            id="edit_credit_<%= s.registered_subject_id %>"
                            value="<%= s.credit %>" 
                            class="form-control" 
                            required
                          >
                        </div>

                        <div class="form-group">
                          <label for="edit_hours_<%= s.registered_subject_id %>" class="form-label">
                            Total Hours Per Week
                          </label>
                          <input 
                            type="text" 
                            name="total_hours_per_week" 
                            id="edit_hours_<%= s.registered_subject_id %>"
                            value="<%= s.total_hours_per_week %>" 
                            class="form-control" 
                            required
                          >
                        </div>

                        <div class="form-group">
                          <label for="edit_dept_<%= s.registered_subject_id %>" class="form-label">
                            Department
                          </label>
                          <select 
                            name="registered_subject_department" 
                            id="edit_dept_<%= s.registered_subject_id %>"
                            class="form-select" 
                            required
                          >
                            <% departments.forEach(d => { %>
                              <option 
                                value="<%= d.department_name %>" 
                                <%= s.registered_subject_department === d.department_name ? 'selected' : '' %>
                              >
                                <%= d.department_name %>
                              </option>
                            <% }) %>
                          </select>
                        </div>

                        <button type="submit" class="btn-primary">
                          <i class="fas fa-save"></i> Save Changes
                        </button>

                      </form>
                    </div>

                  </div>
                </div>
              </div>

            <% }) %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <div class="alert alert-info">
        <i class="fas fa-info-circle"></i> No subjects found matching your filters.
      </div>
    <% } %>

  <% } else { %>
    <!-- ==================================================
         ADD VIEW - Add new registered subject
         ================================================== -->

    <div class="add-form-container">
      <h2><i class="fas fa-plus-circle"></i> Add Registered Subject</h2>

      <form 
        action="/registered_subjects" 
        method="post" 
        enctype="multipart/form-data"
      >

        <h4><i class="fas fa-file-upload"></i> Upload CSV/Excel File</h4>
        <div class="form-group">
          <label for="file_upload" class="form-label">
            Select file to import subjects (CSV or Excel format)
          </label>
          <input 
            type="file" 
            name="file" 
            id="file_upload"
            class="form-control" 
            accept=".csv,.xlsx,.xls"
            required
          >
        </div>

        <hr>

        <h4><i class="fas fa-keyboard"></i> Or Enter Manually</h4>

        <div class="form-group">
          <label for="subject_name" class="form-label">Subject Name</label>
          <input 
            type="text" 
            name="registered_subject_name" 
            id="subject_name"
            class="form-control" 
            placeholder="Enter subject name"
            required
          >
        </div>

        <div class="form-group">
          <label for="subject_code" class="form-label">Subject Code</label>
          <input 
            type="text" 
            name="registered_subject_code" 
            id="subject_code"
            class="form-control" 
            placeholder="Enter subject code"
            required
          >
        </div>

        <div class="form-group">
          <label for="subject_credit" class="form-label">Credit</label>
          <input 
            type="number" 
            name="credit" 
            id="subject_credit"
            class="form-control" 
            placeholder="Enter credit value"
            min="0"
            step="1"
          >
        </div>

        <div class="form-group">
          <label for="subject_hours" class="form-label">Total Hours Per Week</label>
          <input 
            type="text" 
            name="total_hours_per_week" 
            id="subject_hours"
            class="form-control" 
            placeholder="Enter hours per week"
          >
        </div>

        <div class="form-group">
          <label for="subject_department" class="form-label">Department</label>
          <select 
            name="registered_subject_department" 
            id="subject_department"
            class="form-select"
            required
          >
            <option value="">Select Department</option>
            <% departments.forEach(d => { %>
              <option value="<%= d.department_name %>">
                <%= d.department_name %>
              </option>
            <% }) %>
          </select>
        </div>

        <button type="submit" class="btn-submit">
          <i class="fas fa-check"></i> Add Subject
        </button>

      </form>
    </div>

  <% } %>

</div>

</main>
<%- include('partials/footer') %>
