<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>User Self Registration - ATC TMS</title>
  <link
    rel="stylesheet"
    href="https://use.fontawesome.com/releases/v5.6.3/css/all.css"
    crossorigin="anonymous"
  />
  <link
    rel="stylesheet"
    href="https://stackpath.bootstrapcdn.com/bootstrap/4.2.1/css/bootstrap.min.css"
    crossorigin="anonymous"
  />

  <style>
    body {
      font-family: 'Segoe UI', sans-serif;
      background: linear-gradient(135deg, #0d1b2a, #1b263b);
      color: #fff;
      min-height: 100vh;
    }

    header {
      background-color: #0d1b2a;
      color: #3498db;
      padding: 20px;
      text-align: center;
      border-bottom: 3px solid #3498db;
    }

    header h1 {
      font-size: 36px;
      font-weight: 700;
    }

    .card {
      border-radius: 15px;
      overflow: hidden;
      margin-top: 30px;
      box-shadow: 0 4px 15px rgba(0,0,0,0.3);
      animation: fadeInUp 1s ease;
    }

    .card-header {
      background-color: #3498db;
      color: white;
      font-weight: bold;
      text-align: center;
      font-size: 1.2rem;
    }

    .btn-primary {
      background-color: #3498db;
      border: none;
      transition: transform 0.2s ease-in-out, background-color 0.3s ease;
    }

    .btn-primary:hover {
      transform: translateY(-2px);
      background-color: #2874a6;
    }

    .form-control:focus {
      border-color: #3498db;
      box-shadow: 0 0 0 0.2rem rgba(52, 152, 219, 0.25);
    }

    .link-light-blue {
      color: #3498db;
      text-decoration: none;
    }

    .link-light-blue:hover {
      text-decoration: underline;
      color: #2874a6;
    }

    @keyframes fadeInUp {
      from { opacity: 0; transform: translateY(30px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .alert {
      margin-top: 10px;
    }

    /* Password strength text */
    #passwordStrength {
      font-weight: bold;
      margin-top: 5px;
    }

  </style>
</head>
<body>

<header>
  <h1>ATC TIME TABLE MANAGEMENT SYSTEM - TMS</h1>
</header>

<div class="container">
  <div class="row justify-content-center">
    <div class="col-md-6 col-sm-10">
      <% if (error) { %>
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
          <%= error %>
          <button type="button" class="close" data-dismiss="alert">&times;</button>
        </div>
      <% } %>

      <% if (success) { %>
        <div class="alert alert-success alert-dismissible fade show" role="alert">
          <%= success %>
          <button type="button" class="close" data-dismiss="alert">&times;</button>
        </div>
      <% } %>

      <div class="card">
        <div class="card-header">
          <i class="fas fa-user-plus me-2"></i> Create Your Account
        </div>
        <div class="card-body bg-light text-dark">
          <form id="registerForm" action="/self-register" method="POST">
            <div class="form-group mb-3">
              <label>Full Name</label>
              <input type="text" name="full_name" class="form-control" placeholder="e.g. your full name" required>
            </div>

            <div class="form-group mb-3">
              <label>Department</label>
              <select name="department" class="form-control" required>
                <% if (departments && departments.length > 0) { %>
                  <% departments.forEach(dept => { %>
                    <option value="<%= dept.department_name %>"><%= dept.department_name %></option>
                  <% }) %>
                <% } else { %>
                  <option disabled>No Departments Available</option>
                <% } %>
              </select>
            </div>

            <div class="form-group mb-3">
              <label>Email</label>
              <input type="email" name="user_email" class="form-control" placeholder="name@university.edu" required>
            </div>

            <div class="form-group mb-3">
              <label>Password</label>
              <div class="input-group">
                <input type="password" id="password" name="password" class="form-control" placeholder="Enter a secure password" required>
                <div class="input-group-append">
                  <button class="btn btn-outline-secondary" type="button" id="togglePassword">
                    <i class="fas fa-eye"></i>
                  </button>
                </div>
              </div>
              <div id="passwordStrength">Password must be at least 8 chars, include uppercase, number & special char.</div>
            </div>

            <button type="submit" class="btn btn-primary w-100">
              <i class="fas fa-user-plus me-1"></i> Register
            </button>
          </form>

          <div class="mt-3 text-center">
            <a href="/login" class="link-light-blue"><i class="fas fa-sign-in-alt me-1"></i> Back to Login</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('partials/footer') %>

<script>
  const passwordInput = document.getElementById('password');
  const togglePassword = document.getElementById('togglePassword');
  const passwordStrength = document.getElementById('passwordStrength');
  const form = document.getElementById('registerForm');

  // Toggle show/hide password
  togglePassword.addEventListener('click', () => {
    const type = passwordInput.type === 'password' ? 'text' : 'password';
    passwordInput.type = type;
    togglePassword.innerHTML = type === 'password' ? '<i class="fas fa-eye"></i>' : '<i class="fas fa-eye-slash"></i>';
  });

  // Password strength feedback
  passwordInput.addEventListener('input', () => {
    const val = passwordInput.value;

    const lengthValid = val.length >= 8;
    const uppercaseValid = /[A-Z]/.test(val);
    const numberValid = /[0-9]/.test(val);
    const specialValid = /[^A-Za-z0-9]/.test(val);

    let strengthText = '';
    let color = 'red';

    if (!lengthValid) strengthText += 'Password must be at least 8 characters. ';
    if (!uppercaseValid) strengthText += 'Include at least 1 uppercase letter. ';
    if (!numberValid) strengthText += 'Include at least 1 number. ';
    if (!specialValid) strengthText += 'Include at least 1 special character. ';

    if (lengthValid && uppercaseValid && numberValid && specialValid) {
      strengthText = 'Strong password!';
      color = 'green';
    } else if ((lengthValid && uppercaseValid && numberValid) || (lengthValid && numberValid && specialValid)) {
      color = 'orange';
    }

    passwordStrength.textContent = strengthText;
    passwordStrength.style.color = color;
  });

  // Prevent submit if password not strong
  form.addEventListener('submit', (e) => {
    const val = passwordInput.value;
    const isStrong = val.length >= 8 &&
                     /[A-Z]/.test(val) &&
                     /[0-9]/.test(val) &&
                     /[^A-Za-z0-9]/.test(val);
    if (!isStrong) {
      e.preventDefault();
      passwordInput.focus();
      alert('Your password is not strong enough. Please follow the instructions.');
    }
  });
</script>

<script src="https://code.jquery.com/jquery-3.3.1.slim.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@4.2.1/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
