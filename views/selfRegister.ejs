<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>User Self Registration - ATC TMS</title>
  
  <!-- Font Awesome -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" crossorigin="anonymous" />
  <!-- Bootstrap 5 -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <!-- Self Register CSS -->
  <link rel="stylesheet" href="/css/selfRegister.css">
</head>
<body class="self-register-body">

  <!-- Header -->
  <header class="self-register-header">
    <h1>ATC TIMETABLE MANAGEMENT SYSTEM - TMS</h1>
  </header>

  <!-- Main Container -->
  <div class="self-register-container">
    <div class="register-card">
      <!-- Alert Messages -->
      <% if (error || success) { %>
        <div class="alert-container">
          <% if (error) { %>
            <div class="alert-custom alert-danger-custom">
              <%= error %>
              <button type="button" class="alert-close" aria-label="Close">
                <span>&times;</span>
              </button>
            </div>
          <% } %>

          <% if (success) { %>
            <div class="alert-custom alert-success-custom">
              <%= success %>
              <button type="button" class="alert-close" aria-label="Close">
                <span>&times;</span>
              </button>
            </div>
          <% } %>
        </div>
      <% } %>

      <!-- Card Header -->
      <div class="register-card-header">
        <i class="fas fa-user-plus"></i>
        Create Your Account
      </div>

      <!-- Card Body -->
      <div class="register-card-body">
        <form id="registerForm" action="/self-register" method="POST" class="register-form">
          <!-- Full Name -->
          <div class="form-group">
            <label for="full_name">Full Name</label>
            <input 
              type="text" 
              id="full_name"
              name="full_name" 
              class="form-control" 
              placeholder="e.g. John Doe" 
              required
            >
          </div>

          <!-- Department -->
          <div class="form-group">
            <label for="department">Department</label>
            <select id="department" name="department" class="form-select select2" required>
              <% if (departments && departments.length > 0) { %>
                <option value="">Select Department</option>
                <% departments.forEach(dept => { %>
                  <option value="<%= dept.department_name %>"><%= dept.department_name %></option>
                <% }) %>
              <% } else { %>
                <option disabled>No Departments Available</option>
              <% } %>
            </select>
          </div>

          <!-- Email -->
          <div class="form-group">
            <label for="user_email">Email</label>
            <input 
              type="email" 
              id="user_email"
              name="user_email" 
              class="form-control" 
              placeholder="name@university.edu" 
              required
            >
          </div>

          <!-- Password -->
          <div class="form-group">
            <label for="password">Password</label>
            <div class="password-input-group">
              <input 
                type="password" 
                id="password" 
                name="password" 
                class="form-control" 
                placeholder="Enter a secure password" 
                required
              >
              <button 
                class="password-toggle-btn" 
                type="button" 
                id="togglePassword"
                aria-label="Toggle password visibility"
              >
                <i class="fas fa-eye"></i>
              </button>
            </div>
            <div id="passwordStrength" class="password-strength weak">
              Password must be at least 8 chars, include uppercase, number & special char.
            </div>
          </div>

          <!-- Submit Button -->
          <button type="submit" class="register-submit-btn">
            <i class="fas fa-user-plus"></i>
            Register
          </button>
        </form>

        <!-- Back to Login Link -->
        <div class="back-to-login">
          <a href="/login">
            <i class="fas fa-sign-in-alt"></i>
            Back to Login
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- jQuery -->
  <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
  <!-- Bootstrap 5 JS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <!-- Self Register JS -->
  <script src="/js/selfRegister.js"></script>

</body>
</html>
