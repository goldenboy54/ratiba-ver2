

<%- include('partials/nav') %>

<!-- Dashboard Content -->
<div class="container-fluid py-4">
  <div class="mb-4">
    <h1 class="display-6 fw-bold text-primary">ATC TIME TABLE MANAGEMENT SYSTEM</h1>
    <p class="text-muted mb-0">Welcome, <strong><%= user ? user.full_name : "Guest" %></strong> - <span class="badge bg-primary"><%= user ? user.role.toUpperCase() : "" %></span></p>
  </div>

  <div class="row g-4">

    <% if (user && user.role === "tmaster") { %>
      <div class="col-md-4">
        <div class="card p-3">
          <h5 class="card-title"><i class="fas fa-cogs me-2"></i>Timetable Settings</h5>
          <p class="card-text">Configure timetable rules and venues.</p>
          <a href="/timetables" class="btn btn-primary w-100">Settings</a>
        </div>
      </div>

      <div class="col-md-4">
        <div class="card p-3">
          <h5 class="card-title"><i class="fas fa-magic me-2"></i>Generate Timetable</h5>
          <p class="card-text">Automatically generate timetable for all classes.</p>
          <a href="/tmaster" class="btn btn-primary w-100">Generate</a>
        </div>
      </div>

      <div class="col-md-4">
        <div class="card p-3">
          <h5 class="card-title"><i class="fas fa-clock me-2"></i>Freed Slots</h5>
          <p class="card-text">View recently freed slots in the timetable.</p>
          <a href="/manageTimetable/freed-slots" class="btn btn-primary w-100">View</a>
        </div>  
      </div>

      <div class="col-md-4">
        <div class="card p-3">
          <h5 class="card-title"><i class="fas fa-edit me-2"></i>Mix Timetable</h5>
          <p class="card-text">Combine multiple classes into a single timetable.</p>
          <a href="/manageTimetable" class="btn btn-primary w-100">Mix</a>
        </div>
      </div>

      <div class="col-md-4">
        <div class="card p-3">
          <h5 class="card-title"><i class="fas fa-users me-2"></i>Manage Tutors</h5>
          <p class="card-text">Add or edit tutor information.</p>
          <a href="/users" class="btn btn-primary w-100">Manage</a>
        </div>
      </div>

      <div class="col-md-4">
        <div class="card p-3">
          <h5 class="card-title"><i class="fas fa-map-marker-alt me-2"></i>Manage Venues</h5>
          <p class="card-text">Add or edit venues for classes.</p>
          <a href="/venues" class="btn btn-primary w-100">Manage</a>
        </div>
      </div>

    <% } %>

    <% if (user && user.role === "hod") { %>
      <div class="col-md-4">
        <div class="card p-3">
          <h5 class="card-title"><i class="fas fa-graduation-cap me-2"></i>Manage Programs</h5>
          <p class="card-text">Add or edit programs for your department.</p>
          <a href="/programs" class="btn btn-primary w-100">Manage</a>
        </div>
      </div>

      <div class="col-md-4">
        <div class="card p-3">
          <h5 class="card-title"><i class="fas fa-book-open me-2"></i>Allocate Modules</h5>
          <p class="card-text">Assign modules to lecturers and students.</p>
          <a href="/subjects" class="btn btn-primary w-100">Allocate</a>
        </div>
      </div>
    <% } %>

    <% if (user && user.role === "student") { %>
      <div class="col-md-4">
        <div class="card p-3">
          <h5 class="card-title"><i class="fas fa-calendar-alt me-2"></i>My Timetable</h5>
          <p class="card-text">View your personal timetable.</p>
          <a href="/searchtimetable" class="btn btn-primary w-100">View</a>
        </div>
      </div>
    <% } %>

  </div>
</div>

</main>

<%- include('partials/footer') %>
