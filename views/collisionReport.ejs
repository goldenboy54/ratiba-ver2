<%- include('partials/nav') %>

<div class="container collision-report-container">

  <!-- Header -->
  <div class="collision-report-header">
    <h1>Collision Report</h1>
    <div class="export-buttons-collision">
      <button id="exportCsvBtn" class="btn-export-collision csv">
        <i class="fas fa-file-csv"></i> Export CSV
      </button>
      <button id="exportPdfBtn" class="btn-export-collision pdf">
        <i class="fas fa-file-pdf"></i> Export PDF
      </button>
      <button id="printBtn" class="btn-export-collision print">
        <i class="fas fa-print"></i> Print
      </button>
    </div>
  </div>

  <!-- Filters -->
  <div class="filter-card-collision card">
    <div class="row g-3">

      <div class="col-md-3">
        <label for="filterDay" class="form-label">Filter by Day</label>
        <select id="filterDay" class="form-select select2">
          <option value="">All Days</option>
          <option>MONDAY</option>
          <option>TUESDAY</option>
          <option>WEDNESDAY</option>
          <option>THURSDAY</option>
          <option>FRIDAY</option>
        </select>
      </div>

      <div class="col-md-3">
        <label for="filterVenue" class="form-label">Filter by Venue</label>
        <select id="filterVenue" class="form-select select2">
          <option value="">All Venues</option>
        </select>
      </div>

      <div class="col-md-3">
        <label for="filterProgType" class="form-label">Filter by Program Type</label>
        <select id="filterProgType" class="form-select select2">
          <option value="">All Types</option>
          <option value="full-time">Full-Time</option>
          <option value="evening">Evening</option>
          <option value="veta">VETA</option>
        </select>
      </div>

      <div class="col-md-3">
        <label for="globalSearch" class="form-label">Search</label>
        <input 
          id="globalSearch" 
          class="form-control" 
          type="text"
          placeholder="Tutor, subject, program..."
        />
      </div>

    </div>
  </div>

  <!-- Summary -->
  <div class="row summary-cards-collision">
    <div class="col-md-4">
      <div class="summary-card">
        <strong>Scanned Slots:</strong>
        <div id="summaryScanned" class="summary-value">0</div>
      </div>
    </div>
    <div class="col-md-8">
      <div class="summary-card">
        <strong>Collisions Summary:</strong>
        <div class="summary-badges">
          <span class="badge program">
            Program: <span id="summaryProgram">0</span>
          </span>
          <span class="badge tutor">
            Tutor: <span id="summaryTutor">0</span>
          </span>
          <span class="badge venue">
            Venue: <span id="summaryVenue">0</span>
          </span>
        </div>
      </div>
    </div>
  </div>

  <!-- Report Container -->
  <div id="reportContainer" class="report-container-collision">
    <!-- Collision cards will be injected here by JavaScript -->
  </div>

  <!-- Footer Suggestions -->
  <div class="suggestions-footer">
    <p>
      <strong>💡 Suggestions:</strong> Use filters to narrow collisions. 
      Click "Analyze" on a collision to view detailed slot info and suggested actions 
      (keep earliest extracted slot; move the later one; check tutor availability; 
      contact program coordinator).
    </p>
  </div>

  <!-- Hidden report data for JavaScript -->
  <script type="application/json" id="reportData">
    <%- report %>
  </script>

</div>

<!-- html2pdf library for PDF export -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>

</main>
<%- include('partials/footer') %>
