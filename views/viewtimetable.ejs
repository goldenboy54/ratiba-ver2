<%- include('partials/nav') %>

<div class="container viewtimetable-container">
  <div class="page-header-section">
    <div class="animated-graphic" title="Timetable autogenerating system">🕑</div>
    <h2>FILTER YOUR TIMETABLE</h2>
  </div>

  <!-- SEMESTER FORM -->
  <form id="semesterForm" method="get" action="/viewtimetable" class="semester-form">
    <div class="form-group">
      <label for="semester" class="form-label">Semester:</label>
      <select id="semester" name="semester" class="form-select select2" required>
        <option value="">-- Select Semester --</option>
        <% semesters.forEach(sem => { %>
          <option value="<%= sem.semester %>" <%= semester === sem.semester ? 'selected' : '' %>>
            <%= sem.semester %>
          </option>
        <% }); %>
      </select>
    </div>
  </form>

  <!-- FILTER FORM -->
  <form id="filterForm" method="get" action="/viewtimetable" class="filter-form">
    <input type="hidden" name="semester" value="<%= semester %>"/>
    <div class="row g-3">
      <div class="col-md-4">
        <label for="program" class="form-label">Program:</label>
        <select id="program" name="program" class="form-select select2">
          <option value="">Select Program</option>
          <% programs.forEach(p => { %>
            <option value="<%= p.program_name %>" <%= program_name === p.program_name ? 'selected' : '' %>>
              <%= p.program_name %>
            </option>
          <% }); %>
        </select>
      </div>

      <div class="col-md-4">
        <label for="program_type" class="form-label">Program Type:</label>
        <select id="program_type" name="program_type" class="form-select select2">
          <option value="">Select Type</option>
          <% ptypes.forEach(pt => { %>
            <option value="<%= pt.program_type %>" <%= program_type === pt.program_type ? 'selected' : '' %>>
              <%= pt.program_type %>
            </option>
          <% }); %>
        </select>
      </div>

      <div class="col-md-4">
        <label for="level" class="form-label">Level:</label>
        <select id="level" name="level" class="form-select select2">
          <option value="">Select Level</option>
          <% levels.forEach(l => { %>
            <option value="<%= l.program_level %>" <%= program_level === l.program_level ? 'selected' : '' %>>
              <%= l.program_level %>
            </option>
          <% }); %>
        </select>
      </div>
    </div>

    <div class="text-center mt-3">
      <button type="submit" class="btn btn-primary">
        <i class="fas fa-filter"></i> Show Timetable
      </button>
      <a href="/viewtimetable" class="btn btn-secondary ms-2">
        <i class="fas fa-sync"></i> Reset
      </a>
    </div>
  </form>

  <!-- TIMETABLE RESULTS -->
  <% if (semester && (tutor_name || (program_name && program_level))) { %>
    <% if (timetables && timetables.length > 0) { %>

      <div class="timetable-header">
        <h3>ARUSHA TECHNICAL COLLEGE</h3>
        <h5>TIMETABLE - SEMESTER <%= semester %></h5>
      </div>

      <% 
        const weekdayOrder = ["MONDAY","TUESDAY","WEDNESDAY","THURSDAY","FRIDAY","SATURDAY","SUNDAY"];
        const uniqueDays = weekdayOrder.filter(day => timetables.some(t => t.day === day));

        const grouped = timetables.reduce((acc, t) => {
          const start = t.start_time ? t.start_time.split(":").slice(0,2).join(":") : null;
          const end = t.end_time ? t.end_time.split(":").slice(0,2).join(":") : null;
          if(start && end){
            const slot = `${start} - ${end}`;
            if(!acc[slot]) acc[slot] = [];
            acc[slot].push(t);
          }
          return acc;
        }, {});

        const breaks = [
          {nos:5, time:"10:35 - 11:00", type:"Tea Break"},
          {nos:6, time:"12:30 - 13:15", type:"Lunch Break"}
        ];

        const allSlots = [...new Set([...Object.keys(grouped), ...breaks.map(b => b.time)])]
          .sort((a,b) => {
            const getMinutes = time => {
              const [start] = time.split(" - ");
              const [h,m] = start.split(":").map(Number);
              return h*60 + m;
            };
            return getMinutes(a) - getMinutes(b);
          });
      %>

      <div class="table-container" id="timetableContent">
        <table class="table timetable-table">
          <thead>
            <tr>
              <th>TIME</th>
              <% uniqueDays.forEach(day => { %>
                <th><%= day %></th>
              <% }); %>
            </tr>
          </thead>
          <tbody>
            <% allSlots.forEach(slot => { %>
              <tr>
                <td><b><%= slot %></b></td>
                <% uniqueDays.forEach(day => {
                    // A co-taught session puts one row per tutor into extracted_timetables, all
                    // sharing the same day/slot/subject/program - filter() (not find()) collects
                    // every one of them instead of silently dropping all but the first.
                    const entries = grouped[slot] ? grouped[slot].filter(t => t.day === day) : [];
                    const entry = entries[0] || null;
                    const tutorNames = [...new Set(entries.map(e => e.tutor_name).filter(Boolean))].join(' & ');
                    const brk = breaks.find(b => b.time === slot);
                %>
                  <td>
                    <% if(entry){ %>
                      <b>Venue:</b> <%= entry.venue_name || '---' %> (<%= entry.venue_type || '---' %>)<br>
                      <b>Subject:</b> <%= entry.subject_name || '---' %> (<%= entry.subject_code || '---' %>)<br>
                      <b>Tutor:</b> <%= tutorNames || '---' %><br>
                      <b>Program:</b> <%= entry.program_code || '---' %> (<%= entry.program_level || '---' %>)
                    <% } else if(brk){ %>
                      <i><%= brk.type %></i>
                    <% } else { %>
                      <i>---</i>
                    <% } %>
                  </td>
                <% }); %>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>

      <div class="action-buttons">
        <button id="frontendPrintBtn" class="btn btn-print">
          <i class="fa fa-print"></i> Print Timetable
        </button>
      </div>

    <% } else { %>
      <div class="empty-state error">
        <i class="fa fa-calendar-times"></i>
        <p>No timetables found for the selected filters.</p>
      </div>
    <% } %>
  <% } else { %>
    <div class="empty-state">
      <i class="fa fa-filter"></i>
      <p>Filter to view the timetable.</p>
    </div>
  <% } %>
</div>

</main>
<%- include('partials/footer') %>
