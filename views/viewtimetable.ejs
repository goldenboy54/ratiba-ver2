<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Search Timetables</title>
  <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2@4.1.0-beta.1/dist/css/select2.min.css" />
  
  
  
  
  <style>
    /* Global Styles */
    body {
      font-family: 'Arial', sans-serif;
      background-color: #f4f7fb;
      color: #333;
      margin: 0;
      padding: 0;
    }

    .container {
      max-width: 1200px;
      margin-top: 30px;
    }

    .animated-graphic {
      font-size: 3rem;
      animation: spin 3s linear infinite;
    }

    @keyframes spin {
      0% { transform: rotate(0deg); }
      100% { transform: rotate(360deg); }
    }

    .btn-primary {
      background-color: #007bff;
      border-color: #007bff;
      transition: background-color 0.3s ease, border-color 0.3s ease;
    }

    .btn-primary:hover {
      background-color: #0056b3;
      border-color: #004085;
    }

    /* Table Styles */
    .table-container {
      overflow-x: auto;
    }

    .table thead {
      background-color: #007bff;
      color: white;
    }

    .table th, .table td {
      vertical-align: middle;
      text-align: center;
      font-size: 1rem;
      padding: 12px;
    }

    .table tbody tr {
      background-color: #fff;
      transition: background-color 0.3s ease-in-out;
    }

    .table tbody tr:hover {
      background-color: #f1f8ff;
    }

    .table th {
      font-weight: bold;
    }

    /* Form Styles */
    .form-group label {
      font-weight: bold;
    }

    .form-control {
      border-radius: 0.375rem;
      padding: 10px;
      font-size: 1rem;
    }

    /* Button Styles */
    .btn-secondary {
      background-color: #6c757d;
      border-color: #6c757d;
    }

    .btn-secondary:hover {
      background-color: #5a6268;
      border-color: #545b62;
    }

    /* Responsive Styles */
    @media (max-width: 768px) {
      .table th, .table td {
        font-size: 0.9rem;
      }

      .form-row {
        flex-direction: column;
      }

      .form-group.col-md-4 {
        width: 100%;
        margin-bottom: 15px;
      }

      .btn-primary, .btn-secondary {
        width: 100%;
        margin-top: 10px;
      }

      .table-container {
        padding-left: 10px;
        padding-right: 10px;
      }
    }
    .table-container {
      overflow-x: auto; /* Ensures horizontal scrolling if table overflows */
    }
    .animated-graphic {
      font-size: 3rem; /* Adjust as needed */
      animation: spin 3s linear infinite; /* Add a spinning animation */
    }
    @keyframes spin {
      0% { transform: rotate(0deg); }
      100% { transform: rotate(360deg); }
    }
    .table thead {
      background: linear-gradient(45deg, #28a745, #007bff); /* Green-blue gradient */
      color: #fff;
    }
    .table th, .table td {
      vertical-align: middle;
      text-align: center;
      font-size: 1.1rem;
    }
    .table tbody tr {
      background-color: #f8f9fa;
      transition: background-color 0.3s ease-in-out;
    }
    .table tbody tr:hover {
      background-color: #e2e6ea;
    }
    .btn-primary {
      background-color: #007bff;
      border-color: #007bff;
      transition: background-color 0.3s ease, border-color 0.3s ease;
    }
    .btn-primary:hover {
      background-color: #0056b3;
      border-color: #004085;
    }
  </style>
  
</head>
<body>
  <div class="container mt-5">
    <div class="text-center mb-4">
      <div class="animated-graphic" title="Timetable autogenerating system">🕑</div> 
    </div> 
    <a href="/" class="btn btn-secondary mb-4">BACK</a>

    <!-- Search Form -->
    <form method="get" action="/viewtimetable" class="mb-4">
      <div class="form-row">
        <div class="form-group col-md-4">
          <label for="program">Program:</label>
          <select id="program" name="program" class="form-control select2">
            <option value="">Select Program</option>
            <% programs.forEach(program => { %>
              <option value="<%= program.program_name %>" <%= program_name === program.program_name ? 'selected' : '' %>><%= program.program_name %></option>
            <% }); %>
          </select>
        </div>

        <div class="form-group col-md-4">
          <label for="program_type">Program Type:</label>
          <select id="program_type" name="program_type" class="form-control select2">
            <option value="">Select Type</option>
            <% ptypes.forEach(program => { %>
              <option value="<%= program.program_type %>" <%= program_type === program.program_type ? 'selected' : '' %>><%= program.program_type %></option>
            <% }); %>
          </select>
        </div>

        <div class="form-group col-md-4">
          <label for="level">Level:</label>
          <select id="level" name="level" class="form-control select2">
            <option value="">Select Level</option>
            <% levels.forEach(level => { %>
              <option value="<%= level.program_level %>" <%= program_level === level.program_level ? 'selected' : '' %>><%= level.program_level %></option>
            <% }); %>
          </select>
        </div>

        <div class="form-group col-md-4">
          <label for="semester">Semester:</label>
          <select id="semester" name="semester" class="form-control select2">
            <option value="">Select Semester</option>
            <% semesters.forEach(semester => { %>
              <option value="<%= semester.semester %>" <%= semester === semester.semester ? 'selected' : '' %>><%= semester.semester %></option>
            <% }); %>
          </select>
        </div>
      </div>

      <div class="form-group">
        <button type="submit" class="btn btn-primary btn-block">Filter</button>
      </div>
    </form>

    <% if (program_name || program_level) { %> 
      <% if (timetables.length > 0) { %>
        <h1 class="text-center">Arusha Technical College Timetable</h1>
        <div class="table-container">
          <table class="table table-bordered table-striped">
            <thead>
              <tr>
                <th>TIME</th>
                <% 
                  // Extract unique days from the timetable
                  const uniqueDays = [...new Set(timetables.map(t => t.day))];
                  uniqueDays.forEach(day => { 
                %>
                  <th><%= day.toUpperCase() %></th>
                <% }); %>
              </tr>
            </thead>
            <tbody>
              <% 
                // Extract unique time slots
                const uniqueTimes = [...new Set(timetables.map(t => `${t.start_time} - ${t.end_time}`))];
                uniqueTimes.forEach(timeSlot => { 
              %>
                <tr>
                  <td><b><%= timeSlot %></b></td>
                  <% 
                    // Loop through each day and match data
                    uniqueDays.forEach(day => { 
                      const entry = timetables.find(t => `${t.start_time} - ${t.end_time}` === timeSlot && t.day === day);
                  %>
                    <td>
                      <% if (entry) { %>
                        <b>Venue:</b> <%= entry.venue_name %> (<%= entry.venue_type %>)<br>
                        <b>Subject:</b> <%= entry.subject_name %> (<%= entry.subject_code %>)<br>
                        <b>Tutor:</b> <%= entry.tutor_name %><br>
                        <b>Program:</b> <%= entry.program_name %> (<%= entry.program_level %>)<br>
                      <% } else { %>
                        <i>---</i>
                      <% } %>
                    </td>
                  <% }); %>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } else { %>
        <p class="text-center">No timetables found for the selected filters.</p>
      <% } %>
    <% } %>
    
    <!-- Download Button only if filters are applied -->
    <% if (program_name || program_level) { %>
      <div class="text-center mt-4">
        <a href="/download-timetable?program=<%= program_name %>&level=<%= program_level %>&venue=<%= venue_name %>&tutor=<%= tutor_name %>&department=<%= department_name %>" class="btn btn-primary">Download Timetables (CSV)</a>
        <a href="/download-timetable-pdf?program=<%= program_name %>&level=<%= program_level %>&venue=<%= venue_name %>&tutor=<%= tutor_name %>&department=<%= department_name %>" class="btn btn-secondary">Download Timetables (PDF)</a>
      </div>
    <% } %>
  </div>

  <!-- Bootstrap JS and dependencies -->
  <script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-beta.1/dist/js/select2.min.js"></script>
  <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.bundle.min.js"></script>
  <script>
    $(document).ready(function() {
      $('.select2').select2(); // Initialize Select2 dropdown
    });
  </script>
</body>
</html>
